#!/usr/bin/env bash
set -u
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
REV="$(git -C "$ROOT" rev-parse HEAD)"
if [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=normal)" ]; then
  echo "maho-vm-torture: refusing dirty checkout; commit the exact candidate first" >&2
  exit 2
fi
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
CAMPAIGN="${MAHO_TORTURE_EVIDENCE:-${XDG_STATE_HOME:-$HOME/.local/state}/maho/certification/vm-torture/$STAMP-$REV}"
mkdir -p "$CAMPAIGN/profiles"
python3 "$ROOT/tools/vm/torture-report.py" snapshot --repo "$ROOT" --output "$CAMPAIGN/host-before.json"

profiles=(torture-session torture-guardian torture-runtime torture-runtime-executor torture-runtime-executor-after torture-runtime-guardian-verifying torture-reboot-awaiting torture-reboot-recovering torture-reboot-verifying torture-postconditions torture-network torture-update torture-update-compound torture-prevention torture-storage torture-compound)
overall=0
for profile in "${profiles[@]}"; do
  echo "RUN   Maho full-system profile $profile"
  MAHO_VM_EVIDENCE="$CAMPAIGN/profiles/$profile" "$ROOT/tools/maho-vm-certify" "$profile"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    overall=1
    echo "FAIL  profile $profile rc=$rc" >&2
  fi
done

python3 "$ROOT/tools/vm/torture-report.py" snapshot --repo "$ROOT" --output "$CAMPAIGN/host-after.json"
python3 "$ROOT/tools/vm/torture-report.py" report --repo "$ROOT" --campaign "$CAMPAIGN" --revision "$REV"
report_rc=$?
[ "$report_rc" -eq 0 ] || overall=1
echo "INFO  full torture evidence $CAMPAIGN"
exit "$overall"

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="${1:-smoke}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
REV="$(git -C "$ROOT" rev-parse HEAD)"
if [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=normal)" ]; then
  echo "maho-vm-certify: refusing dirty checkout; commit the exact candidate before certification" >&2
  exit 2
fi
if [[ "$PROFILE" == torture-* ]]; then
  STATE="${XDG_STATE_HOME:-$HOME/.local/state}/maho/certification/vm-torture"
else
  STATE="${XDG_STATE_HOME:-$HOME/.local/state}/maho/certification/vm"
fi
EVIDENCE="${MAHO_VM_EVIDENCE:-$STATE/$STAMP-$PROFILE-$REV}"
KVER="${MAHO_VM_KERNEL_VERSION:-$(uname -r)}"
WORK="${XDG_CACHE_HOME:-$HOME/.cache}/maho/vm-certify/$REV-$KVER"
KERNEL="${MAHO_VM_KERNEL_IMAGE:-/boot/vmlinuz-linux-cachyos}"
if [[ "$PROFILE" == torture-* ]]; then
  TIMEOUT="${MAHO_VM_TIMEOUT:-2700}"
else
  TIMEOUT="${MAHO_VM_TIMEOUT:-720}"
fi

if [ "$PROFILE" = torture ]; then
  exec "$ROOT/tools/maho-vm-torture"
fi

case "$PROFILE" in
  smoke|fresh-user|update-freeze|resilience|session) MEMORY=4096 ;;
  performance-4g) MEMORY=4096 ;;
  performance-8g) MEMORY=8192 ;;
  torture-session|torture-guardian|torture-runtime|torture-runtime-executor|torture-runtime-executor-after|torture-runtime-guardian-verifying|torture-postconditions|torture-network|torture-update|torture-update-compound|torture-storage|torture-final-contracts|torture-compound|torture-reboot-awaiting|torture-reboot-recovering|torture-reboot-verifying|torture-reboot-update-phases|torture-root-destruction) MEMORY=4096 ;;
  torture-prevention)
    export MAHO_VM_PROFILE_EVIDENCE="$EVIDENCE"
    exec "$ROOT/tools/vm/prevention-torture-profile"
    ;;
  *) echo "maho-vm-certify: unknown profile: $PROFILE" >&2; exit 2 ;;
esac

for c in qemu-system-x86_64 mkinitcpio python3 git; do
  command -v "$c" >/dev/null || { echo "maho-vm-certify: missing $c" >&2; exit 2; }
done
[ -r "$KERNEL" ] || { echo "maho-vm-certify: kernel unavailable: $KERNEL" >&2; exit 2; }
[ -e /dev/kvm ] || { echo "maho-vm-certify: /dev/kvm unavailable" >&2; exit 2; }
mkdir -p "$WORK/hookdir/install" "$WORK/hookdir/hooks" "$EVIDENCE"
ln -sf /usr/lib/initcpio/install/base "$WORK/hookdir/install/base"
cp "$ROOT/tools/vm/initcpio/install/maho_vm_overlay" "$WORK/hookdir/install/"
cp "$ROOT/tools/vm/initcpio/hooks/maho_vm_overlay" "$WORK/hookdir/hooks/"
chmod +x "$WORK/hookdir/install/maho_vm_overlay" "$WORK/hookdir/hooks/maho_vm_overlay"

rebuild_initramfs=0
[ -r "$WORK/initramfs.img" ] || rebuild_initramfs=1
for source in   "$ROOT/tools/vm/mkinitcpio.conf"   "$ROOT/tools/vm/initcpio/install/maho_vm_overlay"   "$ROOT/tools/vm/initcpio/hooks/maho_vm_overlay"; do
  [ "$source" -nt "$WORK/initramfs.img" ] && rebuild_initramfs=1
done
if [ "$rebuild_initramfs" -eq 1 ]; then
  mkinitcpio -n     -c "$ROOT/tools/vm/mkinitcpio.conf"     -D "$WORK/hookdir"     -k "$KVER"     -g "$WORK/initramfs.img"
fi

CMDLINE="console=ttyS0,115200 rd.log=console root=hostroot rw systemd.unit=maho-vm-certify.target maho.vm.profile=$PROFILE maho.vm.source_revision=$REV"
HOME_IMAGE=""
EXTRA_QEMU=()

case "$PROFILE" in
  session|performance-4g|performance-8g|torture-session|torture-guardian|torture-runtime|torture-runtime-executor|torture-runtime-executor-after|torture-runtime-guardian-verifying|torture-postconditions|torture-network|torture-update|torture-update-compound|torture-storage|torture-final-contracts|torture-compound|torture-reboot-awaiting|torture-reboot-recovering|torture-reboot-verifying|torture-reboot-update-phases|torture-root-destruction)
    command -v mkfs.ext4 >/dev/null || { echo "maho-vm-certify: missing mkfs.ext4" >&2; exit 2; }
    HOME_IMAGE="$WORK/home-$STAMP-$PROFILE.img"
    truncate -s 8G "$HOME_IMAGE"
    mkfs.ext4 -q -F "$HOME_IMAGE"
    CMDLINE="$CMDLINE maho.vm.diskhome=1"
    EXTRA_QEMU=(
      -device bochs-display
      -drive "file=$HOME_IMAGE,format=raw,if=virtio,cache=none"
    )
    ;;
esac
if [[ "$PROFILE" == torture-* ]]; then
  CMDLINE="$CMDLINE maho.vm.torture=1 maho.vm.allowed_writable_block=vda maho.vm.torture_iterations=${MAHO_TORTURE_ITERATIONS:-20}"
fi
if [ "$PROFILE" = torture-final-contracts ]; then
  PICKER_RELEASE="${MAHO_WALLPAPER_PICKER_RELEASE:-$(readlink -f "${XDG_DATA_HOME:-$HOME/.local/share}/maho/components/qs-wallpaper-picker/current" 2>/dev/null || true)}"
  [ -d "$PICKER_RELEASE" ] || { echo "maho-vm-certify: wallpaper picker release unavailable: $PICKER_RELEASE" >&2; exit 2; }
  [ -x "$PICKER_RELEASE/scripts/open_picker.sh" ] || { echo "maho-vm-certify: wallpaper picker launcher missing" >&2; exit 2; }
  [ -r "$PICKER_RELEASE/.maho-source-revision" ] || { echo "maho-vm-certify: wallpaper picker revision marker missing" >&2; exit 2; }
  PICKER_REV="$(cat "$PICKER_RELEASE/.maho-source-revision")"
  [[ "$PICKER_REV" =~ ^[0-9a-f]{40}$ ]] || { echo "maho-vm-certify: invalid wallpaper picker revision: $PICKER_REV" >&2; exit 2; }
  PICKER_SHA="$(python3 - "$PICKER_RELEASE" <<'PY_PICKER_SHA'
import hashlib, pathlib, sys
root=pathlib.Path(sys.argv[1])
h=hashlib.sha256()
for path in sorted(p for p in root.rglob("*") if p.is_file()):
    rel=path.relative_to(root).as_posix().encode()
    data=path.read_bytes()
    h.update(len(rel).to_bytes(8,"big")); h.update(rel)
    h.update(len(data).to_bytes(8,"big")); h.update(data)
print(h.hexdigest())
PY_PICKER_SHA
)"
  CMDLINE="$CMDLINE maho.vm.wallpaper_picker_revision=$PICKER_REV maho.vm.wallpaper_picker_sha256=$PICKER_SHA"
  EXTRA_QEMU+=(
    -virtfs "local,path=$PICKER_RELEASE,mount_tag=wallpaper_picker,security_model=none,readonly=on"
  )
  printf 'INFO  wallpaper-picker revision=%s tree_sha256=%s
' "$PICKER_REV" "$PICKER_SHA"
fi
if [ "$PROFILE" = torture-root-destruction ]; then
  CMDLINE="$CMDLINE lsm=landlock,lockdown,yama,integrity,bpf"
fi
trap '[ -z "$HOME_IMAGE" ] || rm -f -- "$HOME_IMAGE"' EXIT

QEMU=(
  qemu-system-x86_64
  -enable-kvm
  -machine q35,accel=kvm
  -cpu host
  -smp 4
  -m "$MEMORY"
  -kernel "$KERNEL"
  -initrd "$WORK/initramfs.img"
  -append "$CMDLINE"
  -nographic
  -no-reboot
  -nic none
  -device virtio-rng-pci
  -virtfs "local,path=/,mount_tag=hostroot,security_model=none,readonly=on"
  -virtfs "local,path=$ROOT,mount_tag=maho_repo,security_model=none,readonly=on"
  -virtfs "local,path=$EVIDENCE,mount_tag=maho_evidence,security_model=none"
  "${EXTRA_QEMU[@]}"
)
printf 'INFO  Maho VM profile=%s revision=%s memory=%sMiB\n' "$PROFILE" "$REV" "$MEMORY"
printf 'INFO  evidence=%s\n' "$EVIDENCE"

if [[ "$PROFILE" == torture-reboot-* ]]; then
  QEMU_STAGE1=("${QEMU[@]}")
  QEMU_STAGE2=("${QEMU[@]}")
  for i in "${!QEMU_STAGE1[@]}"; do
    if [ "${QEMU_STAGE1[$i]}" = "-append" ]; then
      QEMU_STAGE1[$((i+1))]="${QEMU_STAGE1[$((i+1))]} maho.vm.torture_stage=1"
      QEMU_STAGE2[$((i+1))]="${QEMU_STAGE2[$((i+1))]} maho.vm.torture_stage=2"
      break
    fi
  done

  rm -f "$EVIDENCE/reboot-stage1-ready" "$EVIDENCE/summary.json"
  "${QEMU_STAGE1[@]}" >"$EVIDENCE/qemu-stage1.log" 2>&1 &
  QEMU_STAGE1_PID=$!
  deadline=$((SECONDS + TIMEOUT))
  while [ ! -e "$EVIDENCE/reboot-stage1-ready" ] && kill -0 "$QEMU_STAGE1_PID" 2>/dev/null; do
    [ "$SECONDS" -lt "$deadline" ] || break
    sleep 1
  done
  if [ ! -e "$EVIDENCE/reboot-stage1-ready" ]; then
    kill -TERM "$QEMU_STAGE1_PID" 2>/dev/null || true
    wait "$QEMU_STAGE1_PID" 2>/dev/null || true
    echo "FAIL  reboot torture stage1 did not reach durable cut point" >&2
    tail -160 "$EVIDENCE/qemu-stage1.log" >&2 || true
    exit 1
  fi
  kill -TERM "$QEMU_STAGE1_PID" 2>/dev/null || true
  wait "$QEMU_STAGE1_PID" 2>/dev/null || true
  rm -f "$EVIDENCE/summary.json"

  set +e
  timeout --signal=TERM --kill-after=10 "$TIMEOUT" "${QEMU_STAGE2[@]}" >"$EVIDENCE/qemu-stage2.log" 2>&1
  QEMU_RC=$?
  set -e
  QEMU_RESULT_LOG="$EVIDENCE/qemu-stage2.log"
else
  set +e
  timeout --signal=TERM --kill-after=10 "$TIMEOUT" "${QEMU[@]}" >"$EVIDENCE/qemu.log" 2>&1
  QEMU_RC=$?
  set -e
  QEMU_RESULT_LOG="$EVIDENCE/qemu.log"
fi

if [ "$QEMU_RC" -ne 0 ]; then
  echo "FAIL  QEMU exited rc=$QEMU_RC" >&2
  tail -120 "$QEMU_RESULT_LOG" >&2 || true
  exit "$QEMU_RC"
fi

[ -r "$EVIDENCE/summary.json" ] || {
  echo "FAIL  guest did not emit summary.json" >&2
  tail -120 "$QEMU_RESULT_LOG" >&2 || true
  exit 1
}

if [ "$PROFILE" = torture-root-destruction ]; then
  python3 - "$EVIDENCE" "$REV" <<'PY_ROOT'
import hashlib
import json
import pathlib
import sys

evidence = pathlib.Path(sys.argv[1])
revision = sys.argv[2]
root = evidence / "scenarios" / "full-disposable-root-destruction" / "iteration-1"
scenario = json.loads((root / "summary.json").read_text())
result = json.loads((root / "evidence" / "root-destruction-result.json").read_text())

assert scenario["source_revision"] == revision, scenario
assert scenario["expected_outcome"] == "PREVENTED", scenario
assert scenario["actual_outcome"] == "PREVENTED", scenario
assert scenario["pass"] is True, scenario
assert scenario["host_mutation_performed"] is False, scenario
assert scenario["guest_root_mutation_performed"] is True, scenario
assert scenario["protected_effect_blocked"] is True, scenario

command_lines = (root / "evidence" / "attack-command.txt").read_text().splitlines()
assert command_lines and command_lines[0] == "/usr/bin/rm -rf --one-file-system --no-preserve-root /", command_lines
for key in (
    "attack_executed",
    "unprotected_fixture_deleted",
    "protected_usr",
    "protected_etc",
    "protected_boot",
    "protected_pacman",
    "protected_runtime",
    "protected_bytes_unchanged",
    "prevention_evidence",
    "pass",
):
    assert result.get(key) is True, (key, result)
assert result.get("durable_sink") == "maho_evidence_9p", result
assert result.get("host_mutation_performed") is False, result

names = ("usr-bash", "etc-passwd", "boot-kernel", "pacman-db-version", "runtime-manifest")
before = root / "evidence" / "protected-before"
after = root / "evidence" / "protected-after"
def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
hashes = {}
for name in names:
    before_hash = digest(before / name)
    after_hash = digest(after / name)
    assert before_hash == after_hash, (name, before_hash, after_hash)
    hashes[name] = before_hash

recorded = {}
for line in (root / "evidence" / "protected-before.sha256").read_text().splitlines():
    value, path = line.split(maxsplit=1)
    recorded[pathlib.Path(path).name] = value
assert recorded == hashes, (recorded, hashes)
(root / "evidence" / "protected-after.sha256").write_text(
    "".join(f"{hashes[name]}  {name}\n" for name in names)
)

rows = [
    json.loads(line)
    for line in (root / "evidence" / "root-destruction-events.jsonl").read_text().splitlines()
    if line.strip()
]
assert rows, "no Prevention Boundary evidence"
rm_inode = int(result["rm_executable_inode"])
assert any(
    row.get("result") == "prevented"
    and row.get("host_mutation_performed") is False
    and int((row.get("subject") or {}).get("executable_inode", -1)) == rm_inode
    for row in rows
), "no valid prevention event attributable to the real rm process"

host_verification = {
    "schema_version": 1,
    "source_revision": revision,
    "attack_command_verified": True,
    "scenario_classification": "PREVENTED",
    "protected_hashes_unchanged": True,
    "valid_prevention_event_for_rm": True,
    "host_mutation_performed": False,
    "pass": True,
}
(root / "evidence" / "host-verification.json").write_text(
    json.dumps(host_verification, indent=2, sort_keys=True) + "\n"
)
print("PASS  independent host verification for full disposable-root destruction")
PY_ROOT
fi

python3 - "$EVIDENCE/summary.json" "$PROFILE" "$REV" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
profile, revision = sys.argv[2:]
data = json.loads(path.read_text())
assert data["schema_version"] == 1
assert data["profile"] == profile, data
assert data["source_revision"] == revision, data
assert data["status"] == "passed", data
assert data["exit_code"] == 0, data
print(f"PASS  VM profile {profile} ({data['duration_seconds']}s)")
PY

echo "PASS  evidence $EVIDENCE"

[Unit]
Description=Maho wallpaper runtime restoration, observation and theme adaptation
After=graphical-session.target maho-awww-daemon.service
Requires=maho-awww-daemon.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/.local/bin/maho-wallpaper-session run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Maho awww wallpaper runtime
After=graphical-session.target maho-hyprland-session.target
PartOf=maho-hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=/usr/bin/awww-daemon --no-cache
ExecStartPost=%h/.local/bin/maho-session wait-awww
ExecStartPost=-/usr/bin/bash %h/.local/bin/maho-wallpaper-session restore
Restart=always
RestartSec=2

[Install]
WantedBy=maho-hyprland-session.target

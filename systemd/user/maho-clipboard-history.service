[Unit]
Description=Maho Clipboard history capture
After=graphical-session.target maho-hyprland-session.target
PartOf=maho-hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/maho-clipboard-history serve
Restart=always
RestartSec=1

[Install]
WantedBy=maho-hyprland-session.target

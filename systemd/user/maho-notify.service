[Unit]
Description=Maho compact Quickshell notification surface
After=graphical-session.target
PartOf=maho-hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/maho-notify run
Restart=on-failure
RestartSec=2

[Install]
WantedBy=maho-hyprland-session.target

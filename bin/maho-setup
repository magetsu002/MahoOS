#!/usr/bin/env bash
set -u

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$HOME/.local/bin"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
UNIT_DIR="$CONFIG_HOME/systemd/user"
SHELL_SOURCE="$ROOT/config/quickshell/maho-shell"
SHELL_TARGET="$CONFIG_HOME/quickshell/maho-shell"
NOTIFY_SOURCE="$ROOT/config/quickshell/maho-notify"
NOTIFY_TARGET="$CONFIG_HOME/quickshell/maho-notify"
HYPR_SESSION_SOURCE="$ROOT/config/hypr/maho/core/session.lua"
HYPR_SESSION_TARGET="$CONFIG_HOME/hypr/maho/core/session.lua"
FILES_DESKTOP_SOURCE="$ROOT/apps/maho-files/io.maho.Files.desktop"
FILES_DESKTOP_TARGET="$DATA_HOME/applications/io.maho.Files.desktop"
MARKER="# managed-by: maho-setup v1"

COMMANDS=(
  mahoctl maho-theme maho-wallpaper maho-wallpaper-session maho-observe
  maho-adapt maho-provenance maho-security maho-security-monitor maho-guard
  maho-contain maho-shell maho-notify maho-session maho-launcher maho-dock
  maho-files maho-link maho-lock maho-power maho-clipboard
  maho-clipboard-history maho-setup
)
CORE_UNITS=(maho-observe.service maho-security.service)
GRAPHICAL_UNITS=(
  maho-awww-daemon.service maho-wallpaper.service maho-shell.service
  maho-dock.service maho-notify.service maho-clipboard-history.service
)
SESSION_TARGET_UNIT=maho-hyprland-session.target
UNITS=("${CORE_UNITS[@]}" "${GRAPHICAL_UNITS[@]}" "$SESSION_TARGET_UNIT")

SHELL_FILES=(
  shell.qml dock-shell.qml MahoTheme.qml Audio.qml Brightness.qml Battery.qml
  Media.qml SystemState.qml DockState.qml DockReservation.qml MahoCard.qml
  SliderCard.qml WorkspaceRail.qml EdgeBar.qml SideEdgeBar.qml NotifyStatus.qml
  ControlCenter.qml state.py
)
NOTIFY_FILES=(
  shell.qml NotificationService.qml NotificationModel.qml NotificationStack.qml
  NotificationCard.qml NotifyTheme.qml HistoryModel.qml NotificationCenter.qml
  HistoryRow.qml state.py
)
REQUIRED_ASSETS=(
  config/hypr/maho/core/session.lua
  config/quickshell/maho-launcher/shell.qml
  config/quickshell/maho-link/shell.qml
  config/quickshell/maho-link/position.py
  config/quickshell/maho-lock/shell.qml
  config/quickshell/maho-lock/preview.qml
  config/quickshell/maho-power/shell.qml
  config/quickshell/maho-clipboard/shell.qml
  apps/maho-files/CMakeLists.txt
  apps/maho-files/io.maho.Files.desktop
  lib/maho_app_model.py
  lib/maho_launcher_backend.py
)

die() { echo "maho-setup: $*" >&2; return 1; }
launcher_path() { printf '%s/%s\n' "$BIN_DIR" "$1"; }
unit_source() { printf '%s/systemd/user/%s\n' "$ROOT" "$1"; }
unit_target() { printf '%s/%s\n' "$UNIT_DIR" "$1"; }

is_managed_launcher() {
  local p; p="$(launcher_path "$1")"
  [ -e "$p" ] || [ -L "$p" ] || return 1
  if [ -L "$p" ]; then
    [ "$(readlink -f -- "$p" 2>/dev/null || true)" = "$ROOT/bin/$1" ]
  else
    grep -Fq "$MARKER" "$p" 2>/dev/null
  fi
}

is_managed_unit() {
  local src dst; src="$(unit_source "$1")"; dst="$(unit_target "$1")"
  if [ -L "$dst" ]; then
    [ "$(readlink -f -- "$dst" 2>/dev/null || true)" = "$src" ]
  else
    [ -f "$dst" ] && cmp -s "$dst" "$src"
  fi
}

is_managed_dir_link() {
  [ -L "$2" ] && [ "$(readlink -f -- "$2" 2>/dev/null || true)" = "$1" ]
}

is_managed_file_target() {
  local src="$1" dst="$2"
  if [ -L "$dst" ]; then
    [ "$(readlink -f -- "$dst" 2>/dev/null || true)" = "$src" ]
  else
    [ -f "$dst" ] && cmp -s "$dst" "$src"
  fi
}

report_capability() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'PASS  capability %-14s\n' "$1"
  else
    printf 'INFO  capability %-14s unavailable\n' "$1"
  fi
}

preflight() {
  local failed=0 name file
  [ -d "$ROOT/bin" ] || { echo "FAIL  repository bin directory missing"; failed=1; }
  for name in "${COMMANDS[@]}"; do
    [ -r "$ROOT/bin/$name" ] && printf 'PASS  source %-24s\n' "$name" || {
      printf 'FAIL  source %-24s missing\n' "$name"; failed=1;
    }
  done
  for name in "${UNITS[@]}"; do
    [ -r "$(unit_source "$name")" ] && printf 'PASS  unit   %s\n' "$name" || {
      printf 'FAIL  unit   %s missing\n' "$name"; failed=1;
    }
  done
  for name in "${SHELL_FILES[@]}"; do
    [ -r "$SHELL_SOURCE/$name" ] || { echo "FAIL  shell  $name missing"; failed=1; }
  done
  for name in "${NOTIFY_FILES[@]}"; do
    [ -r "$NOTIFY_SOURCE/$name" ] || { echo "FAIL  notify $name missing"; failed=1; }
  done
  for file in "${REQUIRED_ASSETS[@]}"; do
    [ -r "$ROOT/$file" ] || { echo "FAIL  asset  $file missing"; failed=1; }
  done
  for file in config/ownership.json config/intent.json config/adapters.json; do
    python -m json.tool "$ROOT/$file" >/dev/null 2>&1 || { echo "FAIL  json   $file"; failed=1; }
  done
  python -m py_compile \
    "$ROOT/lib/security_probe.py" "$ROOT/lib/security_containment.py" \
    "$ROOT/lib/security_incident.py" "$ROOT/lib/security_preflight.py" \
    "$ROOT/lib/security_boundary.py" "$ROOT/lib/maho_app_model.py" \
    "$ROOT/lib/maho_launcher_backend.py" "$SHELL_SOURCE/state.py" \
    "$NOTIFY_SOURCE/state.py" "$ROOT/config/quickshell/maho-link/position.py" \
    >/dev/null 2>&1 || { echo "FAIL  python modules"; failed=1; }
  for name in "${COMMANDS[@]}"; do
    bash -n "$ROOT/bin/$name" >/dev/null 2>&1 || { echo "FAIL  shell syntax $name"; failed=1; }
  done
  bash -n "$ROOT/lib/authority.sh" "$ROOT/lib/intent.sh" "$ROOT/lib/state.sh" \
    "$ROOT/lib/events.sh" "$ROOT/lib/decision.sh" "$ROOT/lib/policy.sh" \
    "$ROOT/lib/cycle.sh" "$ROOT/lib/transaction.sh" \
    "$ROOT/adapters/appearance/wallpaper-theme.sh" >/dev/null 2>&1 || {
      echo "FAIL  shared shell syntax"; failed=1;
    }
  [ "$failed" -eq 0 ] && echo "PASS  shell syntax"
  for name in quickshell awww-daemon brightnessctl wpctl nmcli bluetoothctl \
    wl-paste wl-copy cliphist cmake ninja; do report_capability "$name"; done
  if command -v qmake6 >/dev/null 2>&1 || command -v qtpaths6 >/dev/null 2>&1; then
    echo "PASS  capability Qt6"
  else
    echo "INFO  capability Qt6 unavailable; Maho Files cannot build"
  fi
  if find /usr/lib/cmake /usr/lib64/cmake -maxdepth 2 -type f \
    \( -name KF6KIOConfig.cmake -o -name KF6KIOConfigVersion.cmake \) \
    -print -quit 2>/dev/null | grep -q .; then
    echo "PASS  capability KDE-KIO"
  else
    echo "INFO  capability KDE-KIO unavailable; Maho Files cannot build"
  fi
  return "$failed"
}

write_launcher() {
  local name="$1" dst tmp; dst="$(launcher_path "$name")"
  if { [ -e "$dst" ] || [ -L "$dst" ]; } && ! is_managed_launcher "$name"; then
    die "refusing to overwrite unmanaged command: $dst"; return 1
  fi
  mkdir -p "$BIN_DIR"; tmp="$BIN_DIR/.${name}.$$"
  cat >"$tmp" <<EOF_LAUNCHER
#!/usr/bin/env bash
$MARKER
export MAHO_ROOT="$ROOT"
bash "$ROOT/bin/$name" "\$@"
EOF_LAUNCHER
  chmod 0755 "$tmp"; mv -f "$tmp" "$dst"
}

install_unit() {
  local name="$1" src dst; src="$(unit_source "$name")"; dst="$(unit_target "$name")"
  mkdir -p "$UNIT_DIR"
  if { [ -e "$dst" ] || [ -L "$dst" ]; } && ! is_managed_unit "$name"; then
    die "refusing to replace unmanaged user unit: $dst"; return 1
  fi
  rm -f "$dst"; ln -s "$src" "$dst"
}

install_dir_link() {
  local src="$1" dst="$2" label="$3"; mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    is_managed_dir_link "$src" "$dst" || { die "refusing to replace unmanaged $label: $dst"; return 1; }
    rm -f "$dst"
  fi
  ln -s "$src" "$dst"
}

install_file_target() {
  local src="$1" dst="$2" label="$3"; mkdir -p "$(dirname "$dst")"
  if [ -e "$dst" ] || [ -L "$dst" ]; then
    # An ancestor symlink may already expose source at dst. Never unlink source.
    if [ ! -L "$dst" ] && [ "$dst" -ef "$src" ]; then return 0; fi
    is_managed_file_target "$src" "$dst" || { die "refusing to replace unmanaged $label: $dst"; return 1; }
    rm -f "$dst"
  fi
  ln -s "$src" "$dst"
}

remove_managed_file_target() {
  local src="$1" dst="$2" label="$3"
  if [ -L "$dst" ]; then
    if is_managed_file_target "$src" "$dst"; then rm -f "$dst"; echo "REMOVED  $dst";
    else echo "KEPT     unmanaged $label $dst"; fi
  elif [ -f "$dst" ]; then
    if [ "$dst" -ef "$src" ]; then
      echo "KEPT     $label exposed through existing parent mapping $dst"
    elif cmp -s "$dst" "$src"; then rm -f "$dst"; echo "REMOVED  $dst"
    else echo "KEPT     unmanaged $label $dst"; fi
  fi
}

systemd_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

remove_managed_enablement_link() {
  local name="$1" wants="$2" link src resolved
  link="$UNIT_DIR/$wants/$name"; [ -L "$link" ] || return 0
  src="$(readlink -f -- "$(unit_target "$name")" 2>/dev/null || true)"
  resolved="$(readlink -f -- "$link" 2>/dev/null || true)"
  [ -n "$src" ] && [ "$resolved" = "$src" ] && rm -f "$link"
}

remove_stale_graphical_ownership() {
  local name
  for name in "${GRAPHICAL_UNITS[@]}"; do
    remove_managed_enablement_link "$name" default.target.wants
    remove_managed_enablement_link "$name" graphical-session.target.wants
  done
  remove_managed_enablement_link "$SESSION_TARGET_UNIT" default.target.wants
  remove_managed_enablement_link "$SESSION_TARGET_UNIT" graphical-session.target.wants
}

install() {
  local name
  echo "Maho OS V1 setup"; echo; preflight || return 1
  echo; echo "Installing user commands..."
  for name in "${COMMANDS[@]}"; do write_launcher "$name" || return 1; done
  install_dir_link "$SHELL_SOURCE" "$SHELL_TARGET" "Quickshell configuration" || return 1
  install_dir_link "$NOTIFY_SOURCE" "$NOTIFY_TARGET" "Maho Notify configuration" || return 1
  install_file_target "$HYPR_SESSION_SOURCE" "$HYPR_SESSION_TARGET" "Hyprland session hook" || return 1
  install_file_target "$FILES_DESKTOP_SOURCE" "$FILES_DESKTOP_TARGET" "Maho Files desktop entry" || return 1
  for name in "${UNITS[@]}"; do install_unit "$name" || return 1; done
  remove_stale_graphical_ownership
  if systemd_available; then
    systemctl --user daemon-reload
    for name in "${CORE_UNITS[@]}"; do
      if systemctl --user enable --now "$name" >/dev/null 2>&1; then
        echo "PASS  $name enabled and started"
      else
        echo "INFO  $name could not be started now; installation remains valid"
      fi
    done
    echo "INFO  graphical runtime installed; activation is owned by maho-session"
  else
    echo "INFO  systemd user manager unavailable; service activation deferred"
  fi
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$(dirname "$FILES_DESKTOP_TARGET")" >/dev/null 2>&1 || true
  echo "PASS: Maho OS V1 user setup complete"
}

status() {
  local failed=0 name
  echo "Maho OS V1 setup status"; echo "Repository: $ROOT"
  for name in "${COMMANDS[@]}"; do is_managed_launcher "$name" || { echo "INFO  command $name not managed"; failed=1; }; done
  is_managed_dir_link "$SHELL_SOURCE" "$SHELL_TARGET" || { echo "INFO  shell not managed"; failed=1; }
  is_managed_dir_link "$NOTIFY_SOURCE" "$NOTIFY_TARGET" || { echo "INFO  notify not managed"; failed=1; }
  is_managed_file_target "$HYPR_SESSION_SOURCE" "$HYPR_SESSION_TARGET" || { echo "INFO  session hook not managed"; failed=1; }
  is_managed_file_target "$FILES_DESKTOP_SOURCE" "$FILES_DESKTOP_TARGET" || { echo "INFO  Files desktop entry not managed"; failed=1; }
  for name in "${UNITS[@]}"; do is_managed_unit "$name" || { echo "INFO  unit $name not managed"; failed=1; }; done
  if systemd_available; then
    for name in "${UNITS[@]}"; do
      systemctl --user is-active --quiet "$name" && echo "PASS  service $name active" || echo "INFO  service $name inactive"
    done
  fi
  return "$failed"
}

uninstall() {
  local name dst path
  echo "Maho OS V1 user uninstall"
  if systemd_available; then
    systemctl --user stop "$SESSION_TARGET_UNIT" >/dev/null 2>&1 || true
    for name in "${CORE_UNITS[@]}"; do systemctl --user disable --now "$name" >/dev/null 2>&1 || true; done
  fi
  remove_stale_graphical_ownership
  for name in "${GRAPHICAL_UNITS[@]}"; do remove_managed_enablement_link "$name" "$SESSION_TARGET_UNIT.wants"; done
  for name in "${UNITS[@]}"; do
    dst="$(unit_target "$name")"
    if is_managed_unit "$name"; then rm -f "$dst"; echo "REMOVED  $dst"
    elif [ -e "$dst" ] || [ -L "$dst" ]; then echo "KEPT     unmanaged user unit $dst"; fi
  done
  if is_managed_dir_link "$SHELL_SOURCE" "$SHELL_TARGET"; then rm -f "$SHELL_TARGET"; fi
  if is_managed_dir_link "$NOTIFY_SOURCE" "$NOTIFY_TARGET"; then rm -f "$NOTIFY_TARGET"; fi
  remove_managed_file_target "$HYPR_SESSION_SOURCE" "$HYPR_SESSION_TARGET" "Hyprland session hook"
  remove_managed_file_target "$FILES_DESKTOP_SOURCE" "$FILES_DESKTOP_TARGET" "Maho Files desktop entry"
  for name in "${COMMANDS[@]}"; do
    path="$(launcher_path "$name")"
    if is_managed_launcher "$name"; then rm -f "$path"
    elif [ -e "$path" ] || [ -L "$path" ]; then echo "KEPT     unmanaged command $path"; fi
  done
  systemd_available && systemctl --user daemon-reload >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$(dirname "$FILES_DESKTOP_TARGET")" >/dev/null 2>&1 || true
  echo "PASS: Maho-managed user wiring removed; user data and unmanaged configuration preserved"
}

case "${1:-}" in
  install) install ;;
  status) status ;;
  uninstall) uninstall ;;
  preflight) preflight ;;
  *) cat <<'HELP'
Maho OS V1 user setup

Usage:
  bash bin/maho-setup preflight
  bash bin/maho-setup install
  maho-setup status
  maho-setup uninstall

Setup wires the accepted Maho runtime from the current checkout without root or
package installation. Observe/security follow the user-manager lifetime.
Graphical services are installed under maho-hyprland-session.target and only
maho-session activates that target for a valid Hyprland Wayland session.
Unmanaged commands, units, desktop entries, Hyprland hooks and Quickshell
configuration are never overwritten.
HELP
  ;;
esac

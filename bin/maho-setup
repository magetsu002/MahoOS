#!/usr/bin/env bash

set -u

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${HOME}/.local/bin"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SHELL_SOURCE="$ROOT/config/quickshell/maho-shell"
SHELL_TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/maho-shell"
MARKER="# managed-by: maho-setup v1"

COMMANDS=(
    mahoctl
    maho-theme
    maho-wallpaper
    maho-wallpaper-session
    maho-observe
    maho-adapt
    maho-provenance
    maho-security
    maho-security-monitor
    maho-guard
    maho-contain
    maho-shell
    maho-setup
)

UNITS=(
    maho-wallpaper.service
    maho-observe.service
    maho-security.service
    maho-shell.service
)

SHELL_FILES=(
    shell.qml
    MahoTheme.qml
    Audio.qml
    Brightness.qml
    Battery.qml
    Media.qml
    SystemState.qml
    MahoCard.qml
    SliderCard.qml
    CollapsedIsland.qml
    ControlCenter.qml
    state.py
)

die() {
    echo "maho-setup: $*" >&2
    return 1
}

launcher_path() {
    printf '%s/%s\n' "$BIN_DIR" "$1"
}

unit_source() {
    printf '%s/systemd/user/%s\n' "$ROOT" "$1"
}

unit_target() {
    printf '%s/%s\n' "$UNIT_DIR" "$1"
}

is_managed_launcher() {
    local name="$1" path
    path="$(launcher_path "$name")"
    [ -e "$path" ] || [ -L "$path" ] || return 1
    if [ -L "$path" ]; then
        [ "$(readlink -f -- "$path" 2>/dev/null || true)" = "$ROOT/bin/$name" ]
        return
    fi
    grep -Fq "$MARKER" "$path" 2>/dev/null
}

is_managed_unit() {
    local name="$1" source target
    source="$(unit_source "$name")"
    target="$(unit_target "$name")"
    if [ -L "$target" ]; then
        [ "$(readlink -f -- "$target" 2>/dev/null || true)" = "$source" ]
        return
    fi
    [ -f "$target" ] && cmp -s "$target" "$source"
}

is_managed_shell() {
    [ -L "$SHELL_TARGET" ] || return 1
    [ "$(readlink -f -- "$SHELL_TARGET" 2>/dev/null || true)" = "$SHELL_SOURCE" ]
}

preflight() {
    local failed=0 name file
    [ -d "$ROOT/bin" ] || { echo "FAIL  repository bin directory missing"; failed=1; }

    for name in "${COMMANDS[@]}"; do
        if [ -r "$ROOT/bin/$name" ]; then
            printf 'PASS  source %-24s\n' "$name"
        else
            printf 'FAIL  source %-24s missing\n' "$name"
            failed=1
        fi
    done

    for name in "${UNITS[@]}"; do
        if [ -r "$(unit_source "$name")" ]; then
            printf 'PASS  unit   %s\n' "$name"
        else
            printf 'FAIL  unit   %s missing\n' "$name"
            failed=1
        fi
    done

    for name in "${SHELL_FILES[@]}"; do
        if [ -r "$SHELL_SOURCE/$name" ]; then
            printf 'PASS  shell  %s\n' "$name"
        else
            printf 'FAIL  shell  %s missing\n' "$name"
            failed=1
        fi
    done

    for file in config/ownership.json config/intent.json config/adapters.json; do
        if python -m json.tool "$ROOT/$file" >/dev/null 2>&1; then
            printf 'PASS  json   %s\n' "$file"
        else
            printf 'FAIL  json   %s\n' "$file"
            failed=1
        fi
    done

    if python -m py_compile \
        "$ROOT/lib/security_probe.py" \
        "$ROOT/lib/security_containment.py" \
        "$ROOT/lib/security_incident.py" \
        "$ROOT/lib/security_preflight.py" \
        "$ROOT/lib/security_boundary.py" \
        "$SHELL_SOURCE/state.py" \
        >/dev/null 2>&1; then
        echo "PASS  python modules"
    else
        echo "FAIL  python modules"
        failed=1
    fi

    bash -n \
        "$ROOT/bin/mahoctl" \
        "$ROOT/bin/maho-theme" \
        "$ROOT/bin/maho-wallpaper" \
        "$ROOT/bin/maho-wallpaper-session" \
        "$ROOT/bin/maho-observe" \
        "$ROOT/bin/maho-adapt" \
        "$ROOT/bin/maho-provenance" \
        "$ROOT/bin/maho-security" \
        "$ROOT/bin/maho-security-monitor" \
        "$ROOT/bin/maho-guard" \
        "$ROOT/bin/maho-contain" \
        "$ROOT/bin/maho-shell" \
        "$ROOT/bin/maho-setup" \
        "$ROOT/lib/authority.sh" \
        "$ROOT/lib/intent.sh" \
        "$ROOT/lib/state.sh" \
        "$ROOT/lib/events.sh" \
        "$ROOT/lib/decision.sh" \
        "$ROOT/lib/policy.sh" \
        "$ROOT/lib/cycle.sh" \
        "$ROOT/lib/transaction.sh" \
        "$ROOT/adapters/appearance/wallpaper-theme.sh" \
        >/dev/null 2>&1 || {
            echo "FAIL  shell syntax"
            failed=1
        }

    [ "$failed" -eq 0 ] && echo "PASS  shell syntax"

    if command -v quickshell >/dev/null 2>&1; then
        echo "PASS  capability quickshell"
    else
        echo "INFO  capability quickshell unavailable; Maho Shell will remain installed but inactive"
    fi

    if command -v brightnessctl >/dev/null 2>&1; then
        echo "PASS  capability brightnessctl"
    else
        echo "INFO  capability brightnessctl unavailable; brightness control will be disabled"
    fi

    return "$failed"
}

write_launcher() {
    local name="$1" target tmp
    target="$(launcher_path "$name")"
    if { [ -e "$target" ] || [ -L "$target" ]; } && ! is_managed_launcher "$name"; then
        die "refusing to overwrite unmanaged command: $target"
        return 1
    fi
    mkdir -p "$BIN_DIR"
    tmp="$BIN_DIR/.${name}.$$"
    cat > "$tmp" <<EOF_LAUNCHER
#!/usr/bin/env bash
$MARKER
export MAHO_ROOT="$ROOT"
bash "$ROOT/bin/$name" "\$@"
EOF_LAUNCHER
    chmod 0755 "$tmp"
    mv -f "$tmp" "$target"
}

install_unit() {
    local name="$1" source target
    source="$(unit_source "$name")"
    target="$(unit_target "$name")"
    mkdir -p "$UNIT_DIR"
    if { [ -e "$target" ] || [ -L "$target" ]; } && ! is_managed_unit "$name"; then
        die "refusing to replace unmanaged user unit: $target"
        return 1
    fi
    rm -f "$target"
    ln -s "$source" "$target"
}

install_shell() {
    mkdir -p "$(dirname "$SHELL_TARGET")"

    if [ -e "$SHELL_TARGET" ] || [ -L "$SHELL_TARGET" ]; then
        if is_managed_shell; then
            rm -f "$SHELL_TARGET"
        else
            die "refusing to replace unmanaged Quickshell configuration: $SHELL_TARGET"
            return 1
        fi
    fi

    ln -s "$SHELL_SOURCE" "$SHELL_TARGET"
}

systemd_available() {
    command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

install() {
    echo "Maho OS V1 setup"
    echo
    preflight || return 1

    echo
    echo "Installing user commands..."
    local name
    for name in "${COMMANDS[@]}"; do
        write_launcher "$name" || return 1
        printf 'PASS  %s\n' "$(launcher_path "$name")"
    done

    echo
    echo "Installing Maho Shell..."
    install_shell || return 1
    echo "PASS  $SHELL_TARGET -> $SHELL_SOURCE"

    echo
    echo "Installing user services..."
    for name in "${UNITS[@]}"; do
        install_unit "$name" || return 1
        echo "PASS  $(unit_target "$name")"
    done

    if systemd_available; then
        systemctl --user daemon-reload
        for name in "${UNITS[@]}"; do
            if [ "$name" = "maho-shell.service" ] && ! command -v quickshell >/dev/null 2>&1; then
                echo "INFO  $name not started because quickshell is unavailable"
                continue
            fi

            if systemctl --user enable --now "$name" >/dev/null 2>&1; then
                echo "PASS  $name enabled and started"
            else
                echo "INFO  $name could not be started now; CLI installation remains valid"
            fi
        done
    else
        echo "INFO  systemd user manager unavailable; service start deferred"
    fi
    echo
    echo "PASS: Maho OS V1 user setup complete"
}

status() {
    local failed=0 name
    echo "Maho OS V1 setup status"
    echo "Repository: $ROOT"
    echo

    for name in "${COMMANDS[@]}"; do
        if is_managed_launcher "$name"; then
            printf 'PASS  command %-24s\n' "$name"
        else
            printf 'INFO  command %-24s not managed by this checkout\n' "$name"
            failed=1
        fi
    done

    if is_managed_shell; then
        echo "PASS  shell   $SHELL_TARGET"
    else
        echo "INFO  shell   $SHELL_TARGET not managed by this checkout"
        failed=1
    fi

    for name in "${UNITS[@]}"; do
        if is_managed_unit "$name"; then
            printf 'PASS  unit    %s\n' "$name"
        else
            printf 'INFO  unit    %s not installed from this checkout\n' "$name"
            failed=1
        fi
    done

    if systemd_available; then
        for name in "${UNITS[@]}"; do
            if systemctl --user is-active --quiet "$name"; then
                printf 'PASS  service %s active\n' "$name"
            else
                printf 'INFO  service %s inactive\n' "$name"
            fi
        done
    else
        echo "INFO  systemd user manager unavailable"
    fi
    return "$failed"
}

uninstall() {
    echo "Maho OS V1 user uninstall"
    local name target path
    if systemd_available; then
        for name in "${UNITS[@]}"; do
            systemctl --user disable --now "$name" >/dev/null 2>&1 || true
        done
    fi

    for name in "${UNITS[@]}"; do
        target="$(unit_target "$name")"
        if is_managed_unit "$name"; then
            rm -f "$target"
            echo "REMOVED  $target"
        elif [ -e "$target" ] || [ -L "$target" ]; then
            echo "KEPT     unmanaged user unit $target"
        fi
    done

    if is_managed_shell; then
        rm -f "$SHELL_TARGET"
        echo "REMOVED  $SHELL_TARGET"
    elif [ -e "$SHELL_TARGET" ] || [ -L "$SHELL_TARGET" ]; then
        echo "KEPT     unmanaged Quickshell configuration $SHELL_TARGET"
    fi

    for name in "${COMMANDS[@]}"; do
        path="$(launcher_path "$name")"
        if is_managed_launcher "$name"; then
            rm -f "$path"
            echo "REMOVED  $path"
        elif [ -e "$path" ] || [ -L "$path" ]; then
            echo "KEPT     unmanaged command $path"
        fi
    done

    systemd_available && systemctl --user daemon-reload >/dev/null 2>&1 || true
    echo "PASS: Maho-managed user wiring removed; user data and unmanaged configuration preserved"
}

case "${1:-}" in
    install) install ;;
    status) status ;;
    uninstall) uninstall ;;
    preflight) preflight ;;
    *)
        cat <<'HELP'
Maho OS V1 user setup

Usage:
  bash bin/maho-setup preflight
  bash bin/maho-setup install
  maho-setup status
  maho-setup uninstall

Setup wires the current checkout into the user session. It installs no system
packages and uses no root access. Existing unmanaged commands, units, and
Quickshell configuration are preserved rather than overwritten.

Maho Shell is installed as the Maho desktop surface when Quickshell is
available. The shell reads Maho's active adaptive palette directly, provides
contextual workspace/audio/brightness feedback, and restores Waybar if the
shell exits unexpectedly.

The Maho security service runs the stateful read-only monitor and
incident-oriented shadow guard; the separate maho-contain command requires a
confirmed finding and explicit user confirmation before reversible user-process
containment.
HELP
        ;;
esac

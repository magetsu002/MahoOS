#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$HOME/.local/bin"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
UNIT_DIR="$CONFIG_HOME/systemd/user"
RUNTIME_ROOT="$DATA_HOME/maho/runtime"
RELEASES="$RUNTIME_ROOT/releases"
CURRENT="$RUNTIME_ROOT/current"
PREVIOUS="$RUNTIME_ROOT/previous"
MARKER="# managed-by: maho-setup v2"
OLD_MARKER="# managed-by: maho-setup v1"
HYPR_REL="config/hypr/maho/core/session.lua"
HYPR_TARGET="$CONFIG_HOME/hypr/maho/core/session.lua"

COMMANDS=(
  mahoctl maho-theme maho-wallpaper maho-wallpaper-session maho-observe
  maho-adapt maho-provenance maho-security maho-security-monitor maho-guard
  maho-contain maho-shell maho-notify maho-link maho-launcher maho-session
  maho-setup
)
CORE_UNITS=(maho-observe.service maho-security.service)
SESSION_UNITS=(maho-awww-daemon.service maho-wallpaper.service maho-shell.service maho-notify.service)
UNITS=("${CORE_UNITS[@]}" "${SESSION_UNITS[@]}" maho-hyprland-session.target)
SHELL_LINK="quickshell/maho-shell:config/quickshell/maho-shell"
NOTIFY_LINK="quickshell/maho-notify:config/quickshell/maho-notify"

die() { echo "maho-setup: $*" >&2; return 1; }
command_path() { printf '%s/%s\n' "$BIN_DIR" "$1"; }
runtime_path() { printf '%s/%s\n' "$CURRENT" "$1"; }
unit_path() { printf '%s/%s\n' "$UNIT_DIR" "$1"; }
link_is() { [ -L "$1" ] && [ "$(readlink -- "$1")" = "$2" ]; }

managed_command() {
  [ -f "$(command_path "$1")" ] &&
    grep -Fq "$MARKER" "$(command_path "$1")" 2>/dev/null
}

legacy_direct_notify() {
  local p="$1" sum
  [ -f "$p" ] || return 1
  sum="$(sha256sum "$p" 2>/dev/null | awk '{print $1}')"
  [ "$sum" = "77d1b10eefb368648ef762b3275b066b5a7c0f554dd543678488ff6686bc5ddf" ]
}

legacy_link_bluetooth() {
  local p="$1"
  [ -f "$p" ] && cmp -s "$p" <(cat <<'EOF_LEGACY_LINK'
#!/usr/bin/env bash
set -euo pipefail

RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/maho-link-bluetooth"

export MAHO_LINK_CONFIG="$RUNTIME/config/quickshell/maho-link/shell.qml"

exec bash "$RUNTIME/bin/maho-link" "$@"
EOF_LEGACY_LINK
)
}

legacy_preview_launcher() {
  local p="$1"
  [ -f "$p" ] || return 1
  grep -Fqx 'RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/maho-launcher-preview"' "$p" 2>/dev/null || return 1
  grep -Fqx 'exec bash "$RUNTIME/bin/maho-launcher" "$@"' "$p" 2>/dev/null
}

safe_command() {
  local name="$1" p
  p="$(command_path "$name")"
  [ ! -e "$p" ] && [ ! -L "$p" ] && return 0
  [ -f "$p" ] || return 1
  grep -Fq "$MARKER" "$p" 2>/dev/null && return 0
  grep -Fq "$OLD_MARKER" "$p" 2>/dev/null && return 0
  [ "$name" = maho-notify ] && legacy_direct_notify "$p" && return 0
  [ "$name" = maho-link ] && legacy_link_bluetooth "$p" && return 0
  [ "$name" = maho-launcher ] && legacy_preview_launcher "$p"
}

managed_unit() { link_is "$(unit_path "$1")" "$(runtime_path "systemd/user/$1")"; }
managed_config() { link_is "$CONFIG_HOME/$1" "$(runtime_path "$2")"; }
managed_hypr() { link_is "$HYPR_TARGET" "$(runtime_path "$HYPR_REL")"; }

legacy_hypr() {
  [ -f "$HYPR_TARGET" ] && [ ! -L "$HYPR_TARGET" ] || return 1
  cmp -s "$HYPR_TARGET" <(cat <<'EOF_LEGACY_HYPR'
-- Own graphical Maho services only while this Hyprland session is alive.

hl.on("hyprland.start", function()
    hl.exec_cmd([["$HOME/.local/bin/maho-session" start]])
    hl.exec_cmd("waybar")
end)

hl.on("hyprland.shutdown", function()
    hl.exec_cmd([["$HOME/.local/bin/maho-session" stop]])
end)
EOF_LEGACY_HYPR
)
}

preflight() {
  local failed=0 n f
  local -a required=(
    config/ownership.json config/intent.json config/adapters.json
    "$HYPR_REL"
    config/quickshell/maho-shell/shell.qml
    config/quickshell/maho-notify/shell.qml
    config/quickshell/maho-launcher/shell.qml
    config/quickshell/maho-link/shell.qml
    lib/maho_launcher_backend.py
    systemd/user/maho-awww-daemon.service
    systemd/user/maho-hyprland-session.target
  )

  for n in "${COMMANDS[@]}"; do
    [ -r "$ROOT/bin/$n" ] || { echo "FAIL source $n"; failed=1; }
  done
  for n in "${UNITS[@]}"; do
    [ -r "$ROOT/systemd/user/$n" ] || { echo "FAIL unit $n"; failed=1; }
  done
  for f in "${required[@]}"; do
    [ -r "$ROOT/$f" ] || { echo "FAIL asset $f"; failed=1; }
  done
  for f in config/ownership.json config/intent.json config/adapters.json; do
    python -m json.tool "$ROOT/$f" >/dev/null 2>&1 || { echo "FAIL json $f"; failed=1; }
  done
  python -m py_compile \
    "$ROOT/lib/security_probe.py" "$ROOT/lib/security_containment.py" \
    "$ROOT/lib/security_incident.py" "$ROOT/lib/security_preflight.py" \
    "$ROOT/lib/security_boundary.py" "$ROOT/lib/maho_launcher_backend.py" \
    "$ROOT/config/quickshell/maho-shell/state.py" \
    "$ROOT/config/quickshell/maho-notify/state.py" >/dev/null 2>&1 ||
    { echo "FAIL python"; failed=1; }
  find "$ROOT/bin" "$ROOT/lib" "$ROOT/adapters" \
    -type f \( -name '*.sh' -o -path '*/bin/*' \) -print0 |
    xargs -0 -r -n1 bash -n || { echo "FAIL shell syntax"; failed=1; }
  [ "$failed" -eq 0 ] && echo "PASS preflight"
  return "$failed"
}

validate_targets() {
  local n p rel src
  for n in "${COMMANDS[@]}"; do
    safe_command "$n" || die "refusing unmanaged command: $(command_path "$n")" || return
  done
  for n in "${UNITS[@]}"; do
    p="$(unit_path "$n")"
    { [ ! -e "$p" ] && [ ! -L "$p" ]; } ||
      link_is "$p" "$(runtime_path "systemd/user/$n")" ||
      { die "refusing unmanaged unit: $p"; return 1; }
  done

  rel="${SHELL_LINK%%:*}"; src="${SHELL_LINK#*:}"; p="$CONFIG_HOME/$rel"
  { [ ! -e "$p" ] && [ ! -L "$p" ]; } ||
    managed_config "$rel" "$src" ||
    { die "refusing unmanaged shell config: $p"; return 1; }

  rel="${NOTIFY_LINK%%:*}"; src="${NOTIFY_LINK#*:}"; p="$CONFIG_HOME/$rel"
  if ! { [ -d "$p" ] && [ ! -L "$p" ]; }; then
    { [ ! -e "$p" ] && [ ! -L "$p" ]; } ||
      managed_config "$rel" "$src" ||
      { die "refusing unmanaged notify config: $p"; return 1; }
  fi

  if [ -e "$HYPR_TARGET" ] || [ -L "$HYPR_TARGET" ]; then
    managed_hypr || legacy_hypr ||
      { die "refusing unrelated Hyprland session hook: $HYPR_TARGET"; return 1; }
  fi
}

build_release() {
  local stage hash final rev dir
  mkdir -p "$RELEASES"
  stage="$RELEASES/.staging-$$"
  mkdir -m 0755 "$stage"
  for dir in bin lib adapters config theme systemd share; do
    [ -e "$ROOT/$dir" ] && cp -a -- "$ROOT/$dir" "$stage/$dir"
  done
  find "$stage" -type d -name __pycache__ -prune -exec rm -rf -- {} +
  find "$stage" -type f \( -name '*.pyc' -o -name '.qmlls.ini' \) -delete
  hash="$(cd "$stage"; find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')"
  final="$RELEASES/$hash"
  if [ -d "$final" ]; then
    rm -rf -- "$stage"
  else
    rev="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf unknown)"
    python - "$stage/manifest.json" "$hash" "$rev" <<'PY'
import datetime,json,pathlib,sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({
 "version":2,"content_sha256":sys.argv[2],"source_revision":sys.argv[3],
 "installed_at":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2,sort_keys=True)+"\n")
PY
    chmod -R u=rwX,go=rX "$stage"
    mv -- "$stage" "$final"
  fi
  printf '%s\n' "$final"
}

atomic_link() {
  local src="$1" dst="$2" tmp
  mkdir -p "$(dirname -- "$dst")"
  tmp="$(dirname -- "$dst")/.maho-link-$$-$(basename -- "$dst")"
  rm -f -- "$tmp"; ln -s -- "$src" "$tmp"
  [ -d "$dst" ] && [ ! -L "$dst" ] &&
    { rm -f -- "$tmp"; die "refusing directory target: $dst"; return 1; }
  mv -Tf -- "$tmp" "$dst"
}

write_command() {
  local n="$1" p tmp
  p="$(command_path "$n")"; mkdir -p "$BIN_DIR"; tmp="$BIN_DIR/.maho-command-$$-$n"
  cat >"$tmp" <<EOF
#!/usr/bin/env bash
$MARKER
MAHO_ROOT="\${XDG_DATA_HOME:-\$HOME/.local/share}/maho/runtime/current"
export MAHO_ROOT
exec bash "\$MAHO_ROOT/bin/$n" "\$@"
EOF
  chmod 0755 "$tmp"; mv -Tf -- "$tmp" "$p"
}

snapshot_one() {
  local tx="$1" manifest="$2" p="$3" key="$4"
  [ -d "$p" ] && [ ! -L "$p" ] && { die "snapshot refuses directory: $p"; return 1; }
  if [ -e "$p" ] || [ -L "$p" ]; then
    cp -a --no-dereference "$p" "$tx/$key"; printf 'p\t%s\t%s\n' "$p" "$key" >>"$manifest"
  else
    printf 'm\t%s\t%s\n' "$p" "$key" >>"$manifest"
  fi
}

snapshot_all() {
  local tx="$1" m="$tx/manifest" i=0 n rel p wants
  mkdir -m 0700 "$tx"; : >"$m"
  for n in "${COMMANDS[@]}"; do i=$((i+1)); snapshot_one "$tx" "$m" "$(command_path "$n")" "$i"; done
  rel="${SHELL_LINK%%:*}"; i=$((i+1)); snapshot_one "$tx" "$m" "$CONFIG_HOME/$rel" "$i"
  rel="${NOTIFY_LINK%%:*}"; p="$CONFIG_HOME/$rel"
  if ! { [ -d "$p" ] && [ ! -L "$p" ]; }; then i=$((i+1)); snapshot_one "$tx" "$m" "$p" "$i"; fi
  i=$((i+1)); snapshot_one "$tx" "$m" "$HYPR_TARGET" "$i"
  for n in "${UNITS[@]}"; do i=$((i+1)); snapshot_one "$tx" "$m" "$(unit_path "$n")" "$i"; done
  for n in "${CORE_UNITS[@]}" "${SESSION_UNITS[@]}"; do
    for wants in default.target.wants graphical-session.target.wants; do
      i=$((i+1)); snapshot_one "$tx" "$m" "$UNIT_DIR/$wants/$n" "$i"
    done
  done
  i=$((i+1)); snapshot_one "$tx" "$m" "$PREVIOUS" "$i"
}

restore_all() {
  local tx="$1" state p key
  [ -f "$tx/manifest" ] || return 0
  while IFS=$'\t' read -r state p key; do
    [ -d "$p" ] && [ ! -L "$p" ] && continue
    rm -f -- "$p"
    [ "$state" = p ] && { mkdir -p "$(dirname -- "$p")"; cp -a --no-dereference "$tx/$key" "$p"; }
  done <"$tx/manifest"
}

wire_runtime() {
  local n rel src p
  for n in "${COMMANDS[@]}"; do write_command "$n"; done
  rel="${SHELL_LINK%%:*}"; src="${SHELL_LINK#*:}"
  atomic_link "$(runtime_path "$src")" "$CONFIG_HOME/$rel"
  rel="${NOTIFY_LINK%%:*}"; src="${NOTIFY_LINK#*:}"; p="$CONFIG_HOME/$rel"
  if [ -d "$p" ] && [ ! -L "$p" ]; then
    echo "INFO preserving live-owned directory $p"
  else
    atomic_link "$(runtime_path "$src")" "$p"
  fi
  atomic_link "$(runtime_path "$HYPR_REL")" "$HYPR_TARGET"
  for n in "${UNITS[@]}"; do atomic_link "$(runtime_path "systemd/user/$n")" "$(unit_path "$n")"; done
}

systemd_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

wire_ownership() {
  local n
  mkdir -p "$UNIT_DIR/default.target.wants" "$UNIT_DIR/graphical-session.target.wants"
  for n in "${CORE_UNITS[@]}"; do
    rm -f -- "$UNIT_DIR/graphical-session.target.wants/$n"
    atomic_link "$UNIT_DIR/$n" "$UNIT_DIR/default.target.wants/$n"
  done
  for n in "${SESSION_UNITS[@]}"; do
    rm -f -- "$UNIT_DIR/default.target.wants/$n"
    atomic_link "$UNIT_DIR/$n" "$UNIT_DIR/graphical-session.target.wants/$n"
  done
  systemctl --user daemon-reload
}

install_runtime() (
  set -e
  local release old="" tx committed=0 rc
  preflight
  validate_targets
  release="$(build_release)"
  [ -L "$CURRENT" ] && old="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  tx="$RUNTIME_ROOT/.transaction-$$"; snapshot_all "$tx"

  rollback_exit() {
    rc=$?
    [ "$committed" -eq 1 ] && return "$rc"
    set +e
    if [ -n "$old" ] && [ -d "$old" ]; then atomic_link "$old" "$CURRENT" >/dev/null 2>&1; else rm -f -- "$CURRENT"; fi
    restore_all "$tx"
    systemd_available && systemctl --user daemon-reload >/dev/null 2>&1 || true
    rm -rf -- "$tx"
    return "$rc"
  }
  trap rollback_exit EXIT

  [ -n "$old" ] && [ "$old" != "$release" ] && atomic_link "$old" "$PREVIOUS"
  atomic_link "$release" "$CURRENT"
  wire_runtime
  if systemd_available; then
    wire_ownership
  else
    echo "INFO systemd user manager unavailable; activation links deferred"
  fi

  committed=1; rm -rf -- "$tx"; trap - EXIT
  echo "PASS runtime $CURRENT -> $release"
  echo "INFO running graphical services were not restarted"
)

status() {
  local failed=0 n rel src p
  [ -L "$CURRENT" ] && [ -d "$CURRENT" ] || { echo "FAIL runtime current"; failed=1; }
  for n in "${COMMANDS[@]}"; do managed_command "$n" || { echo "FAIL command $n"; failed=1; }; done
  for n in "${UNITS[@]}"; do managed_unit "$n" || { echo "FAIL unit $n"; failed=1; }; done
  rel="${SHELL_LINK%%:*}"; src="${SHELL_LINK#*:}"; managed_config "$rel" "$src" || { echo "FAIL shell config"; failed=1; }
  rel="${NOTIFY_LINK%%:*}"; src="${NOTIFY_LINK#*:}"; p="$CONFIG_HOME/$rel"
  managed_config "$rel" "$src" || { [ -d "$p" ] && [ ! -L "$p" ]; } || { echo "FAIL notify config"; failed=1; }
  managed_hypr || { echo "FAIL Hyprland session hook"; failed=1; }
  return "$failed"
}

rollback() {
  local prev cur
  [ -L "$PREVIOUS" ] || { die "no previous release"; return 1; }
  prev="$(readlink -f -- "$PREVIOUS")"; [ -d "$prev" ] || { die "previous release missing"; return 1; }
  cur="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  atomic_link "$prev" "$CURRENT"
  [ -n "$cur" ] && [ -d "$cur" ] && atomic_link "$cur" "$PREVIOUS"
  systemd_available && systemctl --user daemon-reload || true
  echo "PASS rolled back to $prev"
  echo "INFO running graphical services were not restarted"
}

uninstall() {
  local n rel src p wants

  for n in "${CORE_UNITS[@]}" "${SESSION_UNITS[@]}"; do
    for wants in default.target.wants graphical-session.target.wants; do
      p="$UNIT_DIR/$wants/$n"
      link_is "$p" "$UNIT_DIR/$n" && rm -f -- "$p" || true
    done
  done

  for n in "${UNITS[@]}"; do
    p="$(unit_path "$n")"
    managed_unit "$n" && rm -f -- "$p" || true
  done

  rel="${SHELL_LINK%%:*}"; src="${SHELL_LINK#*:}"
  managed_config "$rel" "$src" && rm -f -- "$CONFIG_HOME/$rel" || true

  rel="${NOTIFY_LINK%%:*}"; src="${NOTIFY_LINK#*:}"
  managed_config "$rel" "$src" && rm -f -- "$CONFIG_HOME/$rel" || true

  managed_hypr && rm -f -- "$HYPR_TARGET" || true

  for n in "${COMMANDS[@]}"; do
    managed_command "$n" && rm -f -- "$(command_path "$n")" || true
  done

  systemd_available && systemctl --user daemon-reload || true
  echo "PASS runtime wiring removed; releases and user-owned configuration preserved"
}

case "${1:-}" in
  install)
    shift
    case "${1:-}" in
      ""|--adopt-live) ;;
      *) die "unknown install option: $1"; exit 2 ;;
    esac
    install_runtime
    ;;
  preflight) preflight ;;
  status) status ;;
  rollback) rollback ;;
  uninstall) uninstall ;;
  *)
    cat <<'HELP'
Maho OS durable runtime setup

Usage:
  bash bin/maho-setup preflight
  bash bin/maho-setup install [--adopt-live]
  maho-setup status
  maho-setup rollback
  maho-setup uninstall

Install validates every live target before mutation, builds an immutable release,
atomically switches runtime/current, and wires commands and user units through
that stable path. Existing real Maho Notify directories are preserved. Normal
Hyprland startup owns graphical services; Waybar remains emergency fallback only.

--adopt-live is retained for command-line compatibility but does not bypass
validation: only recognized Maho-managed legacy wiring may be migrated.
HELP
    ;;
esac
#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="$HOME/.local/bin"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
UNIT_DIR="$CONFIG_HOME/systemd/user"
RUNTIME_ROOT="$DATA_HOME/maho/runtime"
RELEASES="$RUNTIME_ROOT/releases"
CURRENT="$RUNTIME_ROOT/current"
PREVIOUS="$RUNTIME_ROOT/previous"
GUARDIAN_STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/maho/security"
RUNTIME_RECOVERY_ENGINE="$ROOT/lib/guardian_runtime_recovery.py"
RUNTIME_RELEASE_VERIFIER="$ROOT/lib/maho_runtime_release.py"
RUNTIME_DEPLOYMENT_PLANNER="$ROOT/lib/maho_runtime_deployment.py"
MARKER="# managed-by: maho-setup v3"
V2_MARKER="# managed-by: maho-setup v2"
V1_MARKER="# managed-by: maho-setup v1"
HYPR_REL="config/hypr/maho/core/session.lua"
HYPR_TARGET="$CONFIG_HOME/hypr/maho/core/session.lua"
HYPR_MANAGED_RELS=(
  config/hypr/hyprland.lua
  config/hypr/maho/core/windowing.lua
  config/hypr/maho/core/input.lua
  config/hypr/maho/core/binds.lua
  config/hypr/maho/core/session.lua
  config/hypr/maho/appearance/decorations.lua
  config/hypr/maho/appearance/animations.lua
  config/hypr/maho/theme/fallback.lua
  config/hypr/maho/theme/palette.lua
)
SHELL_SOURCE_REL="config/quickshell/maho-shell"
SHELL_TARGET="$CONFIG_HOME/quickshell/maho-shell"
NOTIFY_LEGACY_TARGET="$CONFIG_HOME/quickshell/maho-notify"
FILES_DESKTOP_REL="apps/maho-files/io.maho.Files.desktop"
FILES_DESKTOP_TARGET="$DATA_HOME/applications/io.maho.Files.desktop"
VESKTOP_WRAPPER="$BIN_DIR/vesktop-guard"
VESKTOP_DESKTOP_TARGET="$DATA_HOME/applications/vesktop.desktop"
MIMEAPPS_TARGET="$CONFIG_HOME/mimeapps.list"

COMMANDS=(
  maho mahoctl maho-theme maho-wallpaper maho-wallpaper-session maho-observe
  maho-adapt maho-adaptive maho-provenance maho-security maho-security-monitor maho-guard maho-guardian-watch
  maho-contain maho-shell maho-notify maho-session maho-launcher maho-dock maho-kbdlight
  maho-files maho-link maho-lock maho-power maho-update maho-clipboard maho-trust maho-firewall maho-firewall-certify maho-memory-certify
  maho-clipboard-history maho-lock-sddm-install maho-platform-install maho-storage-health maho-generation-gc maho-aur-build maho-guardian-runtime-recovery-certify
  maho-vesktop-guard maho-vesktop-install maho-setup
)
CORE_UNITS=(maho-observe.service maho-security.service maho-guardian.service)
STARTUP_UNITS=(maho-kbdlight.service)
PASSIVE_UNITS=()
GRAPHICAL_UNITS=(
  maho-awww-daemon.service
  maho-wallpaper.service
  maho-shell.service
  maho-dock.service
  maho-notify.service
  maho-clipboard-history.service
  maho-adaptive.service
)
SESSION_TARGET_UNIT=maho-hyprland-session.target
UNITS=("${CORE_UNITS[@]}" "${STARTUP_UNITS[@]}" "${GRAPHICAL_UNITS[@]}" "${PASSIVE_UNITS[@]}" "$SESSION_TARGET_UNIT")

die() { echo "maho-setup: $*" >&2; return 1; }
command_path() { printf '%s/%s\n' "$BIN_DIR" "$1"; }
runtime_path() { printf '%s/%s\n' "$CURRENT" "$1"; }
unit_path() { printf '%s/%s\n' "$UNIT_DIR" "$1"; }
link_is() { [ -L "$1" ] && [ "$(readlink -- "$1")" = "$2" ]; }
sha_is() {
  local path="$1" expected="$2" actual
  [ -f "$path" ] || return 1
  actual="$(sha256sum "$path" 2>/dev/null | awk '{print $1}')"
  [ "$actual" = "$expected" ]
}
python_parse_only() {
  python - "$@" <<'PY'
import ast
import pathlib
import sys

for raw in sys.argv[1:]:
    path = pathlib.Path(raw)
    ast.parse(path.read_text(), filename=str(path))
PY
}
release_source_revision() {
  local metadata="$ROOT/share/maho/release.json" revision
  if [ -r "$metadata" ]; then
    revision="$(python - "$metadata" <<'PY'
import json
import pathlib
import sys

value = json.loads(pathlib.Path(sys.argv[1]).read_text()).get("source_revision")
if not isinstance(value, str) or not value.strip():
    raise SystemExit(1)
print(value.strip())
PY
)" || return 1
    printf '%s\n' "$revision"
    return 0
  fi
  git -C "$ROOT" rev-parse HEAD 2>/dev/null || printf 'unknown\n'
}

managed_command() {
  local path; path="$(command_path "$1")"
  [ -f "$path" ] && grep -Fq "$MARKER" "$path" 2>/dev/null
}
legacy_runtime_wrapper() {
  local path="$1"
  [ -f "$path" ] || return 1
  grep -Fq "$V2_MARKER" "$path" 2>/dev/null || grep -Fq "$V1_MARKER" "$path" 2>/dev/null
}
legacy_direct_notify() {
  local path="$1"
  sha_is "$path" "77d1b10eefb368648ef762b3275b066b5a7c0f554dd543678488ff6686bc5ddf" || cmp -s "$path" "$ROOT/bin/maho-notify"
}
legacy_link() {
  local path="$1"
  sha_is "$path" "0ce5327f5b027c6cce51b667dc9e1e8468fd5d9fd946ed7908095c09e496db4c" && return 0
  sha_is "$path" "0f366321f351059e9600591008c4bce22d194377e68bc6e4d149af10166729a3" && return 0
  [ -f "$path" ] || return 1
  { grep -Fqx '# managed-by: maho-link-final-motion' "$path" && grep -Fqx 'exec "$HOME/.local/share/maho-link/current/bin/maho-link" "$@"' "$path"; } ||
  { grep -Fqx 'RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/maho-link-bluetooth"' "$path" && grep -Fqx 'exec bash "$RUNTIME/bin/maho-link" "$@"' "$path"; }
}
legacy_launcher() {
  local path="$1"
  sha_is "$path" "5de3a0a3bb4a3e298fd7555d53d81c05f3f7c720a86b3dcbef70805da369cf78" && return 0
  [ -f "$path" ] || return 1
  { grep -Fqx 'RUNTIME="/home/magetsu/.local/share/maho-ux-cleanup-aafda5fd8843eb7bb06eeb51d25b8662dfd55252"' "$path" && grep -Fqx 'exec bash "$RUNTIME/bin/maho-launcher" "$@"' "$path"; } ||
  { grep -Fqx 'RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/maho-launcher-preview"' "$path" && grep -Fqx 'exec bash "$RUNTIME/bin/maho-launcher" "$@"' "$path"; }
}
legacy_dock() {
  local path="$1"
  sha_is "$path" "bb8e9b2b8ddf0a9974ed7684cb34723c2a8662ce3594672b6ac2c19a963ed579" && return 0
  [ -f "$path" ] || return 1
  grep -Fqx 'RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/maho-dock"' "$path" &&
  grep -Fqx 'export MAHO_DOCK_CONFIG="$RUNTIME/config/quickshell/maho-shell/dock-shell.qml"' "$path" &&
  grep -Fqx 'export MAHO_APP_MODEL="$RUNTIME/lib/maho_app_model.py"' "$path"
}
legacy_files() {
  local path="$1"
  sha_is "$path" "a9050ebb1ef2f3838260b855ac86f1bac3ff63eb079d333cf820b6e656d7c61b" && return 0
  [ -f "$path" ] || return 1
  grep -Fqx 'RUNTIME="$HOME/.local/share/maho-files"' "$path" && grep -Fqx 'SOURCE="$RUNTIME/source"' "$path" && grep -Fqx 'APP="$RUNTIME/bin/maho-files-app"' "$path"
}
legacy_lock() {
  local path="$1"
  sha_is "$path" "e50019c819531c828415a92431f55f88dcaf2339706f8df25e16af0e8e164adc" && return 0
  [ -f "$path" ] || return 1
  grep -Fqx '# managed-by: maho-lock-install v1' "$path" && grep -Fq '/.local/share/maho-lock/current/bin/maho-lock' "$path"
}
legacy_power() {
  local path="$1"
  sha_is "$path" "110fae05d2875e6552d0add83252df094e33e4a7246106abce832724808fbf8d" && return 0
  [ -f "$path" ] || return 1
  grep -Fqx '# managed-by: maho-power-install v1' "$path" && grep -Fq '/.local/share/maho-power/current/bin/maho-power' "$path"
}
legacy_clipboard() {
  local path="$1"
  sha_is "$path" "875615a7ba3654826e54372ece70296580dd0afa2ad0f67feb445f29c2165e03" && return 0
  [ -f "$path" ] || return 1
  grep -Fqx 'RUNTIME="/home/magetsu/.local/share/maho-ux-cleanup-aafda5fd8843eb7bb06eeb51d25b8662dfd55252"' "$path" && grep -Fqx 'exec bash "$RUNTIME/bin/maho-clipboard" "$@"' "$path"
}
legacy_clipboard_history() {
  local path="$1"
  sha_is "$path" "528f9e8105af185b6bf9a0299b8538ac7b6db94082c6d2e3a8d1cd3fff4155a5" || cmp -s "$path" "$ROOT/bin/maho-clipboard-history"
}
legacy_kbdlight() {
  local path="$1"
  [ -f "$path" ] && [ ! -L "$path" ] && cmp -s "$path" "$ROOT/bin/maho-kbdlight"
}

safe_command() {
  local name="$1" path; path="$(command_path "$name")"
  [ ! -e "$path" ] && [ ! -L "$path" ] && return 0
  [ -f "$path" ] || return 1
  managed_command "$name" && return 0
  legacy_runtime_wrapper "$path" && return 0
  case "$name" in
    maho-notify) legacy_direct_notify "$path" ;;
    maho-link) legacy_link "$path" ;;
    maho-launcher) legacy_launcher "$path" ;;
    maho-dock) legacy_dock "$path" ;;
    maho-files) legacy_files "$path" ;;
    maho-lock) legacy_lock "$path" ;;
    maho-power) legacy_power "$path" ;;
    maho-clipboard) legacy_clipboard "$path" ;;
    maho-clipboard-history) legacy_clipboard_history "$path" ;;
    maho-kbdlight) legacy_kbdlight "$path" ;;
    *) return 1 ;;
  esac
}

managed_unit() { link_is "$(unit_path "$1")" "$(runtime_path "systemd/user/$1")"; }
legacy_dock_unit() {
  local path="$1"
  sha_is "$path" "d4649dfbc02dfa4b1929096fc3c88da12f40719ce5b7c44faa9fa33fc0a6e0f6" && return 0
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  grep -Fq 'ExecStart=%h/.local/bin/maho-dock run' "$path" && grep -Fq 'WantedBy=default.target' "$path"
}
legacy_clipboard_history_unit() {
  local path="$1"
  sha_is "$path" "3e69d839a1c1f6131e5ee88d6cdb86cd568915585cbffde162c95211caac696b" && return 0
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  grep -Fq 'PartOf=graphical-session.target' "$path" && grep -Fq 'ExecStart=%h/.local/bin/maho-clipboard-history serve' "$path" && grep -Fq 'WantedBy=default.target' "$path"
}
legacy_kbdlight_unit() {
  local path="$1"
  [ -f "$path" ] && [ ! -L "$path" ] && cmp -s "$path" "$ROOT/systemd/user/maho-kbdlight.service"
}
safe_unit() {
  local name="$1" path; path="$(unit_path "$name")"
  [ ! -e "$path" ] && [ ! -L "$path" ] && return 0
  managed_unit "$name" && return 0
  case "$name" in
    maho-dock.service) legacy_dock_unit "$path" ;;
    maho-clipboard-history.service) legacy_clipboard_history_unit "$path" ;;
    maho-kbdlight.service) legacy_kbdlight_unit "$path" ;;
    *) return 1 ;;
  esac
}

managed_shell() { link_is "$SHELL_TARGET" "$(runtime_path "$SHELL_SOURCE_REL")"; }
hypr_target_for() { printf '%s/hypr/%s\n' "$CONFIG_HOME" "${1#config/hypr/}"; }
managed_hypr_file() { local rel="$1"; link_is "$(hypr_target_for "$rel")" "$(runtime_path "$rel")"; }
managed_hypr() { local rel; for rel in "${HYPR_MANAGED_RELS[@]}"; do managed_hypr_file "$rel" || return 1; done; }
legacy_hypr_managed_file() {
  local rel="$1" path="$2"
  case "$rel" in
    config/hypr/hyprland.lua) sha_is "$path" "57c4619bb553255847e2e8631afd9a19607f16b8b570e4ea4ffb22370a06ef74" ;;
    config/hypr/maho/core/binds.lua) sha_is "$path" "dad453a111eeae0cd45f3d392fb37ac8e1d9f25b286685b84ccd94f15d487a68" ;;
    config/hypr/maho/appearance/decorations.lua) sha_is "$path" "0ae4e081431a8c5fb08051e3ad602aa6776a7284c48d9de4273c8f3aaefc409b" ;;
    *) return 1 ;;
  esac
}
safe_hypr_file() {
  local rel="$1" path
  path="$(hypr_target_for "$rel")"
  [ ! -e "$path" ] && [ ! -L "$path" ] && return 0
  managed_hypr_file "$rel" && return 0
  [ -f "$path" ] && [ ! -L "$path" ] && cmp -s "$path" "$ROOT/$rel" && return 0
  [ -f "$path" ] && [ ! -L "$path" ] && [ -r "$(runtime_path "$rel")" ] && cmp -s "$path" "$(runtime_path "$rel")" && return 0
  [ -f "$path" ] && [ ! -L "$path" ] && legacy_hypr_managed_file "$rel" "$path" && return 0
  [ "$rel" = "$HYPR_REL" ] && legacy_hypr && return 0
  return 1
}
legacy_hypr() {
  [ -f "$HYPR_TARGET" ] && [ ! -L "$HYPR_TARGET" ] || return 1
  sha_is "$HYPR_TARGET" "e792a37a0f8189302ef21a60afc52744eb86c5bae312525ac414540b911e2d15" && return 0
  cmp -s "$HYPR_TARGET" <(cat <<'EOF_LEGACY_HYPR'
-- Own graphical Maho services only while this Hyprland session is alive.

hl.on("hyprland.start", function()
    hl.exec_cmd([["$HOME/.local/bin/maho-session" start]])
    hl.exec_cmd("waybar")
end)

hl.on("hyprland.shutdown", function()
    hl.exec_cmd([["$HOME/.local/bin/maho-session" stop]])
end)
EOF_LEGACY_HYPR
)
}
render_files_desktop() {
  awk -v command="$(command_path maho-files)" '
    /^Exec=/ { print "Exec=" command " run %U"; next }
    { print }
  ' "$ROOT/$FILES_DESKTOP_REL"
}
generated_files_desktop() {
  [ -f "$FILES_DESKTOP_TARGET" ] && [ ! -L "$FILES_DESKTOP_TARGET" ] &&
    cmp -s "$FILES_DESKTOP_TARGET" <(render_files_desktop)
}
managed_files_desktop() {
  link_is "$FILES_DESKTOP_TARGET" "$(runtime_path "$FILES_DESKTOP_REL")" || generated_files_desktop
}
legacy_files_desktop() {
  [ -f "$FILES_DESKTOP_TARGET" ] && [ ! -L "$FILES_DESKTOP_TARGET" ] || return 1
  sha_is "$FILES_DESKTOP_TARGET" "9bd5d1b54d6217fc0912ba78dd482abf4cb248f2f0dc001f975d367b1071b83a" || cmp -s "$FILES_DESKTOP_TARGET" "$ROOT/$FILES_DESKTOP_REL"
}

report_capability() {
  if command -v "$1" >/dev/null 2>&1; then printf 'PASS  capability %-14s\n' "$1"; else printf 'INFO  capability %-14s unavailable\n' "$1"; fi
}
preflight() {
  local failed=0 name file
  local -a required=(
    config/ownership.json config/intent.json config/adapters.json "${HYPR_MANAGED_RELS[@]}"
    config/quickshell/maho-shell/shell.qml config/quickshell/maho-notify/shell.qml
    config/quickshell/maho-launcher/shell.qml config/quickshell/maho-link/shell.qml
    config/quickshell/maho-lock/shell.qml config/quickshell/maho-power/shell.qml
    config/quickshell/maho-clipboard/shell.qml "$FILES_DESKTOP_REL"
    apps/maho-files/CMakeLists.txt lib/maho_app_model.py lib/maho_launcher_backend.py
  )
  for name in "${COMMANDS[@]}"; do [ -r "$ROOT/bin/$name" ] || { echo "FAIL  source $name"; failed=1; }; done
  for name in "${UNITS[@]}"; do [ -r "$ROOT/systemd/user/$name" ] || { echo "FAIL  unit $name"; failed=1; }; done
  for file in "${required[@]}"; do [ -r "$ROOT/$file" ] || { echo "FAIL  asset $file"; failed=1; }; done
  for file in config/ownership.json config/intent.json config/adapters.json; do python -m json.tool "$ROOT/$file" >/dev/null 2>&1 || { echo "FAIL  json $file"; failed=1; }; done
  if [ -r "$ROOT/share/maho/release.json" ]; then
    python -m json.tool "$ROOT/share/maho/release.json" >/dev/null 2>&1 && release_source_revision >/dev/null || { echo "FAIL  release metadata"; failed=1; }
  fi
  python_parse_only \
    "$ROOT/lib/security_probe.py" "$ROOT/lib/security_containment.py" "$ROOT/lib/security_incident.py" \
    "$ROOT/lib/security_preflight.py" "$ROOT/lib/security_boundary.py" "$ROOT/lib/maho_app_model.py" \
    "$ROOT/lib/guardian_incident.py" "$ROOT/lib/guardian_explain.py" \
    "$ROOT/lib/guardian_service_incident.py" "$ROOT/lib/guardian_service_watcher.py" \
    "$ROOT/lib/guardian_session_incident.py" "$ROOT/lib/guardian_runtime_recovery.py" \
    "$ROOT/lib/maho_trust_identity.py" "$ROOT/lib/maho_generation_v2.py" \
    "$ROOT/lib/maho_kernel_generation.py" "$ROOT/lib/guardian_offline_recovery.py" \
    "$ROOT/lib/maho_live_generation.py" \
    "$ROOT/lib/guardian_admission.py" "$ROOT/lib/guardian_native_admission.py" \
    "$ROOT/lib/guardian_revocation.py" "$ROOT/lib/guardian_revocation_recovery.py" \
    "$ROOT/lib/guardian_trust_status.py" \
    "$ROOT/lib/guardian_evidence.py" "$ROOT/lib/guardian_intent.py" \
    "$ROOT/lib/guardian_world_state.py" "$ROOT/lib/guardian_provider_state.py" \
    "$ROOT/lib/guardian_journal_stream.py" "$ROOT/lib/guardian_live_state.py" \
    "$ROOT/lib/guardian_prevention.py" "$ROOT/lib/maho_prevention_scope.py" \
    "$ROOT/lib/maho_prevention_policy.py" "$ROOT/lib/maho_mutation_authority.py" \
    "$ROOT/lib/maho_process_control.py" "$ROOT/lib/maho_prevention_kernel.py" \
    "$ROOT/lib/maho_intent_guard.py" "$ROOT/lib/maho_break_glass.py" \
    "$ROOT/lib/guardian_live_cli.py" "$ROOT/lib/guardian_signed_boot_provider.py" \
    "$ROOT/lib/maho_runtime_release.py" "$ROOT/lib/maho_runtime_deployment.py" \
    "$ROOT/lib/maho_update_state.py" "$ROOT/lib/maho_update_discovery.py" \
    "$ROOT/lib/maho_update_staging.py" "$ROOT/lib/maho_update_preparation.py" \
    "$ROOT/lib/maho_update_maintenance.py" "$ROOT/lib/maho_update_transaction.py" \
    "$ROOT/lib/maho_update_receipts.py" "$ROOT/lib/maho_update_cli.py" \
    "$ROOT/lib/maho_update_admission.py" \
    "$ROOT/lib/maho_boot_authority.py" "$ROOT/lib/maho_secure_boot.py" "$ROOT/lib/maho_behavior_preferences.py" "$ROOT/lib/maho_system_status.py" "$ROOT/lib/maho_system_tui.py" "$ROOT/lib/maho_system_cli.py" "$ROOT/lib/maho_tui.py" \
    "$ROOT/lib/guardian_update.py" "$ROOT/lib/maho_platform_install.py" "$ROOT"/lib/maho_adaptive_*.py \
    "$ROOT/lib/maho_launcher_backend.py" "$ROOT/lib/maho_vesktop_patch.py" \
    "$ROOT/config/quickshell/maho-shell/state.py" \
    "$ROOT/config/quickshell/maho-notify/state.py" "$ROOT/config/quickshell/maho-link/position.py" \
    >/dev/null 2>&1 || { echo "FAIL  python modules"; failed=1; }
  for name in "${COMMANDS[@]}"; do bash -n "$ROOT/bin/$name" >/dev/null 2>&1 || { echo "FAIL  shell syntax $name"; failed=1; }; done
  bash -n "$ROOT/lib/authority.sh" "$ROOT/lib/intent.sh" "$ROOT/lib/state.sh" "$ROOT/lib/events.sh" \
    "$ROOT/lib/decision.sh" "$ROOT/lib/policy.sh" "$ROOT/lib/cycle.sh" "$ROOT/lib/transaction.sh" \
    "$ROOT/adapters/appearance/wallpaper-theme.sh" \
    "$ROOT/adapters/notifications/adaptive-quiet.sh" \
    "$ROOT/adapters/updates/adaptive-maintenance-veto.sh" >/dev/null 2>&1 || { echo "FAIL  shared shell syntax"; failed=1; }
  [ "$failed" -eq 0 ] && echo "PASS  preflight"
  for name in journalctl quickshell awww-daemon brightnessctl wpctl nmcli bluetoothctl wl-paste wl-copy cliphist cmake ninja; do report_capability "$name"; done
  return "$failed"
}

validate_targets() {
  local name path
  for name in "${COMMANDS[@]}"; do safe_command "$name" || die "refusing unmanaged command: $(command_path "$name")" || return 1; done
  for name in "${UNITS[@]}"; do safe_unit "$name" || die "refusing unmanaged unit: $(unit_path "$name")" || return 1; done
  if [ -e "$SHELL_TARGET" ] || [ -L "$SHELL_TARGET" ]; then managed_shell || { die "refusing unmanaged shell config: $SHELL_TARGET"; return 1; }; fi
  for path in "${HYPR_MANAGED_RELS[@]}"; do safe_hypr_file "$path" || { die "refusing unmanaged Maho Hyprland config: $(hypr_target_for "$path")"; return 1; }; done
  if [ -e "$FILES_DESKTOP_TARGET" ] || [ -L "$FILES_DESKTOP_TARGET" ]; then managed_files_desktop || legacy_files_desktop || { die "refusing unmanaged Maho Files desktop entry: $FILES_DESKTOP_TARGET"; return 1; }; fi
  path="$NOTIFY_LEGACY_TARGET"
  if [ -L "$path" ]; then echo "INFO  legacy Notify config link left untouched: $path"; elif [ -d "$path" ]; then echo "INFO  preserving live-owned Notify config directory: $path"; fi
}

build_release() {
  local stage hash final revision provenance dir native_build source_key
  mkdir -p "$RELEASES"; stage="$RELEASES/.staging-$$"; mkdir -m 0755 "$stage"
  for dir in bin lib adapters config theme systemd share apps; do [ -e "$ROOT/$dir" ] && cp -a -- "$ROOT/$dir" "$stage/$dir"; done
  find "$stage" -type d -name __pycache__ -prune -exec rm -rf -- {} +
  find "$stage" -type f \( -name '*.pyc' -o -name '*.pyo' -o -name '.qmlls.ini' \) -delete

  if [ ! -x "$stage/apps/maho-files/prebuilt/maho-files" ]; then
    source_key="$(printf '%s\n' "$ROOT/apps/maho-files" | sha256sum | awk '{print $1}')"
    native_build="${XDG_CACHE_HOME:-$HOME/.cache}/maho/files-release-build-$source_key"
    if ! cmake -S "$ROOT/apps/maho-files" -B "$native_build" -G Ninja -DCMAKE_BUILD_TYPE=Release >&2 ||
       ! cmake --build "$native_build" --parallel >&2; then
      rm -rf -- "$stage"
      die "could not build the native Maho Files release artifact"
      return 1
    fi
    mkdir -p "$stage/apps/maho-files/prebuilt"
    install -m 0755 "$native_build/maho-files" "$stage/apps/maho-files/prebuilt/maho-files"
  fi

  MAHO_ROOT="$stage" "$stage/bin/maho-files" run --source-fingerprint >/dev/null || {
    rm -rf -- "$stage"
    die "native Maho Files artifact does not match staged runtime source"
    return 1
  }

  revision="$(release_source_revision)"
  mkdir -p "$stage/share/maho"
  provenance="$stage/share/maho/runtime-source-revision"
  printf '%s\n' "$revision" >"$provenance"
  python - "$stage/share/maho/runtime-deployment.json" "$DEPLOYMENT_CLASS" "$SOURCE_DIRTY" "$TRUST_ELIGIBLE" <<'PY_DEPLOYMENT_METADATA'
import json
import pathlib
import sys

pathlib.Path(sys.argv[1]).write_text(json.dumps({
    "version": 1,
    "deployment_class": sys.argv[2],
    "source_dirty": sys.argv[3] == "true",
    "trust_eligible": sys.argv[4] == "true",
}, indent=2, sort_keys=True) + "\n")
PY_DEPLOYMENT_METADATA

  hash="$(cd "$stage"; find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '{print $1}')"
  final="$RELEASES/$hash"

  if [ -d "$final" ]; then
    python - "$final/manifest.json" "$final/share/maho/runtime-source-revision" "$hash" "$revision" <<'PY_EXISTING_RELEASE'
import json
import pathlib
import sys

manifest_path = pathlib.Path(sys.argv[1])
provenance_path = pathlib.Path(sys.argv[2])
expected_hash = sys.argv[3]
expected_revision = sys.argv[4]

manifest = json.loads(manifest_path.read_text())
provenance = provenance_path.read_text().strip()

assert manifest.get("version") == 3
assert manifest.get("content_sha256") == expected_hash
assert manifest.get("source_revision") == expected_revision
assert provenance == expected_revision
PY_EXISTING_RELEASE

    existing_hash="$(
      cd "$final"
      find . -type f ! -path './manifest.json' -print0 |
        sort -z |
        xargs -0 sha256sum |
        sha256sum |
        awk '{print $1}'
    )"

    [ "$existing_hash" = "$hash" ] || {
      rm -rf -- "$stage"
      die "existing immutable release payload does not match its content identity: $final"
      return 1
    }

    if find "$final" -perm /222 -print -quit | grep -q .; then
      rm -rf -- "$stage"
      die "existing immutable release contains writable paths: $final"
      return 1
    fi

    rm -rf -- "$stage"
  else
    python - "$stage/manifest.json" "$hash" "$revision" "$DEPLOYMENT_CLASS" "$SOURCE_DIRTY" "$TRUST_ELIGIBLE" <<'PY_NEW_RELEASE'
import datetime
import json
import pathlib
import sys

pathlib.Path(sys.argv[1]).write_text(json.dumps({
    "version": 3,
    "content_sha256": sys.argv[2],
    "source_revision": sys.argv[3],
    "deployment_class": sys.argv[4],
    "source_dirty": sys.argv[5] == "true",
    "trust_eligible": sys.argv[6] == "true",
    "installed_at": datetime.datetime.now(
        datetime.timezone.utc
    ).isoformat()
}, indent=2, sort_keys=True) + "\n")
PY_NEW_RELEASE

    chmod -R a-w,u+rX,go+rX "$stage"
    mv -- "$stage" "$final"
  fi

  printf '%s\n' "$final"
}

atomic_link() {
  local source="$1" target="$2" tmp
  mkdir -p "$(dirname -- "$target")"; tmp="$(dirname -- "$target")/.maho-link-$$-$(basename -- "$target")"
  rm -f -- "$tmp"; ln -s -- "$source" "$tmp"
  if [ -d "$target" ] && [ ! -L "$target" ]; then rm -f -- "$tmp"; die "refusing directory target: $target"; return 1; fi
  mv -Tf -- "$tmp" "$target"
}
write_command() {
  local name="$1" path tmp; path="$(command_path "$name")"; mkdir -p "$BIN_DIR"; tmp="$BIN_DIR/.maho-command-$$-$name"
  cat >"$tmp" <<EOF_COMMAND
#!/usr/bin/env bash
$MARKER
MAHO_ROOT="\${MAHO_ROOT:-\${XDG_DATA_HOME:-\$HOME/.local/share}/maho/runtime/current}"
export MAHO_ROOT
EOF_COMMAND
  if [ "$name" = maho-notify ]; then cat >>"$tmp" <<'EOF_NOTIFY'
export MAHO_NOTIFY_CONFIG_DIR="$MAHO_ROOT/config/quickshell/maho-notify"
EOF_NOTIFY
  fi
  cat >>"$tmp" <<EOF_COMMAND
exec bash "\$MAHO_ROOT/bin/$name" "\$@"
EOF_COMMAND
  chmod 0755 "$tmp"; mv -Tf -- "$tmp" "$path"
}

snapshot_one() {
  local tx="$1" manifest="$2" path="$3" key="$4"
  if [ -d "$path" ] && [ ! -L "$path" ]; then die "snapshot refuses directory: $path"; return 1; fi
  if [ -e "$path" ] || [ -L "$path" ]; then cp -a --no-dereference "$path" "$tx/$key"; printf 'p\t%s\t%s\n' "$path" "$key" >>"$manifest"; else printf 'm\t%s\t%s\n' "$path" "$key" >>"$manifest"; fi
}
snapshot_all() {
  local tx="$1" manifest="$tx/manifest" index=0 name wants path
  mkdir -m 0700 "$tx"; : >"$manifest"
  for name in "${COMMANDS[@]}"; do index=$((index+1)); snapshot_one "$tx" "$manifest" "$(command_path "$name")" "$index"; done
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$SHELL_TARGET" "$index"
  for path in "${HYPR_MANAGED_RELS[@]}"; do index=$((index+1)); snapshot_one "$tx" "$manifest" "$(hypr_target_for "$path")" "$index"; done
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$FILES_DESKTOP_TARGET" "$index"
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$VESKTOP_WRAPPER" "$index"
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$VESKTOP_DESKTOP_TARGET" "$index"
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$MIMEAPPS_TARGET" "$index"
  for name in "${UNITS[@]}"; do index=$((index+1)); snapshot_one "$tx" "$manifest" "$(unit_path "$name")" "$index"; done
  for name in "${UNITS[@]}"; do for wants in default.target.wants graphical-session.target.wants "$SESSION_TARGET_UNIT.wants"; do path="$UNIT_DIR/$wants/$name"; index=$((index+1)); snapshot_one "$tx" "$manifest" "$path" "$index"; done; done
  index=$((index+1)); snapshot_one "$tx" "$manifest" "$PREVIOUS" "$index"
}
restore_present_atomic() {
  local source="$1" target="$2" parent tmp

  parent="$(dirname -- "$target")"
  mkdir -p "$parent"

  while :; do
    tmp="$parent/.maho-restore.$$.$RANDOM"
    [ ! -e "$tmp" ] && [ ! -L "$tmp" ] && break
  done

  if ! cp -a --no-dereference "$source" "$tmp"; then
    rm -rf -- "$tmp"
    return 1
  fi

  if ! mv -Tf -- "$tmp" "$target"; then
    rm -rf -- "$tmp"
    return 1
  fi
}

restore_all() {
  local tx="$1" state path key
  [ -f "$tx/manifest" ] || return 0

  while IFS=$'\t' read -r state path key; do
    [ -d "$path" ] && [ ! -L "$path" ] && continue

    if [ "$state" = p ]; then
      restore_present_atomic "$tx/$key" "$path"
    else
      rm -f -- "$path"
    fi
  done <"$tx/manifest"
}
wire_runtime() {
  local name desktop_tmp
  for name in "${COMMANDS[@]}"; do write_command "$name"; done
  atomic_link "$(runtime_path "$SHELL_SOURCE_REL")" "$SHELL_TARGET"
  for name in "${HYPR_MANAGED_RELS[@]}"; do atomic_link "$(runtime_path "$name")" "$(hypr_target_for "$name")"; done
  mkdir -p "$(dirname -- "$FILES_DESKTOP_TARGET")"
  desktop_tmp="$(dirname -- "$FILES_DESKTOP_TARGET")/.maho-files-desktop-$$"
  render_files_desktop >"$desktop_tmp"
  chmod 0644 "$desktop_tmp"
  mv -Tf -- "$desktop_tmp" "$FILES_DESKTOP_TARGET"
  bash "$(runtime_path "bin/maho-vesktop-install")" install
  for name in "${UNITS[@]}"; do atomic_link "$(runtime_path "systemd/user/$name")" "$(unit_path "$name")"; done
}
systemd_available() { command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; }
managed_wants_link() {
  local name="$1" wants="$2" link target resolved_link resolved_target
  link="$UNIT_DIR/$wants/$name"; target="$(unit_path "$name")"; [ -L "$link" ] || return 1
  resolved_link="$(readlink -f -- "$link" 2>/dev/null || true)"; resolved_target="$(readlink -f -- "$target" 2>/dev/null || true)"
  [ -n "$resolved_link" ] && [ -n "$resolved_target" ] && [ "$resolved_link" = "$resolved_target" ]
}
remove_managed_wants_link() { local name="$1" wants="$2" link="$UNIT_DIR/$2/$1"; managed_wants_link "$name" "$wants" && rm -f -- "$link" || true; }
wire_ownership() {
  local name
  mkdir -p "$UNIT_DIR/default.target.wants" "$UNIT_DIR/graphical-session.target.wants" "$UNIT_DIR/$SESSION_TARGET_UNIT.wants"
  for name in "${CORE_UNITS[@]}"; do remove_managed_wants_link "$name" graphical-session.target.wants; remove_managed_wants_link "$name" "$SESSION_TARGET_UNIT.wants"; atomic_link "$UNIT_DIR/$name" "$UNIT_DIR/default.target.wants/$name"; done
  for name in "${STARTUP_UNITS[@]}"; do remove_managed_wants_link "$name" graphical-session.target.wants; remove_managed_wants_link "$name" "$SESSION_TARGET_UNIT.wants"; atomic_link "$UNIT_DIR/$name" "$UNIT_DIR/default.target.wants/$name"; done
  for name in "${GRAPHICAL_UNITS[@]}"; do remove_managed_wants_link "$name" default.target.wants; remove_managed_wants_link "$name" graphical-session.target.wants; remove_managed_wants_link "$name" "$SESSION_TARGET_UNIT.wants"; done
  for name in "${PASSIVE_UNITS[@]}"; do remove_managed_wants_link "$name" default.target.wants; remove_managed_wants_link "$name" graphical-session.target.wants; remove_managed_wants_link "$name" "$SESSION_TARGET_UNIT.wants"; done
  remove_managed_wants_link "$SESSION_TARGET_UNIT" default.target.wants
  remove_managed_wants_link "$SESSION_TARGET_UNIT" graphical-session.target.wants
  remove_managed_wants_link "$SESSION_TARGET_UNIT" "$SESSION_TARGET_UNIT.wants"
  systemctl --user daemon-reload
}

runtime_activation_health() {
  local release="$1" observed release_json release_ok=0 current_ok=0 wiring_ok=0
  observed="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  [ "$observed" = "$release" ] && current_ok=1
  if release_json="$(python "$RUNTIME_RELEASE_VERIFIER" "$release" --releases-root "$RELEASES" 2>/dev/null)"; then
    release_ok=1
  else
    release_json="${release_json:-{}}"
  fi
  status >/dev/null 2>&1 && wiring_ok=1
  python - "$release" "$observed" "$release_json" "$current_ok" "$release_ok" "$wiring_ok" <<'PY_RUNTIME_HEALTH'
import json
import sys

expected, observed, raw = sys.argv[1:4]
try:
    verification = json.loads(raw)
except Exception:
    verification = {"verified": False, "reasons": ["verification_output_invalid"]}
current_ok = sys.argv[4] == "1"
release_ok = sys.argv[5] == "1" and verification.get("verified") is True
wiring_ok = sys.argv[6] == "1"
print(json.dumps({
    "version": 1,
    "kind": "maho-runtime-activation-health",
    "expected_runtime": expected,
    "observed_runtime": observed or None,
    "current_matches_expected": current_ok,
    "release": verification,
    "release_verified": release_ok,
    "managed_wiring_matches_current": wiring_ok,
    "healthy": current_ok and release_ok and wiring_ok,
}, sort_keys=True, separators=(",", ":")))
PY_RUNTIME_HEALTH
  [ "$current_ok" -eq 1 ] && [ "$release_ok" -eq 1 ] && [ "$wiring_ok" -eq 1 ]
}

install_runtime() (
  set -e
  local release old="" tx committed=0 rc transaction_id recovery_incident="" health_file begin_json
  local reload_verified=1 wiring_verified=0 observed_current="" finish_json verified
  local activation_started=0 activation_stage="prepared" deployment_json planner_rc=0
  preflight; validate_targets
  [ -L "$CURRENT" ] && old="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  planner_args=(python "$RUNTIME_DEPLOYMENT_PLANNER" --source-root "$ROOT")
  [ -z "$old" ] || planner_args+=(--current "$old")
  [ "${MAHO_RUNTIME_DEVELOPMENT:-0}" -eq 0 ] || planner_args+=(--development)
  deployment_json="$("${planner_args[@]}")" || planner_rc=$?
  if [ "$planner_rc" -ne 0 ]; then
    echo "$deployment_json" >&2
    die "runtime deployment authority rejected the source or transition; use --development only for an explicitly trust-ineligible developer runtime"
    return 1
  fi
  readarray -t deployment_fields < <(python - "$deployment_json" <<'PY_DEPLOYMENT_PLAN'
import json,sys
row=json.loads(sys.argv[1])
print(row["deployment_class"])
print("true" if row.get("source_dirty") is True else "false")
print("true" if row.get("trust_eligible") is True else "false")
print(row["transition"])
PY_DEPLOYMENT_PLAN
)
  DEPLOYMENT_CLASS="${deployment_fields[0]}"
  SOURCE_DIRTY="${deployment_fields[1]}"
  TRUST_ELIGIBLE="${deployment_fields[2]}"
  DEPLOYMENT_TRANSITION="${deployment_fields[3]}"
  export DEPLOYMENT_CLASS SOURCE_DIRTY TRUST_ELIGIBLE DEPLOYMENT_TRANSITION
  echo "PASS  deployment authority $DEPLOYMENT_CLASS/$DEPLOYMENT_TRANSITION"
  release="$(build_release)"
  tx="$RUNTIME_ROOT/.transaction-$$"; snapshot_all "$tx"
  transaction_id="runtime-activation-$(python -c 'import uuid; print(uuid.uuid4().hex)')"
  health_file="$tx/activation-health.json"
  begin_runtime_recovery() {
    [ -n "$recovery_incident" ] && return 0
    [ "$activation_started" -eq 1 ] || return 0
    [ -n "$old" ] && [ -d "$old" ] && [ "$old" != "$release" ] || return 0
    if [ ! -s "$health_file" ]; then
      python - "$health_file" "$activation_stage" "$release" "$(readlink -f -- "$CURRENT" 2>/dev/null || true)" "${1:-1}" <<'PY_RUNTIME_ABORT'
import json,sys
from pathlib import Path
path,stage,expected,observed,rc=sys.argv[1:]
Path(path).write_text(json.dumps({
    "version":1,
    "kind":"maho-runtime-activation-failure",
    "healthy":False,
    "stage":stage,
    "expected_runtime":expected,
    "observed_runtime":observed or None,
    "transaction_exit_code":int(rc),
}, sort_keys=True, separators=(",", ":")) + "\n")
PY_RUNTIME_ABORT
    fi
    begin_json="$(python "$RUNTIME_RECOVERY_ENGINE" \
      --state-root "$GUARDIAN_STATE_ROOT" --releases-root "$RELEASES" \
      begin --transaction-id "$transaction_id" --failed "$release" --replacement "$old" \
      --failure-evidence "$health_file" 2>/dev/null || true)"
    recovery_incident="$(python - "$begin_json" <<'PY_RUNTIME_BEGIN_HELPER'
import json,sys
try: print(str(json.loads(sys.argv[1]).get("incident_id") or ""))
except Exception: print("")
PY_RUNTIME_BEGIN_HELPER
)"
  }
  rollback_exit() {
    rc=$?; [ "$committed" -eq 1 ] && return "$rc"; set +e
    begin_runtime_recovery "$rc"
    if [ -n "$old" ] && [ -d "$old" ]; then atomic_link "$old" "$CURRENT" >/dev/null 2>&1; else rm -f -- "$CURRENT"; fi
    restore_all "$tx"
    reload_verified=1
    if systemd_available; then
      systemctl --user daemon-reload >/dev/null 2>&1 || reload_verified=0
    fi
    if [ -n "$recovery_incident" ]; then
      wiring_verified=0; status >/dev/null 2>&1 && wiring_verified=1
      observed_current="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
      finish_args=(
        python "$RUNTIME_RECOVERY_ENGINE"
        --state-root "$GUARDIAN_STATE_ROOT"
        --releases-root "$RELEASES"
        finish --incident-id "$recovery_incident"
        --observed-current "${observed_current:-$CURRENT}"
      )
      [ "$wiring_verified" -eq 1 ] && finish_args+=(--wiring-verified)
      [ "$reload_verified" -eq 1 ] && finish_args+=(--systemd-reload-verified)
      finish_json="$("${finish_args[@]}" 2>/dev/null || true)"
      verified="$(python - "$finish_json" <<'PY_RUNTIME_FINISH'
import json,sys
try: print("1" if json.loads(sys.argv[1]).get("verified") is True else "0")
except Exception: print("0")
PY_RUNTIME_FINISH
)"
      if [ "$verified" = 1 ]; then
        echo "PASS  Guardian verified restoration of the pre-activation Maho runtime" >&2
      else
        echo "WARN  Guardian could not verify the runtime rollback postcondition" >&2
      fi
    fi
    rm -rf -- "$tx"
    return "$rc"
  }
  trap rollback_exit EXIT
  [ -n "$old" ] && [ "$old" != "$release" ] && atomic_link "$old" "$PREVIOUS"
  activation_stage="switch-runtime"
  atomic_link "$release" "$CURRENT"
  activation_started=1
  activation_stage="wire-runtime"
  wire_runtime
  activation_stage="wire-ownership"
  if systemd_available; then wire_ownership; else echo "INFO  systemd user manager unavailable; ownership wiring deferred"; fi
  activation_stage="desktop-database"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(dirname "$FILES_DESKTOP_TARGET")" >/dev/null 2>&1 || true
  activation_stage="health-verification"
  if ! runtime_activation_health "$release" >"$health_file"; then
    begin_runtime_recovery 1
    die "activated runtime failed bounded health verification"
    return 1
  fi
  committed=1; rm -rf -- "$tx"; trap - EXIT
  supersede_json="$(python "$RUNTIME_RECOVERY_ENGINE" \
    --state-root "$GUARDIAN_STATE_ROOT" --releases-root "$RELEASES" \
    supersede --current-runtime "$release" 2>/dev/null || true)"
  superseded_count="$(python - "$supersede_json" <<'PY_RUNTIME_SUPERSEDE'
import json,sys
try: print(int(json.loads(sys.argv[1]).get("count") or 0))
except Exception: print(0)
PY_RUNTIME_SUPERSEDE
)"
  [ "$superseded_count" -gt 0 ] && echo "INFO  Guardian archived $superseded_count superseded runtime incident(s)"
  echo "PASS  runtime $CURRENT -> $release"
  if MAHO_ROOT="$CURRENT" bash "$CURRENT/bin/maho-wallpaper-session" prepare; then
    echo "PASS  selected wallpaper boot asset prepared"
  else
    echo "WARN  selected video boot poster could not be prepared" >&2
  fi
  echo "INFO  running graphical services were not restarted"
  echo "INFO  activate the new graphical runtime with: maho-session stop && maho-session start"
)

install_sddm() {
  local account runtime installer

  [ "$(id -u)" -ne 0 ] || {
    die "run maho-setup as the desktop user; --with-sddm requests root only for the SDDM files"
    return 1
  }
  command -v sudo >/dev/null 2>&1 || {
    die "--with-sddm requires sudo"
    return 1
  }
  runtime="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  [ -n "$runtime" ] && [ -d "$runtime" ] || {
    die "installed runtime is unavailable for SDDM integration"
    return 1
  }
  installer="$runtime/bin/maho-lock-sddm-install"
  account="$(id -un)"

  sudo env MAHO_SDDM_USER="$account" bash "$installer" install
  sudo env MAHO_SDDM_USER="$account" bash "$installer" status
}

install_platform() {
  local account runtime installer

  [ "$(id -u)" -ne 0 ] || {
    die "run maho-setup as the desktop user; --with-platform requests root only for managed system policy"
    return 1
  }
  command -v sudo >/dev/null 2>&1 || {
    die "--with-platform requires sudo"
    return 1
  }
  runtime="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  [ -n "$runtime" ] && [ -d "$runtime" ] || {
    die "installed runtime is unavailable for platform integration"
    return 1
  }
  installer="$runtime/bin/maho-platform-install"
  account="$(id -un)"

  sudo env MAHO_PLATFORM_USER="$account" bash "$installer" install
  sudo env MAHO_PLATFORM_USER="$account" bash "$installer" early-kms-refresh
  sudo env MAHO_PLATFORM_USER="$account" bash "$installer" status
}

effective_notify_runtime_authority() {
  systemd_available || return 0
  local effective_exec
  effective_exec="$(systemctl --user show maho-notify.service --property=ExecStart --value 2>/dev/null || true)"
  [ -z "$effective_exec" ] && return 0
  case "$effective_exec" in
    *"$BIN_DIR/maho-notify"*) return 0 ;;
    *) return 1 ;;
  esac
}

status() {
  local failed=0 name current
  [ -L "$CURRENT" ] && [ -d "$CURRENT" ] || { echo "FAIL  runtime current"; failed=1; }
  current="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"
  if [ -n "$current" ] && [ -d "$current" ]; then
    python "$RUNTIME_RELEASE_VERIFIER" "$current" --releases-root "$RELEASES" >/dev/null 2>&1       || { echo "FAIL  runtime release integrity"; failed=1; }
  fi
  for name in "${COMMANDS[@]}"; do managed_command "$name" || { echo "FAIL  command $name"; failed=1; }; done
  for name in "${UNITS[@]}"; do managed_unit "$name" || { echo "FAIL  unit $name"; failed=1; }; done
  managed_shell || { echo "FAIL  shell config"; failed=1; }
  managed_hypr || { echo "FAIL  Maho Hyprland managed configuration"; failed=1; }
  managed_files_desktop || { echo "FAIL  Maho Files desktop entry"; failed=1; }
  bash "$(runtime_path "bin/maho-vesktop-install")" status >/dev/null 2>&1 || { echo "FAIL  Vesktop canonical wiring"; failed=1; }
  if systemd_available; then
    effective_notify_runtime_authority || { echo "FAIL  Notify execution authority bypasses runtime/current"; failed=1; }
    for name in "${CORE_UNITS[@]}"; do managed_wants_link "$name" default.target.wants || { echo "FAIL  core ownership $name"; failed=1; }; done
    for name in "${STARTUP_UNITS[@]}"; do managed_wants_link "$name" default.target.wants || { echo "FAIL  startup ownership $name"; failed=1; }; done
    for name in "${GRAPHICAL_UNITS[@]}"; do if managed_wants_link "$name" default.target.wants || managed_wants_link "$name" graphical-session.target.wants; then echo "FAIL  stale graphical ownership $name"; failed=1; fi; done
    for name in "${PASSIVE_UNITS[@]}"; do if managed_wants_link "$name" default.target.wants || managed_wants_link "$name" graphical-session.target.wants || managed_wants_link "$name" "$SESSION_TARGET_UNIT.wants"; then echo "FAIL  passive unit unexpectedly enabled $name"; failed=1; fi; done
    if managed_wants_link "$SESSION_TARGET_UNIT" default.target.wants || managed_wants_link "$SESSION_TARGET_UNIT" graphical-session.target.wants; then echo "FAIL  stale session target ownership"; failed=1; fi
  fi
  return "$failed"
}
rollback() {
  local previous current
  [ -L "$PREVIOUS" ] || { die "no previous release"; return 1; }
  previous="$(readlink -f -- "$PREVIOUS")"; [ -d "$previous" ] || { die "previous release missing"; return 1; }
  current="$(readlink -f -- "$CURRENT" 2>/dev/null || true)"; atomic_link "$previous" "$CURRENT"
  [ -n "$current" ] && [ -d "$current" ] && atomic_link "$current" "$PREVIOUS"
  systemd_available && systemctl --user daemon-reload || true
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(dirname "$FILES_DESKTOP_TARGET")" >/dev/null 2>&1 || true
  echo "PASS  rolled back to $previous"; echo "INFO  running graphical services were not restarted"
}
uninstall() {
  local name path wants
  if systemd_available; then systemctl --user stop "$SESSION_TARGET_UNIT" >/dev/null 2>&1 || true; for name in "${CORE_UNITS[@]}" "${STARTUP_UNITS[@]}"; do systemctl --user disable --now "$name" >/dev/null 2>&1 || true; done; for name in "${PASSIVE_UNITS[@]}"; do systemctl --user stop "$name" >/dev/null 2>&1 || true; done; fi
  for name in "${UNITS[@]}"; do for wants in default.target.wants graphical-session.target.wants "$SESSION_TARGET_UNIT.wants"; do remove_managed_wants_link "$name" "$wants"; done; done
  for name in "${UNITS[@]}"; do path="$(unit_path "$name")"; if managed_unit "$name"; then rm -f -- "$path"; elif [ -e "$path" ] || [ -L "$path" ]; then echo "KEPT  unmanaged user unit $path"; fi; done
  managed_shell && rm -f -- "$SHELL_TARGET" || true
  for name in "${HYPR_MANAGED_RELS[@]}"; do path="$(hypr_target_for "$name")"; if managed_hypr_file "$name"; then rm -f -- "$path"; elif [ -e "$path" ] || [ -L "$path" ]; then echo "KEPT  unmanaged Hyprland config $path"; fi; done
  managed_files_desktop && rm -f -- "$FILES_DESKTOP_TARGET" || true
  for name in "${COMMANDS[@]}"; do path="$(command_path "$name")"; if managed_command "$name"; then rm -f -- "$path"; elif [ -e "$path" ] || [ -L "$path" ]; then echo "KEPT  unmanaged command $path"; fi; done
  systemd_available && systemctl --user daemon-reload >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(dirname "$FILES_DESKTOP_TARGET")" >/dev/null 2>&1 || true
  echo "PASS  runtime wiring removed; releases and live-owned Notify configuration preserved"
}

case "${1:-}" in
  install)
    shift
    with_sddm=0
    with_platform=0
    development=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --adopt-live) ;;
        --with-sddm) with_sddm=1 ;;
        --with-platform) with_platform=1 ;;
        --development) development=1 ;;
        *) die "unknown install option: $1"; exit 2 ;;
      esac
      shift
    done
    [ "$with_sddm" -eq 0 ] || bash "$ROOT/bin/maho-lock-sddm-install" preflight
    [ "$with_platform" -eq 0 ] || bash "$ROOT/bin/maho-platform-install" preflight
    MAHO_RUNTIME_DEVELOPMENT="$development" install_runtime
    [ "$with_sddm" -eq 0 ] || install_sddm
    [ "$with_platform" -eq 0 ] || install_platform
    ;;
  preflight) preflight ;;
  status) status ;;
  rollback) rollback ;;
  uninstall) uninstall ;;
  *) cat <<'HELP'
Maho OS durable V1 runtime setup

Usage:
  bash bin/maho-setup preflight
  bash bin/maho-setup install [--adopt-live] [--with-sddm] [--with-platform] [--development]
  maho-setup status
  maho-setup rollback
  maho-setup uninstall

Install validates all live targets before mutation, builds an immutable
content-addressed release, atomically switches runtime/current, and wires the
accepted MahoOS V1 command/unit/session surface through that stable path.

Observe/security follow the user-manager lifetime. Graphical services are owned
only by maho-session -> maho-hyprland-session.target. Installation never restarts
the running graphical session. Existing live-owned Notify configuration is
preserved and the managed Notify wrapper explicitly uses the immutable runtime
configuration.

--adopt-live is retained for compatibility and does not bypass validation.
--development explicitly permits dirty, divergent, or older source, and marks
the resulting immutable runtime as ineligible for production trust.
--with-sddm explicitly installs and verifies the persistent Maho Lock greeter
without restarting SDDM or the current graphical session.
--with-platform installs the singleton Secret Service activation, explicit
Hyprland portal selection, RTKit, systemd-timesyncd clock authority, and the
verified early hybrid-GPU KMS initramfs policy. It does not restart the current
graphical session or change firmware/Secure Boot state.
HELP
  ;;
esac

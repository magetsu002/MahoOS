#!/usr/bin/env bash

set -u

ROOT="${MAHO_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/maho/theme"
BACKENDS="$ROOT/theme/backends"

die() {
    echo "maho-theme: $*" >&2
    return 1
}

doctor() {
    local failed=0

    echo "Maho OS theme doctor"
    echo

    for cmd in python realpath sha256sum; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf 'PASS  %-12s %s\n' \
                "$cmd" "$(command -v "$cmd")"
        else
            printf 'FAIL  %-12s missing\n' "$cmd"
            failed=1
        fi
    done

    echo

    if command -v matugen >/dev/null 2>&1 &&
       command -v magick >/dev/null 2>&1 &&
       [ -x "$BACKENDS/matugen/generate" ]
    then
        echo "PASS  backend      matugen"
    else
        echo "INFO  backend      matugen unavailable"
    fi

    if command -v magick >/dev/null 2>&1 &&
       [ -x "$BACKENDS/basic/generate" ]
    then
        echo "PASS  backend      basic"
    else
        echo "INFO  backend      basic unavailable"
    fi

    if ! command -v matugen >/dev/null 2>&1 &&
       ! command -v magick >/dev/null 2>&1
    then
        echo
        echo "INFO  No automatic palette backend is available."
        echo "INFO  Maho itself remains usable; theme generation is disabled."
    fi

    return "$failed"
}

resolve_backend() {
    local requested="${MAHO_THEME_BACKEND:-auto}"

    case "$requested" in
        auto)
            if command -v magick >/dev/null 2>&1 &&
               [ -x "$BACKENDS/basic/generate" ]
            then
                printf '%s\n' "$BACKENDS/basic/generate"
                return 0
            fi

            if command -v matugen >/dev/null 2>&1 &&
               command -v magick >/dev/null 2>&1 &&
               [ -x "$BACKENDS/matugen/generate" ]
            then
                printf '%s\n' "$BACKENDS/matugen/generate"
                return 0
            fi

            die "no palette backend is available"
            return 1
            ;;

        matugen|basic)
            local backend="$BACKENDS/$requested/generate"

            [ -x "$backend" ] || {
                die "backend is unavailable: $requested"
                return 1
            }

            case "$requested" in
                matugen)
                    command -v matugen >/dev/null 2>&1 || {
                        die "matugen backend selected but matugen is missing"
                        return 1
                    }
                    command -v magick >/dev/null 2>&1 || {
                        die "matugen backend requires ImageMagick for Palette V2 analysis"
                        return 1
                    }
                    ;;
                basic)
                    command -v magick >/dev/null 2>&1 || {
                        die "basic backend selected but ImageMagick is missing"
                        return 1
                    }
                    ;;
            esac

            printf '%s\n' "$backend"
            ;;

        /*)
            [ -x "$requested" ] || {
                die "custom backend is not executable: $requested"
                return 1
            }

            printf '%s\n' "$requested"
            ;;

        *)
            die "unknown backend: $requested"
            return 1
            ;;
    esac
}

validate_mode_request() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"

    [ -n "$wallpaper" ] || {
        die "wallpaper path is required"
        return 1
    }

    case "$mode" in
        dark|light) ;;
        *)
            die "mode must be dark or light"
            return 1
            ;;
    esac

    [ -f "$wallpaper" ] || {
        die "wallpaper does not exist: $wallpaper"
        return 1
    }
}

mode_cache_dir() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"
    local backend wall stat_key identity

    validate_mode_request "$wallpaper" "$mode" >/dev/null || return 1
    backend="$(resolve_backend)" || return 1
    wall="$(realpath "$wallpaper")" || return 1
    stat_key="$(stat -Lc '%s:%y' "$wall")" || return 1

    identity="$(
        {
            printf 'wall=%s\nmode=%s\nstat=%s\nbackend=%s\n' \
                "$wall" "$mode" "$stat_key" "$backend"
            for component in \
                "$backend" \
                "$ROOT/theme/palette_v2.py" \
                "$ROOT/bin/maho-terminal-theme" \
                "$ROOT/lib/maho_terminal_theme.py"
            do
                [ -f "$component" ] && sha256sum "$component"
            done
        } | sha256sum | awk '{print $1}'
    )" || return 1

    printf '%s/mode-cache/%s\n' "$CACHE" "$identity"
}

render_mode_artifacts() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"
    local output_palette="${3:-}"
    local output_kitty="${4:-}"
    local quiet="${5:-0}"

    validate_mode_request "$wallpaper" "$mode" || return 1
    [ -n "$output_palette" ] && [ -n "$output_kitty" ] || {
        die "render targets are required"
        return 1
    }

    local backend wall txn raw canonical
    backend="$(resolve_backend)" || return 1
    wall="$(realpath "$wallpaper")" || return 1
    txn="$CACHE/transactions/$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
    raw="$txn/raw.json"
    canonical="$txn/palette.json"
    mkdir -p "$txn"

    if [ "$quiet" != "1" ]; then
        echo "Generating candidate palette..."
        echo "Source:  $wall"
        echo "Mode:    $mode"
        echo "Backend: $(basename "$(dirname "$backend")")"
    fi

    if ! "$backend" "$wall" "$mode" "$raw" \
        >"$txn/backend.stdout" 2>"$txn/backend.stderr"
    then
        [ "$quiet" = "1" ] || {
            echo
            echo "Palette backend failed:"
            tail -30 "$txn/backend.stderr"
        }
        return 1
    fi

    [ -s "$raw" ] || {
        die "palette backend produced no output"
        return 1
    }

    if ! python "$ROOT/theme/palette_v2.py" canonicalize \
        "$raw" "$canonical" "$wall" "$mode"
    then
        [ "$quiet" = "1" ] || echo "Canonical palette validation failed."
        return 1
    fi

    if ! MAHO_ROOT="$ROOT" bash "$ROOT/bin/maho-terminal-theme" \
        render "$canonical" "$txn/kitty.conf" >/dev/null
    then
        [ "$quiet" = "1" ] || echo "Terminal palette generation failed."
        return 1
    fi

    mkdir -p "$(dirname "$output_palette")" "$(dirname "$output_kitty")"
    cp "$canonical" "$output_palette.tmp.$$"
    mv "$output_palette.tmp.$$" "$output_palette"
    cp "$txn/kitty.conf" "$output_kitty.tmp.$$"
    mv "$output_kitty.tmp.$$" "$output_kitty"
}

cache_mode_artifacts() {
    local wallpaper="$1" mode="$2" palette="$3" kitty="$4"
    local dir
    dir="$(mode_cache_dir "$wallpaper" "$mode")" || return 1
    mkdir -p "$dir"

    cp "$palette" "$dir/.palette.json.$$"
    mv "$dir/.palette.json.$$" "$dir/palette.json"
    cp "$kitty" "$dir/.kitty.conf.$$"
    mv "$dir/.kitty.conf.$$" "$dir/kitty.conf"
}

restore_cached_candidate() {
    local wallpaper="$1" mode="$2" dir
    dir="$(mode_cache_dir "$wallpaper" "$mode")" || return 1
    [ -s "$dir/palette.json" ] && [ -s "$dir/kitty.conf" ] || return 1

    mkdir -p "$CACHE"
    cp "$dir/palette.json" "$CACHE/.candidate.json.$$"
    mv "$CACHE/.candidate.json.$$" "$CACHE/candidate.json"
    cp "$dir/kitty.conf" "$CACHE/.candidate-kitty.conf.$$"
    mv "$CACHE/.candidate-kitty.conf.$$" "$CACHE/candidate-kitty.conf"
}

generate() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"
    local palette kitty

    validate_mode_request "$wallpaper" "$mode" || {
        die "usage: maho-theme generate WALLPAPER [dark|light]"
        return 1
    }

    mkdir -p "$CACHE"
    palette="$CACHE/.generated-palette.$$"
    kitty="$CACHE/.generated-kitty.$$"

    if ! render_mode_artifacts "$wallpaper" "$mode" "$palette" "$kitty" 0; then
        rm -f -- "$palette" "$kitty"
        return 1
    fi

    cp "$palette" "$CACHE/.candidate.json.$$"
    mv "$CACHE/.candidate.json.$$" "$CACHE/candidate.json"
    cp "$kitty" "$CACHE/.candidate-kitty.conf.$$"
    mv "$CACHE/.candidate-kitty.conf.$$" "$CACHE/candidate-kitty.conf"

    cache_mode_artifacts "$wallpaper" "$mode" "$palette" "$kitty"
    rm -f -- "$palette" "$kitty"

    echo
    echo "PASS"
    echo "Candidate:"
    echo "$CACHE/candidate.json"
    echo
    sha256sum "$CACHE/candidate.json"
}

prepare_mode() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"
    local dir palette kitty

    validate_mode_request "$wallpaper" "$mode" || return 1
    dir="$(mode_cache_dir "$wallpaper" "$mode")" || return 1
    if [ -s "$dir/palette.json" ] && [ -s "$dir/kitty.conf" ]; then
        return 0
    fi

    mkdir -p "$CACHE"
    palette="$CACHE/.prepare-palette.$$"
    kitty="$CACHE/.prepare-kitty.$$"

    if ! render_mode_artifacts "$wallpaper" "$mode" "$palette" "$kitty" 1; then
        rm -f -- "$palette" "$kitty"
        return 1
    fi

    if ! cache_mode_artifacts "$wallpaper" "$mode" "$palette" "$kitty"; then
        rm -f -- "$palette" "$kitty"
        return 1
    fi
    rm -f -- "$palette" "$kitty"
}

load_mode_candidate() {
    local wallpaper="$1" mode="$2"
    if restore_cached_candidate "$wallpaper" "$mode"; then
        return 0
    fi
    generate "$wallpaper" "$mode"
}

hypr_gradient_to_rgba() {
    python -c '
import re, sys

value = sys.argv[1].strip()
m = re.fullmatch(r"([0-9a-fA-F]{8}) 0deg", value)

if not m:
    raise SystemExit(
        "unsupported existing border gradient: " + repr(value)
    )

argb = m.group(1).lower()
print("rgba(" + argb[2:] + argb[:2] + ")")
' "$1"
}

maho_hyprctl() {
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl "$@"
        return
    fi

    local instance

    instance="$(
        hyprctl instances -j 2>/dev/null |
        python -c '
import json
import sys

try:
    instances = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)

if len(instances) != 1:
    raise SystemExit(2)

instance = instances[0].get("instance")

if not isinstance(instance, str) or not instance:
    raise SystemExit(1)

print(instance)
'
    )" || return $?

    hyprctl -i "$instance" "$@"
}

hypr_set_borders() {
    local active="$1"
    local inactive="$2"

    maho_hyprctl eval \
        "hl.config({ general = { col = {
            active_border = \"$active\",
            inactive_border = \"$inactive\"
        }}})"
}

hypr_apply_palette_file() {
    local palette="$1"
    local publish="${2:-0}"

    [ -f "$palette" ] || {
        die "palette does not exist: $palette"
        return 1
    }

    command -v hyprctl >/dev/null 2>&1 || {
        die "hyprctl is unavailable"
        return 1
    }

    local errors
    errors="$(maho_hyprctl configerrors 2>&1)"

    [ -z "$errors" ] || {
        echo "$errors" >&2
        die "Hyprland already has configuration errors"
        return 1
    }

    local colors
    mapfile -t colors < <(
        python -c '
import json, re, sys

with open(sys.argv[1]) as f:
    data = json.load(f)

for key in ("foreground", "primary"):
    value = data["colors"][key]

    if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise SystemExit("invalid palette color: " + repr(value))

    print(value[1:].lower())
' "$palette"
    )

    [ "${#colors[@]}" -eq 2 ] || {
        die "failed to read palette colors"
        return 1
    }

    local new_active="rgba(${colors[0]}ff)"
    local new_inactive="rgba(${colors[1]}ff)"

    local expected_active="ff${colors[0]} 0deg"
    local expected_inactive="ff${colors[1]} 0deg"

    local old_active old_inactive

    old_active="$(
        maho_hyprctl getoption general:col.active_border -j |
        python -c 'import json,sys; print(json.load(sys.stdin)["gradient"])'
    )"

    old_inactive="$(
        maho_hyprctl getoption general:col.inactive_border -j |
        python -c 'import json,sys; print(json.load(sys.stdin)["gradient"])'
    )"

    local rollback_active rollback_inactive

    rollback_active="$(hypr_gradient_to_rgba "$old_active")" || {
        die "existing active border is user-managed or unsupported; leaving it alone"
        return 1
    }

    rollback_inactive="$(hypr_gradient_to_rgba "$old_inactive")" || {
        die "existing inactive border is user-managed or unsupported; leaving it alone"
        return 1
    }

    local result

    result="$(
        hypr_set_borders \
            "$new_active" \
            "$new_inactive" \
            2>&1
    )"

    if [ "$result" != "ok" ]; then
        hypr_set_borders \
            "$rollback_active" \
            "$rollback_inactive" \
            >/dev/null 2>&1 || true

        die "Hyprland rejected theme application"
        return 1
    fi

    # Hyprland's Lua config dispatch is synchronous. Read back immediately;
    # an artificial 100 ms sleep made every theme switch feel visibly laggy.
    local actual_active actual_inactive

    actual_active="$(
        maho_hyprctl getoption general:col.active_border -j |
        python -c 'import json,sys; print(json.load(sys.stdin)["gradient"])'
    )"

    actual_inactive="$(
        maho_hyprctl getoption general:col.inactive_border -j |
        python -c 'import json,sys; print(json.load(sys.stdin)["gradient"])'
    )"

    if [ "${actual_active,,}" != "${expected_active,,}" ] ||
       [ "${actual_inactive,,}" != "${expected_inactive,,}" ]
    then
        hypr_set_borders \
            "$rollback_active" \
            "$rollback_inactive" \
            >/dev/null 2>&1 || true

        die "verification failed; previous borders restored"
        return 1
    fi

    if [ "$publish" = "1" ]; then
        mkdir -p "$CACHE"

        if [ -f "$CACHE/active.json" ]; then
            cp "$CACHE/active.json" "$CACHE/.previous.json.$$"
            mv "$CACHE/.previous.json.$$" "$CACHE/previous.json"
        fi

        cp "$palette" "$CACHE/.active.json.$$"
        mv "$CACHE/.active.json.$$" "$CACHE/active.json"
    fi

    echo "PASS"
    echo "Active border:   $actual_active"
    echo "Inactive border: $actual_inactive"
}

apply_hypr_candidate() {
    local candidate="$CACHE/candidate.json"
    local terminal_candidate="$CACHE/candidate-kitty.conf"

    [ -f "$candidate" ] || {
        die "no candidate palette exists"
        return 1
    }
    [ -f "$terminal_candidate" ] || {
        die "no generated terminal candidate exists"
        return 1
    }

    hypr_apply_palette_file "$candidate" 1 || return 1

    cp "$terminal_candidate" "$CACHE/.kitty.conf.$$"
    mv "$CACHE/.kitty.conf.$$" "$CACHE/kitty.conf"
    MAHO_ROOT="$ROOT" bash "$ROOT/bin/maho-terminal-theme" reload
}

restore_hypr_active() {
    local active="$CACHE/active.json"

    [ -f "$active" ] || {
        die "no active palette exists"
        return 1
    }

    hypr_apply_palette_file "$active" 0 || return 1
    MAHO_ROOT="$ROOT" bash "$ROOT/bin/maho-terminal-theme" sync "$active"
}

apply_wallpaper() {
    local wallpaper="${1:-}"
    local mode="${2:-dark}"
    local opposite

    validate_mode_request "$wallpaper" "$mode" || return 1
    load_mode_candidate "$wallpaper" "$mode" || return 1
    apply_hypr_candidate || return 1

    if [ "$mode" = "dark" ]; then
        opposite="light"
    else
        opposite="dark"
    fi

    # Precompute the other appearance mode out of band so the next user
    # switch can reuse a verified palette instead of regenerating it.
    (
        MAHO_ROOT="$ROOT" bash "$ROOT/bin/maho-theme" prepare "$wallpaper" "$opposite" \
            >/dev/null 2>&1 || true
    ) &
}

show_candidate() {
    local candidate="$CACHE/candidate.json"

    [ -f "$candidate" ] || {
        die "no candidate palette exists"
        return 1
    }

    python -m json.tool "$candidate"
}

candidate_hash() {
    local candidate="$CACHE/candidate.json"

    [ -f "$candidate" ] || {
        die "no candidate palette exists"
        return 1
    }

    sha256sum "$candidate"
}

case "${1:-}" in
    doctor)
        doctor
        ;;

    generate)
        generate "${2:-}" "${3:-dark}"
        ;;

    prepare)
        prepare_mode "${2:-}" "${3:-dark}"
        ;;

    show)
        show_candidate
        ;;

    hash)
        candidate_hash
        ;;

    apply-hypr)
        apply_hypr_candidate
        ;;

    restore-hypr)
        restore_hypr_active
        ;;

    apply)
        apply_wallpaper "${2:-}" "${3:-dark}"
        ;;

    *)
        cat <<'HELP'
Maho OS theme engine

Usage:
  maho-theme doctor
  maho-theme generate WALLPAPER [dark|light]
  maho-theme prepare WALLPAPER [dark|light]
  maho-theme show
  maho-theme hash
  maho-theme apply WALLPAPER [dark|light]
  maho-theme apply-hypr
  maho-theme restore-hypr

Generation alone does not modify the desktop.
Applying a wallpaper generates, validates, applies, and verifies its palette.
HELP
        ;;
esac

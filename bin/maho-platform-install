#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="$ROOT/config/platform"
PORTAL_ROOT="${MAHO_PLATFORM_PORTAL_ROOT:-/etc/xdg/xdg-desktop-portal}"
TIMESYNC_ROOT="${MAHO_PLATFORM_TIMESYNC_ROOT:-/etc/systemd/timesyncd.conf.d}"
DBUS_ROOT="${MAHO_PLATFORM_DBUS_ROOT:-/usr/local/share/dbus-1/services}"
STATE_ROOT="${MAHO_PLATFORM_STATE_ROOT:-/var/lib/maho-platform}"
MARKER="# managed-by: maho-platform v1"

PORTAL_TARGET="$PORTAL_ROOT/maho-portals.conf"
TIMESYNC_TARGET="$TIMESYNC_ROOT/60-maho.conf"
DBUS_NAMES=(
    org.freedesktop.secrets.service
    org.gnome.keyring.service
    org.freedesktop.impl.portal.Secret.service
)

die() { echo "maho-platform-install: $*" >&2; return 1; }

require_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    if [ "${MAHO_PLATFORM_ALLOW_UNPRIVILEGED:-0}" = 1 ] \
        && [ "$PORTAL_ROOT" != /etc/xdg/xdg-desktop-portal ] \
        && [ "$TIMESYNC_ROOT" != /etc/systemd/timesyncd.conf.d ] \
        && [ "$DBUS_ROOT" != /usr/local/share/dbus-1/services ] \
        && [ "$STATE_ROOT" != /var/lib/maho-platform ]; then
        return 0
    fi
    die "system installation requires root"
}

managed_file() {
    [ -f "$1" ] && grep -Fxq "$MARKER" "$1"
}

preflight() {
    local failed=0 name
    for name in maho-portals.conf systemd-timesyncd.conf "${DBUS_NAMES[@]}"; do
        [ -r "$SOURCE/$name" ] || { echo "FAIL  platform source $name"; failed=1; }
    done
    command -v systemctl >/dev/null 2>&1 || { echo "FAIL  systemctl unavailable"; failed=1; }
    [ -e /usr/lib/systemd/system/systemd-timesyncd.service ] \
        || [ "${MAHO_PLATFORM_ALLOW_UNPRIVILEGED:-0}" = 1 ] \
        || { echo "FAIL  systemd-timesyncd unavailable"; failed=1; }
    [ "$failed" -eq 0 ] && echo "PASS  Maho platform preflight"
    return "$failed"
}

conflicting_clock_authority() {
    local unit
    for unit in chronyd.service ntpd.service openntpd.service; do
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            printf '%s\n' "$unit"
            return 0
        fi
    done
    return 1
}

install_one() {
    local source="$1" target="$2" temporary
    if [ -e "$target" ] && ! managed_file "$target"; then
        die "refusing to replace unmanaged file: $target"
        return 1
    fi
    mkdir -p "$(dirname -- "$target")"
    temporary="$(dirname -- "$target")/.maho-platform.$$.$(basename -- "$target")"
    install -m 0644 "$source" "$temporary"
    mv -f -- "$temporary" "$target"
}

install_platform() {
    local conflict name
    require_root
    preflight
    if conflict="$(conflicting_clock_authority)"; then
        die "clock authority already active: $conflict"
        return 1
    fi

    mkdir -p "$STATE_ROOT"
    install_one "$SOURCE/maho-portals.conf" "$PORTAL_TARGET"
    install_one "$SOURCE/systemd-timesyncd.conf" "$TIMESYNC_TARGET"
    for name in "${DBUS_NAMES[@]}"; do
        install_one "$SOURCE/$name" "$DBUS_ROOT/$name"
    done

    systemctl daemon-reload
    systemctl enable --now systemd-timesyncd.service
    systemctl start rtkit-daemon.service
    echo "PASS  systemd-timesyncd is the Maho clock authority"
    echo "PASS  RTKit scheduling broker is active"
    echo "PASS  portal and Secret Service selection installed for the next user session"
    echo "INFO  no graphical session or portal service was restarted"
}

status() {
    local failed=0 name
    managed_file "$PORTAL_TARGET" || { echo "FAIL  Maho portal selection"; failed=1; }
    managed_file "$TIMESYNC_TARGET" || { echo "FAIL  Maho clock policy"; failed=1; }
    for name in "${DBUS_NAMES[@]}"; do
        managed_file "$DBUS_ROOT/$name" || { echo "FAIL  Secret Service activation $name"; failed=1; }
    done
    if systemctl is-enabled --quiet systemd-timesyncd.service \
        && systemctl is-active --quiet systemd-timesyncd.service; then
        echo "PASS  systemd-timesyncd enabled and active"
    else
        echo "FAIL  systemd-timesyncd is not enabled and active"
        failed=1
    fi
    systemctl is-active --quiet rtkit-daemon.service \
        && echo "PASS  RTKit active" \
        || { echo "FAIL  RTKit inactive"; failed=1; }
    return "$failed"
}

uninstall_platform() {
    local name target
    require_root
    for target in "$PORTAL_TARGET" "$TIMESYNC_TARGET"; do
        if managed_file "$target"; then rm -f -- "$target"; elif [ -e "$target" ]; then die "refusing unmanaged file: $target"; return 1; fi
    done
    for name in "${DBUS_NAMES[@]}"; do
        target="$DBUS_ROOT/$name"
        if managed_file "$target"; then rm -f -- "$target"; elif [ -e "$target" ]; then die "refusing unmanaged file: $target"; return 1; fi
    done
    systemctl daemon-reload
    echo "PASS  removed Maho-owned platform policy"
    echo "INFO  services were left running; provider ownership now requires an administrator decision"
}

case "${1:-}" in
    preflight) preflight ;;
    install) install_platform ;;
    status) status ;;
    uninstall) uninstall_platform ;;
    *) echo "usage: maho-platform-install preflight|install|status|uninstall" >&2; exit 2 ;;
esac

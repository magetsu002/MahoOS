#!/usr/bin/env bash

set -euo pipefail

TARGET=maho-hyprland-session.target

systemd_available() {
    command -v systemctl >/dev/null 2>&1 &&
        systemctl --user show-environment >/dev/null 2>&1
}

import_graphical_environment() {
    local -a names=()
    local name

    for name in DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE; do
        [ -n "${!name:-}" ] && names+=("$name")
    done

    [ "${#names[@]}" -gt 0 ] || {
        echo "maho-session: no graphical session environment is available" >&2
        return 1
    }

    systemctl --user import-environment "${names[@]}"

    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd "${names[@]}" >/dev/null
    fi
}

wayland_ready() {
    local display runtime
    display="${WAYLAND_DISPLAY:-$(systemctl --user show-environment | sed -n 's/^WAYLAND_DISPLAY=//p')}"
    runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"
    [ -n "$display" ] && [ -S "$runtime/$display" ]
}

reconcile_portals() {
    local -a backends=(
        xdg-desktop-portal-hyprland.service
        xdg-desktop-portal-gtk.service
    )
    local -a units=(
        xdg-desktop-portal.service
        "${backends[@]}"
    )

    systemctl --user reset-failed "${units[@]}" >/dev/null 2>&1 || true
    systemctl --user restart "${backends[@]}" >/dev/null 2>&1 || {
        echo "maho-session: portal backend reconciliation failed" >&2
        return 1
    }
    systemctl --user restart xdg-desktop-portal.service >/dev/null 2>&1 || {
        echo "maho-session: portal broker reconciliation failed" >&2
        return 1
    }
}

archive_hyprland_log() {
    local signature runtime state boot source target temporary

    signature="${HYPRLAND_INSTANCE_SIGNATURE:-$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HYPRLAND_INSTANCE_SIGNATURE=//p')}"
    case "$signature" in
        ""|*[!A-Za-z0-9._-]*) return 0 ;;
    esac

    runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"
    source="$runtime/hypr/$signature/hyprland.log"
    [ -r "$source" ] || return 0

    boot="$(tr -d '\n' </proc/sys/kernel/random/boot_id)"
    case "$boot" in
        ""|*[!A-Fa-f0-9-]*) return 0 ;;
    esac

    state="${XDG_STATE_HOME:-$HOME/.local/state}/maho/session"
    install -d -m 0700 "$state"
    target="$state/hyprland-$boot.log"
    temporary="$(mktemp "$state/.hyprland-$boot.XXXXXX")"
    if tail -c 2097152 -- "$source" >"$temporary"; then
        chmod 0600 "$temporary"
        mv -f -- "$temporary" "$target"
    else
        rm -f -- "$temporary"
    fi
}

start_session() {
    systemd_available || {
        echo "maho-session: systemd user manager unavailable" >&2
        return 1
    }

    import_graphical_environment
    wayland_ready || {
        echo "maho-session: Wayland socket is not ready" >&2
        return 1
    }

    systemctl --user reset-failed \
        maho-awww-daemon.service \
        maho-wallpaper.service \
        maho-shell.service \
        maho-dock.service \
        maho-notify.service \
        maho-clipboard-history.service \
        >/dev/null 2>&1 || true

    local portal_rc=0
    reconcile_portals || portal_rc=$?
    systemctl --user start "$TARGET"
    return "$portal_rc"
}

stop_session() {
    systemd_available || return 0
    archive_hyprland_log
    systemctl --user stop "$TARGET"

    systemctl --user unset-environment \
        DISPLAY WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        || true
}

wait_awww() {
    local i

    for i in $(seq 1 100); do
        awww query >/dev/null 2>&1 && return 0
        sleep 0.05
    done

    echo "maho-session: awww socket did not become ready" >&2
    return 1
}

case "${1:-}" in
    start) start_session ;;
    stop) stop_session ;;
    wait-awww) wait_awww ;;
    status)
        systemctl --user is-active \
            "$TARGET" \
            graphical-session.target \
            maho-awww-daemon.service \
            maho-wallpaper.service \
            maho-shell.service \
            maho-dock.service \
            maho-notify.service \
            maho-clipboard-history.service
        ;;
    *)
        echo "usage: maho-session start|stop|status|wait-awww" >&2
        exit 2
        ;;
esac

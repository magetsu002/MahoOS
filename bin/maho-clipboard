#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="${MAHO_CLIPBOARD_CONFIG:-$ROOT/config/quickshell/maho-clipboard/shell.qml}"
INSTANCE_HELPER="$ROOT/lib/runtime-instance.sh"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCK="$RUNTIME_DIR/maho-clipboard.lock"
RUNTIME_IDENTITY=""

if [ "$#" -ne 0 ]; then
    echo "maho-clipboard: no arguments are supported" >&2
    exit 2
fi

for dependency in quickshell flock cliphist wl-copy; do
    command -v "$dependency" >/dev/null 2>&1 || {
        echo "maho-clipboard: $dependency is unavailable" >&2
        exit 1
    }
done

[ -r "$CONFIG" ] || {
    echo "maho-clipboard: configuration missing: $CONFIG" >&2
    exit 1
}
[ -r "$INSTANCE_HELPER" ] || {
    echo "maho-clipboard: runtime identity helper is missing" >&2
    exit 1
}

source "$INSTANCE_HELPER"
RUNTIME_IDENTITY="$(maho_runtime_identity "$ROOT")"
export MAHO_RUNTIME_IDENTITY="$RUNTIME_IDENTITY"

clipboard_pids() {
    maho_quickshell_config_pids "/quickshell/maho-clipboard/shell.qml"
}

retire_stale_clipboards() {
    local pid identity
    while read -r pid; do
        [ -n "$pid" ] || continue
        identity="$(maho_process_runtime_identity "$pid" 2>/dev/null || true)"
        [ "$identity" = "$RUNTIME_IDENTITY" ] && continue

        quickshell ipc --pid "$pid" call clipboard retire "$RUNTIME_IDENTITY" >/dev/null 2>&1 \
            || quickshell ipc --pid "$pid" call clipboard close >/dev/null 2>&1 \
            || true
        if ! maho_wait_for_process_exit "$pid" 20; then
            kill -TERM "$pid" 2>/dev/null || true
            maho_wait_for_process_exit "$pid" 10 || {
                echo "maho-clipboard: stale runtime instance $pid did not retire" >&2
                return 1
            }
        fi
    done < <(clipboard_pids)
}

retire_stale_clipboards

mkdir -p "$RUNTIME_DIR"
exec 9>"$LOCK"

# The first invocation owns the lock and starts the surface. A later invocation
# talks to that exact Quickshell config instead of spawning another process or
# killing it, so SUPER+V is a true open/close toggle and the exit animation is
# allowed to finish normally.
if ! flock -n 9; then
    while read -r pid; do
        [ "$(maho_process_runtime_identity "$pid" 2>/dev/null || true)" = "$RUNTIME_IDENTITY" ] || continue
        if quickshell ipc --pid "$pid" call clipboard toggle >/dev/null 2>&1; then
            exit 0
        fi
    done < <(clipboard_pids)

    echo "maho-clipboard: lock owner does not match the current runtime identity" >&2
    exit 1
fi

# Development runs use the repository QML directly while the live Hyprland
# config may still point at an older Maho release. Register the same narrowly
# scoped layer rule in the running compositor so the preview receives real
# background blur immediately. The rule only matches the maho-clipboard
# namespace and disappears on compositor restart/reload; failure is non-fatal.
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl eval 'if _G.maho_clipboard_glass_rule == nil then _G.maho_clipboard_glass_rule = hl.layer_rule({ name = "maho-clipboard-runtime-glass", match = { namespace = "maho-clipboard" }, blur = true, ignore_alpha = 0.16, xray = false, no_anim = true }) end' \
        >/dev/null 2>&1 || true
fi

exec quickshell -p "$CONFIG" >/dev/null 2>&1

#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="${MAHO_LOCK_CONFIG:-$ROOT/config/quickshell/maho-lock/shell.qml}"
PREVIEW_CONFIG="${MAHO_LOCK_PREVIEW_CONFIG:-$ROOT/config/quickshell/maho-lock/preview.qml}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCK_FILE="$RUNTIME_DIR/maho-lock.lock"

mode="secure"
case "${1:-}" in
    '') ;;
    --preview) mode="preview" ;;
    -h|--help)
        cat <<'HELP'
Maho Lock

Usage:
  maho-lock             Securely lock the Wayland session.
  maho-lock --preview   Show the exact lock UI without acquiring a session lock.

The preview is for visual/input acceptance only. Press Escape to close it.
HELP
        exit 0
        ;;
    *)
        echo "maho-lock: unsupported argument: $1" >&2
        exit 2
        ;;
esac

for dependency in quickshell flock; do
    command -v "$dependency" >/dev/null 2>&1 || {
        echo "maho-lock: $dependency is unavailable" >&2
        exit 1
    }
done

if [ "$mode" = "preview" ]; then
    [ -r "$PREVIEW_CONFIG" ] || {
        echo "maho-lock: preview configuration missing: $PREVIEW_CONFIG" >&2
        exit 1
    }

    exec quickshell --no-duplicate -p "$PREVIEW_CONFIG"
fi

[ -r "$CONFIG" ] || {
    echo "maho-lock: configuration missing: $CONFIG" >&2
    exit 1
}

mkdir -p "$RUNTIME_DIR"
exec 9>"$LOCK_FILE"

# A session lock is a singleton security authority. If Maho Lock already owns
# the runtime lock, a second key press must not spawn another WlSessionLock.
if ! flock -n 9; then
    exit 0
fi

exec quickshell --no-duplicate -p "$CONFIG"

#!/usr/bin/env bash

set -u

CONFIG_DIR="${MAHO_NOTIFY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/maho-notify}"
CONFIG="$CONFIG_DIR/shell.qml"
STATE_HELPER="${MAHO_NOTIFY_STATE_HELPER:-$CONFIG_DIR/state.py}"
PALETTE="${XDG_CACHE_HOME:-$HOME/.cache}/maho/theme/active.json"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOG="${MAHO_NOTIFY_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/maho-notify.log}"
LOCK="$RUNTIME_DIR/maho-notify.lock"
SERVICE="maho-notify.service"

notify_pids() {
    local pid argument

    while read -r pid; do
        [ -r "/proc/$pid/cmdline" ] || continue
        while read -r argument; do
            case "$argument" in
                */maho-notify|*/maho-notify/shell.qml)
                    printf '%s\n' "$pid"
                    break
                    ;;
            esac
        done < <(tr '\0' '\n' < "/proc/$pid/cmdline")
    done < <(pgrep -x quickshell 2>/dev/null || true)
}

notify_count() {
    notify_pids | awk 'NF { count++ } END { print count + 0 }'
}

notify_running() {
    [ "$(notify_count)" -gt 0 ]
}

systemd_available() {
    command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

service_installed() {
    systemd_available && systemctl --user cat "$SERVICE" >/dev/null 2>&1
}

dbus_has_owner() {
    command -v gdbus >/dev/null 2>&1 || return 1
    gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.NameHasOwner \
        org.freedesktop.Notifications 2>/dev/null | grep -Fq '(true,'
}

dbus_owner() {
    command -v gdbus >/dev/null 2>&1 || return 1
    gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetNameOwner \
        org.freedesktop.Notifications 2>/dev/null | sed -n "s/^('\([^']*\)',)$/\1/p"
}

ensure_wayland_env() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$RUNTIME_DIR}"

    if [ -z "${WAYLAND_DISPLAY:-}" ]; then
        local candidate
        candidate="$(
            find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' 2>/dev/null |
            sort |
            head -1
        )"
        [ -n "$candidate" ] && export WAYLAND_DISPLAY="$candidate"
    fi
}

set_hyprland_material_rule() {
    local state="$1" candidate
    command -v hyprctl >/dev/null 2>&1 || return 0
    ensure_wayland_env

    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        candidate="$(find "$XDG_RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -1)"
        [ -n "$candidate" ] && export HYPRLAND_INSTANCE_SIGNATURE="$candidate"
    fi
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0

    if [ "$state" = "on" ]; then
        hyprctl eval 'if _G.maho_notify_glass_rule == nil then _G.maho_notify_glass_rule = hl.layer_rule({ name = "maho-notify-runtime-glass", match = { namespace = "maho-notify-center" }, blur = true, ignore_alpha = 0.16, xray = false, no_anim = true, order = 9 }) else _G.maho_notify_glass_rule:set_enabled(true) end; if _G.maho_notify_popup_glass_rule == nil then _G.maho_notify_popup_glass_rule = hl.layer_rule({ name = "maho-notify-runtime-popup-glass", match = { namespace = "maho-notify-popup" }, blur = true, ignore_alpha = 0.16, xray = false, no_anim = true, order = 9 }) else _G.maho_notify_popup_glass_rule:set_enabled(true) end' >/dev/null 2>&1 || true
    else
        hyprctl eval 'if _G.maho_notify_glass_rule ~= nil then _G.maho_notify_glass_rule:set_enabled(false) end; if _G.maho_notify_popup_glass_rule ~= nil then _G.maho_notify_popup_glass_rule:set_enabled(false) end' >/dev/null 2>&1 || true
    fi
}

notify_status_pid() {
    local path="$RUNTIME_DIR/maho/notify-status.json"
    [ -r "$path" ] || return 1

    python - "$path" <<'PY_STATUS_PID'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        payload = json.load(handle)
    pid = int(payload.get("pid", 0))
    valid = payload.get("version") == 1 and bool(payload.get("active")) and pid > 0
except (OSError, TypeError, ValueError, json.JSONDecodeError):
    valid = False
    pid = 0

if valid:
    print(pid)
else:
    raise SystemExit(1)
PY_STATUS_PID
}

notify_pid_is_live() {
    local candidate="$1" pid
    while read -r pid; do
        [ "$pid" = "$candidate" ] && return 0
    done < <(notify_pids)
    return 1
}

ipc_call() {
    local pid=""
    ensure_wayland_env

    pid="$(notify_status_pid 2>/dev/null || true)"
    if [ -n "$pid" ] && notify_pid_is_live "$pid"; then
        quickshell ipc --pid "$pid" call notify "$@"
        return
    fi

    quickshell ipc -p "$CONFIG" call notify "$@"
}

ipc_value() {
    ipc_call "$@" 2>/dev/null | tail -1
}

bool_word() {
    if [ "$1" = "true" ]; then
        echo "on"
    else
        echo "off"
    fi
}

state_metadata() {
    if [ -r "$STATE_HELPER" ]; then
        python "$STATE_HELPER" status 2>/dev/null || echo '{}'
    else
        echo '{}'
    fi
}

run_notify() {
    command -v quickshell >/dev/null 2>&1 || {
        echo "maho-notify: quickshell is unavailable" >&2
        return 1
    }

    command -v flock >/dev/null 2>&1 || {
        echo "maho-notify: flock is unavailable" >&2
        return 1
    }

    [ -r "$CONFIG" ] || {
        echo "maho-notify: configuration missing: $CONFIG" >&2
        return 1
    }

    ensure_wayland_env
    set_hyprland_material_rule on
    mkdir -p "$(dirname "$LOG")" "$RUNTIME_DIR"

    exec 9>"$LOCK"
    if ! flock -n 9; then
        echo "maho-notify: already running"
        return 0
    fi

    if notify_running; then
        echo "maho-notify: existing Maho Notify instance detected; refusing duplicate"
        return 0
    fi

    if dbus_has_owner; then
        echo "maho-notify: org.freedesktop.Notifications is already owned by $(dbus_owner)" >&2
        echo "maho-notify: refusing to displace the current notification server" >&2
        return 1
    fi

    exec quickshell --no-duplicate -p "$CONFIG" >>"$LOG" 2>&1
}

doctor() {
    local failed=0 count

    echo "Maho Notify doctor"
    echo

    if command -v quickshell >/dev/null 2>&1; then
        printf 'PASS  quickshell     %s\n' "$(quickshell --version 2>&1 | head -1)"
    else
        echo "FAIL  quickshell     unavailable"
        failed=1
    fi

    if [ -r "$CONFIG" ]; then
        printf 'PASS  config         %s\n' "$CONFIG"
    else
        printf 'FAIL  config         missing: %s\n' "$CONFIG"
        failed=1
    fi

    if [ -r "$STATE_HELPER" ]; then
        printf 'PASS  state helper   %s\n' "$STATE_HELPER"
    else
        printf 'FAIL  state helper   missing: %s\n' "$STATE_HELPER"
        failed=1
    fi

    if [ -r "$PALETTE" ]; then
        if python -m json.tool "$PALETTE" >/dev/null 2>&1; then
            echo "PASS  palette        valid Maho active.json"
        else
            echo "FAIL  palette        active.json is not valid JSON"
            failed=1
        fi
    else
        echo "INFO  palette        active.json missing; QML fallbacks will be used"
    fi

    ensure_wayland_env
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        printf 'PASS  wayland        %s\n' "$WAYLAND_DISPLAY"
    else
        echo "INFO  wayland        display not resolved in this shell"
    fi

    count="$(notify_count)"
    if [ "$count" -gt 1 ]; then
        printf 'FAIL  instances      %s Maho Notify processes detected\n' "$count"
        failed=1
    elif [ "$count" -eq 1 ]; then
        echo "PASS  instances      exactly one Maho Notify process"
    else
        echo "INFO  instances      Maho Notify currently inactive"
    fi

    if dbus_has_owner; then
        printf 'INFO  dbus owner     %s\n' "$(dbus_owner)"
    else
        echo "PASS  dbus owner     org.freedesktop.Notifications is available"
    fi

    if service_installed; then
        if systemctl --user is-active --quiet "$SERVICE"; then
            echo "PASS  service        $SERVICE active"
        else
            echo "INFO  service        installed but inactive"
        fi
    else
        echo "INFO  service        user unit not installed"
    fi

    if [ -e "$LOG" ] && [ ! -r "$LOG" ]; then
        echo "FAIL  log            exists but is unreadable"
        failed=1
    else
        printf 'PASS  log            bounded access at %s\n' "$LOG"
    fi

    echo
    if [ "$failed" -eq 0 ]; then
        echo "PASS  doctor         no blocking notification problems detected"
    else
        echo "FAIL  doctor         blocking notification problems detected"
    fi

    return "$failed"
}

settings_status_json() {
    local running=false runtime_json="" sidecar_json="{}"
    local adaptive_quiet=false history_count=0
    local sidecar="$RUNTIME_DIR/maho/notify-status.json"

    notify_running && running=true

    if [ "$running" = "true" ]; then
        if grep -Fq 'function settingsStatus(): string' "$CONFIG" 2>/dev/null; then
            runtime_json="$(ipc_value settingsStatus || true)"
        fi
        case "$runtime_json" in
            {*})
                SETTINGS_META="$runtime_json" python - <<'PY'
import json
import os

try:
    meta = json.loads(os.environ["SETTINGS_META"])
except (TypeError, ValueError, json.JSONDecodeError):
    meta = {}

print(json.dumps({
    "active": True,
    "dnd": bool(meta.get("dnd", False)),
    "adaptive_quiet": bool(meta.get("adaptive_quiet", False)),
    "history_count": int(meta.get("history_count", 0)),
    "unread_count": int(meta.get("unread_count", 0)),
}, separators=(",", ":")))
PY
                return
                ;;
        esac

        # Compatibility path for older immutable Notify runtimes: use the
        # privacy-safe reactive sidecar for DND/unread and only two IPC calls
        # for values the v1 sidecar does not publish.
        [ -r "$sidecar" ] && sidecar_json="$(cat "$sidecar" 2>/dev/null || echo '{}')"
        adaptive_quiet="$(ipc_value adaptiveQuietStatus || echo false)"
        history_count="$(ipc_value historyCount || echo 0)"
    fi

    RUNNING="$running"     SIDECAR_JSON="$sidecar_json"     ADAPTIVE_QUIET="$adaptive_quiet"     HISTORY_COUNT="$history_count"     python - <<'PY'
import json
import os

try:
    sidecar = json.loads(os.environ["SIDECAR_JSON"])
except (TypeError, ValueError, json.JSONDecodeError):
    sidecar = {}

print(json.dumps({
    "active": os.environ["RUNNING"] == "true",
    "dnd": bool(sidecar.get("dnd", False)),
    "adaptive_quiet": os.environ.get("ADAPTIVE_QUIET", "false") == "true",
    "history_count": int(os.environ.get("HISTORY_COUNT", "0") or 0),
    "unread_count": int(sidecar.get("unread_count", 0) or 0),
}, separators=(",", ":")))
PY
}

status_json() {
    local running=false service_state="missing" owner="" meta_json
    local dnd_value=false adaptive_quiet=false history_count=0 unread_count=0
    local visible_count=0 queued_count=0 live_count=0 dropped_count=0 suppressed_count=0
    notify_running && running=true
    dbus_has_owner && owner="$(dbus_owner)"

    if [ "$running" = "true" ]; then
        # Settings/Edge only need one coherent observation. New Notify runtimes
        # publish it in one IPC round trip instead of spawning quickshell nine
        # times. Keep the legacy calls as a compatibility fallback while older
        # immutable runtimes are still active.
        meta_json="$(ipc_value settingsStatus || true)"
        case "$meta_json" in
            {*}) ;;
            *)
                dnd_value="$(ipc_value dndStatus || echo false)"
                adaptive_quiet="$(ipc_value adaptiveQuietStatus || echo false)"
                history_count="$(ipc_value historyCount || echo 0)"
                unread_count="$(ipc_value unreadCount || echo 0)"
                visible_count="$(ipc_value visibleCount || echo 0)"
                queued_count="$(ipc_value queuedCount || echo 0)"
                live_count="$(ipc_value livePopupCount || echo 0)"
                dropped_count="$(ipc_value droppedPopupCount || echo 0)"
                suppressed_count="$(ipc_value suppressedPopupCount || echo 0)"
                [ -n "$dnd_value" ] || dnd_value=false
                [ -n "$history_count" ] || history_count=0
                [ -n "$unread_count" ] || unread_count=0
                [ -n "$visible_count" ] || visible_count=0
                [ -n "$queued_count" ] || queued_count=0
                [ -n "$live_count" ] || live_count=0
                [ -n "$dropped_count" ] || dropped_count=0
                [ -n "$suppressed_count" ] || suppressed_count=0
                meta_json="$(META_DND="$dnd_value" META_HISTORY="$history_count" META_UNREAD="$unread_count" python - <<'PY'
import json
import os
print(json.dumps({
    "dnd": os.environ["META_DND"] == "true",
    "adaptive_quiet": os.environ.get("ADAPTIVE_QUIET", "false") == "true",
    "history_count": int(os.environ["META_HISTORY"]),
    "unread_count": int(os.environ["META_UNREAD"]),
}, separators=(",", ":")))
PY
)"
                ;;
        esac
    else
        meta_json="$(state_metadata)"
    fi

    if service_installed; then
        service_state="inactive"
        systemctl --user is-active --quiet "$SERVICE" && service_state="active"
    fi

    RUNNING="$running" \
    ADAPTIVE_QUIET="$adaptive_quiet" \
    COUNT="$(notify_count)" \
    SERVICE_STATE="$service_state" \
    OWNER="$owner" \
    CONFIG_PATH="$CONFIG" \
    PALETTE_PATH="$PALETTE" \
    LOG_PATH="$LOG" \
    META_JSON="$meta_json" \
    VISIBLE_COUNT="$visible_count" \
    QUEUED_COUNT="$queued_count" \
    LIVE_COUNT="$live_count" \
    DROPPED_COUNT="$dropped_count" \
    SUPPRESSED_COUNT="$suppressed_count" \
    python - <<'PY'
import json
import os
from pathlib import Path

try:
    meta = json.loads(os.environ["META_JSON"])
except (TypeError, ValueError):
    meta = {}

print(json.dumps({
    "active": os.environ["RUNNING"] == "true",
    "instances": int(os.environ["COUNT"]),
    "service": os.environ["SERVICE_STATE"],
    "notification_owner": os.environ["OWNER"] or None,
    "dnd": bool(meta.get("dnd", False)),
    "adaptive_quiet": bool(meta.get(
        "adaptive_quiet",
        os.environ.get("ADAPTIVE_QUIET", "false") == "true",
    )),
    "history_count": int(meta.get("history_count", 0)),
    "unread_count": int(meta.get("unread_count", 0)),
    "popup": {
        "visible": int(meta.get("visible_count", os.environ["VISIBLE_COUNT"])),
        "queued": int(meta.get("queued_count", os.environ["QUEUED_COUNT"])),
        "live": int(meta.get("live_count", os.environ["LIVE_COUNT"])),
        "dropped": int(meta.get("dropped_count", os.environ["DROPPED_COUNT"])),
        "suppressed": int(meta.get("suppressed_count", os.environ["SUPPRESSED_COUNT"])),
    },
    "config": {
        "path": os.environ["CONFIG_PATH"],
        "readable": os.access(os.environ["CONFIG_PATH"], os.R_OK),
    },
    "palette": {
        "path": os.environ["PALETTE_PATH"],
        "present": Path(os.environ["PALETTE_PATH"]).is_file(),
    },
    "log": os.environ["LOG_PATH"],
}, separators=(",", ":")))
PY
}

manage_dnd() {
    local action="${1:-status}" result
    case "$action" in
        on|off|toggle|status) ;;
        *)
            echo "maho-notify: dnd expects on, off, toggle, or status" >&2
            return 2
            ;;
    esac

    if notify_running; then
        case "$action" in
            on) result="$(ipc_value setDnd true)" ;;
            off) result="$(ipc_value setDnd false)" ;;
            toggle) result="$(ipc_value toggleDnd)" ;;
            status) result="$(ipc_value dndStatus)" ;;
        esac
        bool_word "$result"
        return 0
    fi

    [ -r "$STATE_HELPER" ] || {
        echo "maho-notify: state helper missing: $STATE_HELPER" >&2
        return 1
    }
    case "$action" in
        on|off) python "$STATE_HELPER" set-dnd "$action" ;;
        toggle) python "$STATE_HELPER" toggle-dnd ;;
        status) python "$STATE_HELPER" get-dnd ;;
    esac
}

manage_adaptive_quiet() {
    local action="${1:-status}" result
    case "$action" in
        on|off|status) ;;
        *)
            echo "maho-notify: adaptive-quiet expects on, off, or status" >&2
            return 2
            ;;
    esac

    notify_running || {
        echo "maho-notify: adaptive quiet requires active Maho Notify" >&2
        return 1
    }
    case "$action" in
        on) result="$(ipc_value setAdaptiveQuiet true)" ;;
        off) result="$(ipc_value setAdaptiveQuiet false)" ;;
        status) result="$(ipc_value adaptiveQuietStatus)" ;;
    esac
    bool_word "$result"
}

clear_history() {
    if notify_running; then
        ipc_value clearHistory >/dev/null
        echo "Maho Notify history cleared"
        return 0
    fi
    [ -r "$STATE_HELPER" ] || {
        echo "maho-notify: state helper missing: $STATE_HELPER" >&2
        return 1
    }
    python "$STATE_HELPER" clear
    echo "Maho Notify history cleared"
}

open_center() {
    if ! notify_running; then
        start_notify || return 1
        local attempt
        for attempt in $(seq 1 30); do
            notify_running && [ "$(ipc_value centerStatus || true)" = "false" ] && break
            sleep 0.1
        done
    fi

    [ "$(ipc_value openCenter || true)" = "true" ] || {
        echo "maho-notify: notification center IPC unavailable" >&2
        return 1
    }
}

toggle_center() {
    if ! notify_running; then
        start_notify || return 1
        local attempt
        for attempt in $(seq 1 30); do
            notify_running && break
            sleep 0.1
        done
    fi

    [ "$(ipc_value toggleCenter || true)" = "true" ] || {
        echo "maho-notify: notification center toggle IPC unavailable" >&2
        return 1
    }
}

show_logs() {
    local lines="${1:-120}"

    case "$lines" in
        ''|*[!0-9]*)
            echo "maho-notify: log line count must be an integer" >&2
            return 2
            ;;
    esac

    if [ "$lines" -lt 1 ] || [ "$lines" -gt 500 ]; then
        echo "maho-notify: log line count must be between 1 and 500" >&2
        return 2
    fi

    if [ ! -r "$LOG" ]; then
        echo "maho-notify: runtime log unavailable: $LOG" >&2
        return 1
    fi

    tail -n "$lines" "$LOG"
}

start_notify() {
    if service_installed; then
        systemctl --user start "$SERVICE"
    else
        command -v quickshell >/dev/null 2>&1 || {
            echo "maho-notify: quickshell is unavailable" >&2
            return 1
        }
        [ -r "$CONFIG" ] || {
            echo "maho-notify: configuration missing: $CONFIG" >&2
            return 1
        }
        notify_running && return 0
        if dbus_has_owner; then
            echo "maho-notify: org.freedesktop.Notifications is already owned by $(dbus_owner)" >&2
            echo "maho-notify: refusing to displace the current notification server" >&2
            return 1
        fi

        ensure_wayland_env
        set_hyprland_material_rule on
        mkdir -p "$(dirname "$LOG")"
        quickshell --no-duplicate --daemonize -p "$CONFIG" >>"$LOG" 2>&1
    fi
}

stop_notify() {
    if service_installed; then
        systemctl --user stop "$SERVICE" >/dev/null 2>&1 || true
    fi

    local pid
    while read -r pid; do
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    done < <(notify_pids)
    set_hyprland_material_rule off
}

case "${1:-run}" in
    run)
        run_notify
        ;;
    start)
        start_notify
        ;;
    stop)
        stop_notify
        ;;
    restart|reload)
        stop_notify
        start_notify
        ;;
    status)
        if [ "${2:-}" = "--json" ]; then
            status_json
            exit 0
        fi

        if notify_running; then
            echo "Maho Notify: active"
            notify_pids
            exit 0
        fi
        echo "Maho Notify: inactive"
        exit 1
        ;;
    settings-status)
        if [ "${2:-}" = "--json" ] || [ -z "${2:-}" ]; then
            settings_status_json
            exit 0
        fi
        echo "maho-notify: settings-status accepts only --json" >&2
        exit 2
        ;;
    doctor)
        doctor
        ;;
    logs)
        show_logs "${2:-120}"
        ;;
    dnd)
        manage_dnd "${2:-status}"
        ;;
    adaptive-quiet)
        manage_adaptive_quiet "${2:-status}"
        ;;
    history)
        case "${2:-}" in
            clear) clear_history ;;
            *) echo "maho-notify: history expects clear" >&2; exit 2 ;;
        esac
        ;;
    center)
        open_center
        ;;
    toggle-center)
        toggle_center
        ;;
    *)
        cat <<'HELP'
Usage: maho-notify [run|start|stop|restart|reload|status [--json]|settings-status [--json]|doctor|logs [LINES]|center|toggle-center|dnd on|off|toggle|status|adaptive-quiet on|off|status|history clear]

Maho Notify is the independent Quickshell notification surface shipped with
Maho OS. It refuses to displace an existing org.freedesktop.Notifications owner.

Commands:
  doctor         Check notification ownership and required runtime state.
  logs [LINES]   Print a bounded runtime-log tail (default 120, max 500).
  status --json  Emit full machine-readable service/config/ownership state.
  settings-status Emit the bounded state needed by Maho Settings.
  reload         Restart Maho Notify through the managed runtime path.
  dnd ...        Read or change persistent Do Not Disturb state.
  adaptive-quiet Read or change temporary adaptive popup suppression.
  history clear  Clear retained history without printing its content.
  center         Open the bounded Maho Notification Center.\n  toggle-center  Toggle the bounded Maho Notification Center.
HELP
        exit 2
        ;;
esac

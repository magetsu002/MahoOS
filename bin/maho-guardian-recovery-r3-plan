#!/usr/bin/env python3
from __future__ import annotations
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from guardian_recovery_r3 import R3PlanningError, intent_envelope, plan_r3_recovery
from maho_trust_identity import GenerationID, KernelGenerationID


def main() -> int:
    parser = argparse.ArgumentParser(description="Plan one bounded Guardian Recovery R3 action")
    parser.add_argument("report", type=Path)
    parser.add_argument("evidence_root", type=Path)
    parser.add_argument("current_system_generation_id")
    parser.add_argument("current_kernel_generation_id")
    args = parser.parse_args()
    try:
        report = json.loads(args.report.read_text(encoding="utf-8"))
        intent = plan_r3_recovery(
            report, args.evidence_root,
            current_system_generation_id=GenerationID(args.current_system_generation_id),
            current_kernel_generation_id=KernelGenerationID(args.current_kernel_generation_id),
        )
    except (OSError, json.JSONDecodeError, ValueError, R3PlanningError) as exc:
        print(json.dumps({"outcome":"REFUSE","reason":str(exc)}, sort_keys=True))
        return 2
    payload = intent_envelope(intent)
    payload["outcome"] = "READY"
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash

set -u

if [ -n "${MAHO_ROOT:-}" ]; then
    ROOT="$MAHO_ROOT"
elif [ -r "$HOME/.local/share/maho/runtime/current/lib/guardian_incident.py" ]; then
    ROOT="$(readlink -f "$HOME/.local/share/maho/runtime/current")"
else
    ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fi
SEC_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/maho/security"
DB_ROOT="${MAHO_PACMAN_DB_ROOT:-/var/lib/pacman/local}"
FS_ROOT="${MAHO_FS_ROOT:-/}"
PROC_ROOT="${MAHO_PROC_ROOT:-/proc}"
RUNTIME_ROOT="${MAHO_RUNTIME_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/maho/runtime}"
INCIDENT_ENGINE="$ROOT/lib/security_incident.py"
PREFLIGHT_ENGINE="$ROOT/lib/security_preflight.py"
GUARDIAN_INCIDENT="$ROOT/lib/guardian_incident.py"
GUARDIAN_POLICY="$ROOT/lib/guardian_severity.py"
GUARDIAN_ENGINE="$ROOT/lib/guardian_engine.py"
GUARDIAN_SERVICE="$ROOT/lib/guardian_service_incident.py"
GUARDIAN_WATCHER="$ROOT/lib/guardian_service_watcher.py"
GUARDIAN_UPDATE="$ROOT/lib/guardian_update.py"
GUARDIAN_LIVE="$ROOT/lib/guardian_live_cli.py"
GUARDIAN_RESPONSE="$ROOT/lib/guardian_live_response.py"
GUARDIAN_RECOVERY="$ROOT/lib/guardian_live_recovery.py"
GUARDIAN_TRACE="$ROOT/lib/guardian_trace.py"
UPDATE_STATE="${MAHO_UPDATE_STATE_ROOT:-/var/lib/maho/update}"
AUR_BUILD="$ROOT/bin/maho-aur-build"
INTENT="$ROOT/lib/intent.sh"
EVENTS="$ROOT/lib/events.sh"

if ! { [ -r "$INTENT" ] && source "$INTENT" 2>/dev/null; }; then
    maho_intent_get() { printf '%s\n' 'null'; }
fi
if ! { [ -r "$EVENTS" ] && source "$EVENTS" 2>/dev/null; }; then
    maho_event_emit() { return 0; }
fi

intent_string() {
    local key="$1" fallback="$2" raw
    raw="$(maho_intent_get "$key" 2>/dev/null || printf '%s\n' null)"
    python - "$fallback" "$raw" <<'PY'
import json,sys
fallback=sys.argv[1]
try: value=json.loads(sys.argv[2])
except Exception: value=None
print(value if isinstance(value,str) and value else fallback)
PY
}

prevention_mode() {
    local value
    value="$(intent_string security.prevention.mode shadow)"
    case "$value" in off|shadow) printf '%s\n' "$value" ;; *) printf '%s\n' shadow ;; esac
}

autonomy_level() {
    local value
    value="$(intent_string security.autonomy.level guard)"
    case "$value" in observe|guard|contain|recover) printf '%s\n' "$value" ;; *) printf '%s\n' guard ;; esac
}

emit_incident_changes() {
    local result="$1" kind risk payload summary status
    while IFS=$'\t' read -r kind risk payload; do
        [ -n "$kind" ] || continue
        case "$kind" in
            created)
                summary="Maho opened a correlated security incident in shadow prevention mode"
                status="observed"
                ;;
            updated)
                summary="Maho updated a security incident after new or changed evidence"
                status="observed"
                ;;
            resolved)
                summary="Maho resolved an incident because the correlated active evidence cleared"
                status="verified"
                risk="info"
                ;;
            *) continue ;;
        esac
        maho_event_emit security "incident.$kind" "$status" "$risk" "$summary" security.incident maho-guard "$payload" >/dev/null 2>&1 || true
    done < <(python - "$result" <<'PY'
import json,sys
r=json.loads(sys.argv[1])
for kind in ("created","updated","resolved"):
    for item in r.get(kind,[]):
        print(kind+"\t"+str(item.get("risk","info"))+"\t"+json.dumps(item,sort_keys=True,separators=(",",":")))
PY
)
}

emit_guardian_changes() {
    local result="$1" kind risk payload summary status
    while IFS=$'\t' read -r kind risk payload; do
        [ -n "$kind" ] || continue
        case "$kind" in
            created)
                summary="Guardian classified a new normalized incident"
                status="observed"
                ;;
            updated)
                summary="Guardian reclassified an incident after meaningful evidence changed"
                status="observed"
                ;;
            resolved)
                summary="Guardian recorded verified incident resolution in history"
                status="verified"
                ;;
            *) continue ;;
        esac
        maho_event_emit security "guardian.$kind" "$status" "$risk" "$summary" guardian.assessment maho-guard "$payload" >/dev/null 2>&1 || true
    done < <(python - "$result" <<'PY'
import json,sys
r=json.loads(sys.argv[1])
risk_for={0:"info",1:"low",2:"medium",3:"high",4:"critical"}
for kind in ("created","updated","resolved"):
    for item in r.get(kind,[]):
        level=((item.get("decision") or {}).get("severity") or {}).get("level",0)
        print(kind+"\t"+risk_for.get(level,"info")+"\t"+json.dumps(item,sort_keys=True,separators=(",",":")))
PY
)
}

pretty_reconcile() {
    python - "$1" "$2" <<'PY'
import json,sys
r=json.loads(sys.argv[1])
g=json.loads(sys.argv[2])
print("Maho security guard")
print("Prevention:  ",r.get("prevention_mode"))
print("Autonomy:    ",r.get("autonomy_level"))
print("Active:      ",r.get("active",0))
print("Highest risk:",r.get("highest_risk","info"))
print("Guardian L:  ",g.get("highest_level",0))
print("System mutation: none (detector/frontend); Guardian only records permitted recovery posture")
changes=len(r.get("created",[]))+len(r.get("updated",[]))+len(r.get("resolved",[]))
print("Incident changes:",changes)
PY
}

reconcile_command() {
    [ -r "$INCIDENT_ENGINE" ] || { echo "maho-guard: incident engine unavailable" >&2; return 1; }
    [ -r "$GUARDIAN_INCIDENT" ] || { echo "maho-guard: Guardian incident adapter unavailable" >&2; return 1; }
    local mode level result guardian_result
    mode="$(prevention_mode)"
    level="$(autonomy_level)"
    result="$(python "$INCIDENT_ENGINE" reconcile \
        --state-root "$SEC_STATE" \
        --db-root "$DB_ROOT" \
        --proc-root "$PROC_ROOT" \
        --fs-root "$FS_ROOT" \
        --runtime-root "$RUNTIME_ROOT" \
        --uid "$(id -u)" \
        --prevention-mode "$mode" \
        --autonomy-level "$level")" || return 1
    guardian_result="$(printf '%s' "$result" | python "$GUARDIAN_INCIDENT" security-reconcile \
        --state-root "$SEC_STATE" --input -)" || return 1
    if [ -r "$GUARDIAN_RESPONSE" ]; then
        python "$GUARDIAN_RESPONSE" \
            --state-root "$SEC_STATE" \
            --db-root "$DB_ROOT" \
            --proc-root "$PROC_ROOT" \
            --fs-root "$FS_ROOT" \
            --uid "$(id -u)" \
            reconcile >/dev/null || return 1
    fi
    emit_incident_changes "$result"
    emit_guardian_changes "$guardian_result"
    pretty_reconcile "$result" "$guardian_result"
}

status_command() {
    [ -r "$INCIDENT_ENGINE" ] || { echo "maho-guard: incident engine unavailable" >&2; return 1; }
    local rows
    rows="$(python "$INCIDENT_ENGINE" list --state-root "$SEC_STATE")" || return 1
    python - "$(prevention_mode)" "$(autonomy_level)" "$rows" <<'PY'
import json,sys
mode,level=sys.argv[1:3]; rows=json.loads(sys.argv[3])
print("Maho security guard status")
print(f"Prevention: {mode}   Autonomy target: {level}")
print("Enforcement: detector remains shadow-only; Guardian recovery is separately authority-gated")
print()
if not rows:
    print("No active correlated security incidents.")
else:
    for r in rows:
        s=r.get("subject",{})
        print(f"{r.get('risk','info').upper():8} {r.get('score',0):3}  {r.get('incident_id')}  {s.get('type')}:{s.get('id')}")
        print(f"          confidence={r.get('confidence')}  would={r.get('shadow_action')}  attention={r.get('attention')}")
PY
}

guardian_status_command() {
    [ -r "$GUARDIAN_INCIDENT" ] || { echo "maho-guard: Guardian incident adapter unavailable" >&2; return 1; }
    local rows
    rows="$(python "$GUARDIAN_INCIDENT" list --state-root "$SEC_STATE")" || return 1
    if [ "${1:-}" = "--json" ]; then
        printf '%s\n' "$rows"
        return 0
    fi
    python - "$rows" <<'PY'
import json,sys
rows=json.loads(sys.argv[1])
print("Maho Guardian active assessments")
print()
if not rows:
    print("No active Guardian assessments.")
    print("This view is active-only; completed response history remains available via maho guard or maho-guard recovery status.")
else:
    for row in rows:
        decision=row.get("decision") or {}
        sev=decision.get("severity") or {}
        rec=decision.get("recovery") or {}
        subject=row.get("subject") or {}
        print(f"L{sev.get('level',0)} {sev.get('label','normal'):<12} {row.get('incident_id')}")
        print(f"   subject={subject.get('type')}:{subject.get('id')}  mode={decision.get('execution_mode')}  recovery={rec.get('action')}")
        print(f"   {sev.get('reason','')}")
PY
}

guardian_update_status_command() {
    [ -r "$GUARDIAN_UPDATE" ] || { echo "maho-guard: Guardian update projection unavailable" >&2; return 1; }
    python "$GUARDIAN_UPDATE" --state-root "$UPDATE_STATE"
}

guardian_world_status_command() {
    [ -r "$GUARDIAN_LIVE" ] || { echo "maho-guard: live Guardian projection unavailable" >&2; return 1; }
    if [ "${1:-}" = "--json" ]; then
        python "$GUARDIAN_LIVE" --json
    elif [ -n "${1:-}" ]; then
        echo "usage: maho-guard world-status [--json]" >&2
        return 2
    else
        python "$GUARDIAN_LIVE"
    fi
}

response_command() {
    [ -r "$GUARDIAN_RESPONSE" ] || { echo "maho-guard: live response coordinator unavailable" >&2; return 1; }
    if [ "${1:-}" = "status" ] && [ "$#" -eq 1 ]; then
        local payload
        payload="$(python "$GUARDIAN_RESPONSE" \
            --state-root "$SEC_STATE" \
            --db-root "$DB_ROOT" \
            --proc-root "$PROC_ROOT" \
            --fs-root "$FS_ROOT" \
            --uid "$(id -u)" \
            status)" || return 1
        python - "$payload" <<'PY'
import json, sys
payload = json.loads(sys.argv[1])
payload["scope"] = "active-only"
if not payload.get("active"):
    payload["history_hint"] = "Completed response history may remain available from maho-guard recovery status or maho guard."
print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
PY
        return
    fi
    python "$GUARDIAN_RESPONSE" \
        --state-root "$SEC_STATE" \
        --db-root "$DB_ROOT" \
        --proc-root "$PROC_ROOT" \
        --fs-root "$FS_ROOT" \
        --uid "$(id -u)" \
        "$@"
}

recovery_command() {
    [ -r "$GUARDIAN_RECOVERY" ] || { echo "maho-guard: live runtime recovery coordinator unavailable" >&2; return 1; }
    if [ "${1:-}" = "status" ] && [ "$#" -eq 1 ]; then
        local payload
        payload="$(python "$GUARDIAN_RECOVERY" \
            --state-root "$SEC_STATE" \
            --db-root "$DB_ROOT" \
            --proc-root "$PROC_ROOT" \
            --fs-root "$FS_ROOT" \
            --runtime-root "$RUNTIME_ROOT" \
            --uid "$(id -u)" \
            status)" || return 1
        python - "$payload" <<'PY'
import json, sys
payload = json.loads(sys.argv[1])
payload["scope"] = "active-and-retained-history"
print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
PY
        return
    fi
    python "$GUARDIAN_RECOVERY" \
        --state-root "$SEC_STATE" \
        --db-root "$DB_ROOT" \
        --proc-root "$PROC_ROOT" \
        --fs-root "$FS_ROOT" \
        --runtime-root "$RUNTIME_ROOT" \
        --uid "$(id -u)" \
        "$@"
}

trace_command() {
    local event_id="${1:-}"
    [ -n "$event_id" ] || { echo "usage: maho-guard trace EVENT_ID [--before-seconds N] [--after-seconds N] [--max-window-events N]" >&2; return 2; }
    shift
    [ -r "$GUARDIAN_TRACE" ] || { echo "maho-guard: Guardian trace engine unavailable" >&2; return 1; }
    python "$GUARDIAN_TRACE" \
        --state-root "$SEC_STATE" \
        --event-id "$event_id" \
        "$@"
}

why_command() {
    local explainer="$ROOT/lib/guardian_explain.py" wanted="" verbose=0 arg
    [ -r "$explainer" ] || { echo "maho-guard: Guardian explainer unavailable" >&2; return 1; }
    for arg in "$@"; do
        case "$arg" in
            --verbose) verbose=1 ;;
            --*) echo "usage: maho-guard why [INCIDENT_ID] [--verbose]" >&2; return 2 ;;
            *) [ -z "$wanted" ] || { echo "usage: maho-guard why [INCIDENT_ID] [--verbose]" >&2; return 2; }; wanted="$arg" ;;
        esac
    done
    args=(python "$explainer" --state-root "$SEC_STATE")
    [ -n "$wanted" ] && args+=(--incident "$wanted")
    [ "$verbose" -eq 1 ] && args+=(--verbose)
    "${args[@]}"
}
incident_command() {
    local id="${1:-}"
    [ -n "$id" ] || { echo "usage: maho-guard incident INCIDENT_ID" >&2; return 1; }
    python "$INCIDENT_ENGINE" show "$id" --state-root "$SEC_STATE" | python -m json.tool
}

pkgbuild_command() {
    local file="${1:-}" result risk status
    [ -n "$file" ] || { echo "usage: maho-guard pkgbuild /path/to/PKGBUILD" >&2; return 1; }
    [ -r "$PREFLIGHT_ENGINE" ] || { echo "maho-guard: preflight engine unavailable" >&2; return 1; }
    result="$(python "$PREFLIGHT_ENGINE" pkgbuild "$file" --state-root "$SEC_STATE")" || return 1
    risk="$(python - "$result" <<'PY'
import json,sys
print(json.loads(sys.argv[1]).get("risk","info"))
PY
)"
    status="observed"
    case "$risk" in high|critical) status="proposed" ;; esac
    maho_event_emit security prevention.pkgbuild-preflight "$status" "$risk" \
        "Maho statically evaluated an AUR PKGBUILD without sourcing or executing it" \
        security.package-build maho-guard "$result" >/dev/null 2>&1 || true
    python - "$result" <<'PY'
import json,sys
r=json.loads(sys.argv[1])
print("Maho PKGBUILD preflight")
print("Risk:      ",r["risk"],f"({r['score']}/100)")
print("Decision:  ",r["recommended_action"])
print("Execution:  PKGBUILD was NOT sourced or executed")
print("Build net:  ",r["network_during_build"])
print("Host home:  ",r["host_home_access"])
if r.get("signals"):
    print("Signals:")
    for s in r["signals"]:
        lines=",".join(str(o.get("line")) for o in s.get("occurrences",[]))
        print(f"  {s['severity'].upper():8} {s['id']}  lines={lines}")
else:
    print("Signals:    none from bounded static rules")
print("Record:     ",r.get("record_path","not-persisted"))
PY
}

aur_build_command() {
    [ -r "$AUR_BUILD" ] || { echo "maho-guard: isolated AUR build capability unavailable" >&2; return 2; }
    shift
    bash "$AUR_BUILD" "$@"
}

doctor_command() {
    echo "Maho security guard"
    parse_python() {
        [ -r "$1" ] && python -c 'import ast,pathlib,sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(), filename=sys.argv[1])' "$1" >/dev/null 2>&1
    }
    parse_python "$INCIDENT_ENGINE" && echo "PASS  incident correlation engine" || echo "FAIL  incident correlation engine"
    parse_python "$PREFLIGHT_ENGINE" && echo "PASS  static package preflight engine" || echo "FAIL  static package preflight engine"
    parse_python "$GUARDIAN_POLICY" && echo "PASS  Guardian severity policy" || echo "FAIL  Guardian severity policy"
    parse_python "$GUARDIAN_ENGINE" && echo "PASS  Guardian recovery authority combiner" || echo "FAIL  Guardian recovery authority combiner"
    parse_python "$GUARDIAN_INCIDENT" && echo "PASS  Guardian incident normalizer/history" || echo "FAIL  Guardian incident normalizer/history"
    parse_python "$GUARDIAN_SERVICE" && echo "PASS  Guardian service incident lifecycle" || echo "FAIL  Guardian service incident lifecycle"
    parse_python "$GUARDIAN_WATCHER" && echo "PASS  Guardian event watcher" || echo "FAIL  Guardian event watcher"
    parse_python "$GUARDIAN_UPDATE" && echo "PASS  Guardian update authority projection" || echo "FAIL  Guardian update authority projection"
    parse_python "$GUARDIAN_LIVE" && echo "PASS  Guardian live world-state projection" || echo "FAIL  Guardian live world-state projection"
    parse_python "$GUARDIAN_RESPONSE" && echo "PASS  Guardian live response coordinator" || echo "FAIL  Guardian live response coordinator"
    parse_python "$GUARDIAN_RECOVERY" && echo "PASS  Guardian live runtime recovery coordinator" || echo "FAIL  Guardian live runtime recovery coordinator"
    parse_python "$GUARDIAN_TRACE" && echo "PASS  Guardian historical trace reconstruction" || echo "FAIL  Guardian historical trace reconstruction"
    [ -r "$AUR_BUILD" ] && echo "PASS  isolated AUR build frontend" || echo "UNAVAILABLE isolated AUR build frontend"
    command -v bwrap >/dev/null 2>&1 && echo "AVAILABLE  bubblewrap isolation backend" || echo "UNAVAILABLE bubblewrap isolation backend"
    echo "INFO  prevention mode: $(prevention_mode)"
    echo "INFO  autonomy target: $(autonomy_level)"
    echo "INFO  unit of reasoning: correlated incident"
    echo "INFO  default interruption: silent; critical confirmed incidents may warrant one notification"
    echo "INFO  automatic host recovery: not authorized"
    echo "INFO  automatic containment: not authorized"
    echo "INFO  Guardian live containment: exact process/target with explicit bounded authorization only"
    echo "INFO  automatic runtime recovery: available for exact confirmed Maho runtime-integrity damage only when the strict automatic recovery predicate succeeds"
    echo "INFO  broader runtime recovery: bounded authorization remains required where applicable"
    echo "INFO  system/kernel/boot recovery: separate authority domains"
    echo "INFO  systemd remains owner of ordinary L1 service restart"
}

case "${1:-}" in
    reconcile) reconcile_command ;;
    status) status_command ;;
    guardian-status) guardian_status_command "${2:-}" ;;
    guardian-update-status) guardian_update_status_command ;;
    world-status) guardian_world_status_command "${2:-}" ;;
    response) shift; response_command "$@" ;;
    recovery) shift; recovery_command "$@" ;;
    trace) shift; trace_command "$@" ;;
    why) shift; why_command "$@" ;;
    incident) incident_command "${2:-}" ;;
    pkgbuild) pkgbuild_command "${2:-}" ;;
    aur-build) aur_build_command "$@" ;;
    doctor) doctor_command ;;
    *)
        cat <<'HELP'
Maho incident-oriented security guard with Guardian severity/recovery reasoning

Usage:
  maho-guard reconcile
  maho-guard status
  maho-guard guardian-status [--json]
  maho-guard guardian-update-status
  maho-guard world-status [--json]
  maho-guard response {reconcile,status,plan,authorize,execute,authorize-release,release} ...
  maho-guard recovery {status,plan,authorize,execute} ...
  maho-guard trace EVENT_ID [--before-seconds N] [--after-seconds N] [--max-window-events N]
  maho-guard why [INCIDENT_ID] [--verbose]
  maho-guard incident INCIDENT_ID
  maho-guard pkgbuild /path/to/PKGBUILD
  maho-guard aur-build /path/to/aur/source [--confirm-risk]
  maho-guard doctor

The security detector remains shadow-only and never mutates the host. Guardian
normalizes correlated incidents, classifies L0-L4, asks the independent
recovery planner what is permitted, and persists an explanation/history record.
world-status is the canonical read-only live system/trust/self-health projection;
guardian-status remains the legacy active-assessment list used by current UI.
Live process containment is available only through exact causal targets plus a
separate bounded user authorization. Live Maho runtime recovery additionally requires
exact immutable-runtime integrity evidence (or an exact contained Maho target), a
verified previous immutable runtime, and a separate single-use user recovery
authorization; it never creates automatic security-driven rollback authority.
Ordinary L1 restart ownership stays with systemd.
PKGBUILD static preflight never executes untrusted instructions. Optional AUR
execution uses the separate bounded Bubblewrap build path and never installs
the produced package automatically.
HELP
        ;;
esac

#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from maho_installer_plan import build_install_plan, probe_disk  # noqa: E402


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(
        prog="maho-installer",
        description="Read-only blank-disk planner for the MahoOS installer.",
    )
    sub = command.add_subparsers(dest="command", required=True)
    plan = sub.add_parser("plan", help="inspect one exact whole disk and emit a non-mutating install plan")
    plan.add_argument("device")
    plan.add_argument("--source-revision", required=True)
    plan.add_argument("--json", action="store_true")
    return command


def main() -> None:
    args = parser().parse_args()
    if args.command != "plan":
        raise SystemExit(2)
    try:
        payload = build_install_plan(
            probe_disk(args.device),
            source_revision=args.source_revision,
        )
    except (OSError, ValueError, RuntimeError) as exc:
        raise SystemExit(f"maho-installer: {exc}") from exc

    if args.json:
        print(json.dumps(payload, sort_keys=True, separators=(",", ":")))
    else:
        print("MahoOS blank-disk install plan")
        print(f"Target: {payload['target']['path']}")
        print(f"Identity: {payload['target']['identity_sha256']}")
        if payload["blockers"]:
            print("Blocked: " + ", ".join(payload["blockers"]))
        else:
            print("Ready for explicit destructive confirmation.")
            print("Confirmation: " + payload["destructive_confirmation"])
        print("Execution authority: none")
    raise SystemExit(0 if payload["ready_for_destructive_confirmation"] else 1)


if __name__ == "__main__":
    main()

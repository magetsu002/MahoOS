#!/usr/bin/env bash

set -u

ROOT="${MAHO_ROOT:-$HOME/Projects/Maho-OS}"
SRC="$ROOT/config/hypr"
LIVE="$HOME/.config/hypr"
AUTHORITY="$ROOT/lib/authority.sh"
INTENT="$ROOT/lib/intent.sh"
STATE_LIB="$ROOT/lib/state.sh"
EVENTS="$ROOT/lib/events.sh"

STATE="$HOME/.local/share/maho"
BACKUPS="$STATE/backups"

mkdir -p "$STATE" "$BACKUPS"

[ -r "$AUTHORITY" ] && source "$AUTHORITY"
[ -r "$INTENT" ] && source "$INTENT"
[ -r "$STATE_LIB" ] && source "$STATE_LIB"
[ -r "$EVENTS" ] && source "$EVENTS"

die() {
    echo "mahoctl: $*" >&2
    return 1
}

config_errors() {
    hyprctl configerrors 2>&1
}

revision() {
    git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf 'uncommitted'
}

require_authority() {
    [ -r "$AUTHORITY" ] || {
        die "authority layer missing: $AUTHORITY"
        return 1
    }

    declare -F maho_owner_get >/dev/null 2>&1 || {
        die "authority layer failed to load"
        return 1
    }
}

require_intent() {
    [ -r "$INTENT" ] && declare -F maho_intent_get >/dev/null 2>&1 || {
        die "intent layer unavailable"
        return 1
    }
}

require_state() {
    [ -r "$STATE_LIB" ] && declare -F maho_state_get >/dev/null 2>&1 || {
        die "state layer unavailable"
        return 1
    }
}

require_events() {
    [ -r "$EVENTS" ] && declare -F maho_event_last >/dev/null 2>&1 || {
        die "event history unavailable"
        return 1
    }
}

doctor() {
    local failed=0

    echo "Maho OS doctor"
    echo

    for cmd in git rsync hyprctl diff sha256sum python; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf 'PASS  %-12s %s\n' "$cmd" "$(command -v "$cmd")"
        else
            printf 'FAIL  %-12s missing\n' "$cmd"
            failed=1
        fi
    done

    echo

    if [ -f "$SRC/hyprland.lua" ]; then
        echo "PASS  source hyprland.lua"
    else
        echo "FAIL  source hyprland.lua missing"
        failed=1
    fi

    if [ -d "$SRC/maho" ]; then
        echo "PASS  source maho modules"
    else
        echo "FAIL  source maho modules missing"
        failed=1
    fi

    if [ -f "$LIVE/hyprland.lua" ]; then
        echo "PASS  live hyprland.lua"
    else
        echo "FAIL  live hyprland.lua missing"
        failed=1
    fi

    if require_authority >/dev/null 2>&1 &&
       maho_owner_validate_file "$MAHO_OWNERSHIP_DEFAULTS" >/dev/null 2>&1 &&
       maho_owner_validate_file "$MAHO_OWNERSHIP_OVERRIDES" >/dev/null 2>&1
    then
        echo "PASS  authority registry"
    else
        echo "FAIL  authority registry"
        failed=1
    fi

    if require_intent >/dev/null 2>&1 &&
       maho_intent_validate_file "$MAHO_INTENT_DEFAULTS" >/dev/null 2>&1 &&
       maho_intent_validate_file "$MAHO_INTENT_OVERRIDES" >/dev/null 2>&1
    then
        echo "PASS  intent registry"
    else
        echo "FAIL  intent registry"
        failed=1
    fi

    if require_state >/dev/null 2>&1; then
        echo "PASS  normalized state layer"
    else
        echo "FAIL  normalized state layer"
        failed=1
    fi

    if require_events >/dev/null 2>&1; then
        echo "PASS  event history layer"
    else
        echo "FAIL  event history layer"
        failed=1
    fi

    echo

    local err
    err="$(config_errors)"

    if [ -z "$err" ]; then
        echo "PASS  Hyprland config errors: none"
    else
        echo "FAIL  Hyprland config errors:"
        echo "$err"
        failed=1
    fi

    return "$failed"
}

status() {
    echo "Maho OS"
    echo
    echo "Repository: $ROOT"
    echo "Revision:   $(revision)"
    echo "Live:       $LIVE"
    echo

    local err
    err="$(config_errors)"

    if [ -z "$err" ]; then
        echo "Hyprland:   green"
    else
        echo "Hyprland:   CONFIG ERROR"
        echo "$err"
    fi

    echo

    if diff -q "$SRC/hyprland.lua" "$LIVE/hyprland.lua" >/dev/null 2>&1 \
       && diff -qr "$SRC/maho" "$LIVE/maho" >/dev/null 2>&1; then
        echo "Managed config: synchronized"
    else
        echo "Managed config: DRIFT DETECTED"
        echo "Run: mahoctl diff"
    fi

    if [ -f "$STATE/active-revision" ]; then
        echo "Applied revision: $(cat "$STATE/active-revision")"
    fi

    if require_authority >/dev/null 2>&1; then
        echo "Theme borders owner: $(maho_owner_get appearance.hyprland.borders 2>/dev/null || printf 'unknown')"
    fi

    if require_intent >/dev/null 2>&1; then
        echo "Dynamic theme intent: $(maho_intent_get appearance.wallpaper.dynamic_theme 2>/dev/null || printf 'unknown')"
    fi
}

show_diff() {
    echo "=== hyprland.lua ==="
    diff -u "$LIVE/hyprland.lua" "$SRC/hyprland.lua" 2>/dev/null || true

    echo
    echo "=== maho modules ==="
    diff -ruN "$LIVE/maho" "$SRC/maho" 2>/dev/null || true
}

make_backup() {
    local ts backup
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="$BACKUPS/$ts"
    mkdir -p "$backup"

    [ ! -f "$LIVE/hyprland.lua" ] || cp -a "$LIVE/hyprland.lua" "$backup/"
    [ ! -d "$LIVE/maho" ] || cp -a "$LIVE/maho" "$backup/"

    printf '%s\n' "$backup"
}

restore_backup() {
    local backup="$1"

    [ -d "$backup" ] || {
        die "backup does not exist: $backup"
        return 1
    }
    [ -f "$backup/hyprland.lua" ] || {
        die "backup missing hyprland.lua"
        return 1
    }

    cp -a "$backup/hyprland.lua" "$LIVE/hyprland.lua"
    rm -rf "$LIVE/maho"
    [ ! -d "$backup/maho" ] || cp -a "$backup/maho" "$LIVE/maho"
}

apply_config() {
    echo "Maho OS apply"
    echo

    doctor >/dev/null || {
        echo "Preflight doctor failed."
        doctor
        return 1
    }

    local backup
    backup="$(make_backup)"

    echo "Backup:"
    echo "$backup"
    echo
    echo "Applying managed configuration..."

    cp -a "$SRC/hyprland.lua" "$LIVE/hyprland.lua"
    rm -rf "$LIVE/maho"
    cp -a "$SRC/maho" "$LIVE/maho"

    if ! hyprctl reload >/dev/null 2>&1; then
        echo "Reload command failed."
        echo "Rolling back..."
        restore_backup "$backup"
        hyprctl reload >/dev/null 2>&1 || true
        echo "Rollback complete."
        return 1
    fi

    sleep 1

    local err
    err="$(config_errors)"
    if [ -n "$err" ]; then
        echo "Configuration failed verification:"
        echo "$err"
        echo
        echo "Rolling back..."
        restore_backup "$backup"
        hyprctl reload >/dev/null 2>&1 || true
        echo "Rollback complete."
        return 1
    fi

    revision > "$STATE/active-revision"
    echo
    echo "PASS"
    echo "Applied revision: $(revision)"
    echo "Hyprland config errors: none"
}

latest_backup() {
    find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null |
        sort -nr |
        head -1 |
        cut -d' ' -f2-
}

rollback_config() {
    local backup="${1:-}"
    [ -n "$backup" ] || backup="$(latest_backup)"

    [ -n "$backup" ] || {
        die "no rollback backup exists"
        return 1
    }

    echo "Restoring:"
    echo "$backup"
    restore_backup "$backup" || return 1

    hyprctl reload >/dev/null 2>&1 || true
    sleep 1

    local err
    err="$(config_errors)"
    if [ -n "$err" ]; then
        echo "WARNING: restored configuration reports errors:"
        echo "$err"
        return 1
    fi

    echo "Rollback verified."
}

capability_line() {
    local available="$1"
    local name="$2"
    local detail="${3:-}"

    if [ "$available" = "1" ]; then
        printf 'AVAILABLE    %-32s %s\n' "$name" "$detail"
    else
        printf 'UNAVAILABLE  %-32s %s\n' "$name" "$detail"
    fi
}

capabilities() {
    echo "Maho capabilities"
    echo

    if command -v hyprctl >/dev/null 2>&1 && hyprctl instances -j >/dev/null 2>&1; then
        capability_line 1 session.hyprland
    else
        capability_line 0 session.hyprland
    fi

    if command -v awww >/dev/null 2>&1; then
        capability_line 1 wallpaper.provider.awww "$(command -v awww)"
    else
        capability_line 0 wallpaper.provider.awww
    fi

    if command -v mpvpaper >/dev/null 2>&1; then
        capability_line 1 wallpaper.provider.mpvpaper "$(command -v mpvpaper)"
    else
        capability_line 0 wallpaper.provider.mpvpaper
    fi

    if command -v matugen >/dev/null 2>&1 && [ -x "$ROOT/theme/backends/matugen/generate" ]; then
        capability_line 1 theme.backend.matugen "$(command -v matugen)"
    else
        capability_line 0 theme.backend.matugen
    fi

    if command -v magick >/dev/null 2>&1 && [ -x "$ROOT/theme/backends/basic/generate" ]; then
        capability_line 1 theme.backend.basic "$(command -v magick)"
    else
        capability_line 0 theme.backend.basic
    fi

    if command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1; then
        capability_line 1 theme.video-frame
    else
        capability_line 0 theme.video-frame
    fi

    if command -v snapper >/dev/null 2>&1; then
        capability_line 1 recovery.snapper "$(command -v snapper)"
    else
        capability_line 0 recovery.snapper
    fi

    if command -v findmnt >/dev/null 2>&1 && [ "$(findmnt -n -o FSTYPE / 2>/dev/null || true)" = "btrfs" ]; then
        capability_line 1 filesystem.btrfs
    else
        capability_line 0 filesystem.btrfs
    fi

    if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        capability_line 1 lifecycle.systemd-user
    else
        capability_line 0 lifecycle.systemd-user
    fi

    echo
    if require_authority >/dev/null 2>&1; then
        echo "Authority"
        maho_owner_list
    else
        echo "Authority unavailable"
    fi

    echo
    if require_intent >/dev/null 2>&1; then
        echo "Intent"
        maho_intent_list
    else
        echo "Intent unavailable"
    fi
}

owner_command() {
    require_authority || return 1

    case "${1:-}" in
        get)
            [ -n "${2:-}" ] || { die "usage: mahoctl owner get RESOURCE"; return 1; }
            maho_owner_get "$2"
            ;;
        set)
            [ -n "${2:-}" ] && [ -n "${3:-}" ] || { die "usage: mahoctl owner set RESOURCE maho|integration|user"; return 1; }
            maho_owner_set "$2" "$3"
            ;;
        unset)
            [ -n "${2:-}" ] || { die "usage: mahoctl owner unset RESOURCE"; return 1; }
            maho_owner_unset "$2"
            printf '%s = %s\n' "$2" "$(maho_owner_get "$2")"
            ;;
        list)
            maho_owner_list
            ;;
        *)
            die "usage: mahoctl owner get|set|unset|list ..."
            return 1
            ;;
    esac
}

intent_command() {
    require_intent || return 1

    case "${1:-}" in
        get)
            [ -n "${2:-}" ] || { die "usage: mahoctl intent get KEY"; return 1; }
            maho_intent_get "$2"
            ;;
        set)
            [ -n "${2:-}" ] && [ -n "${3:-}" ] || { die "usage: mahoctl intent set KEY JSON-VALUE"; return 1; }
            maho_intent_set "$2" "$3"
            ;;
        unset)
            [ -n "${2:-}" ] || { die "usage: mahoctl intent unset KEY"; return 1; }
            maho_intent_unset "$2"
            printf '%s = %s\n' "$2" "$(maho_intent_get "$2")"
            ;;
        list)
            maho_intent_list
            ;;
        *)
            die "usage: mahoctl intent get|set|unset|list ..."
            return 1
            ;;
    esac
}

state_command() {
    require_state || return 1

    case "${1:-}" in
        get)
            [ -n "${2:-}" ] || { die "usage: mahoctl state get DOMAIN"; return 1; }
            maho_state_get "$2"
            ;;
        list)
            maho_state_list
            ;;
        *)
            die "usage: mahoctl state get|list ..."
            return 1
            ;;
    esac
}

history_command() {
    require_events || return 1
    maho_event_tail "${1:-20}"
}

why_command() {
    require_events || return 1

    local selector="${1:-}"
    local event

    if [[ "$selector" == evt-* ]]; then
        event="$(maho_event_show "$selector")" || {
            die "event not found: $selector"
            return 1
        }
    else
        event="$(maho_event_last "$selector")" || {
            if [ -n "$selector" ]; then
                die "no event found for domain: $selector"
            else
                die "no adaptation history exists yet"
            fi
            return 1
        }
    fi

    printf '%s\n' "$event" | python -c '
import json, sys

e = json.load(sys.stdin)
print("Maho adaptation event")
print()
print(f"ID:       {e.get('id', 'unknown')}")
print(f"When:     {e.get('at', 'unknown')}")
print(f"Domain:   {e.get('domain', 'unknown')}")
print(f"Kind:     {e.get('kind', 'unknown')}")
print(f"Status:   {e.get('status', 'unknown')}")
print(f"Risk:     {e.get('risk', 'unknown')}")
print(f"Source:   {e.get('source') or 'unknown'}")
print(f"Resource: {e.get('resource') or 'none'}")
print()
print("Why:")
print(f"  {e.get('summary', 'No explanation recorded.')}")

details = e.get("details") or {}
if details:
    print()
    print("Evidence / details:")
    for key in sorted(details):
        value = details[key]
        if isinstance(value, (dict, list)):
            value = json.dumps(value, sort_keys=True)
        print(f"  {key}: {value}")
'
}

case "${1:-}" in
    doctor)
        doctor
        ;;
    status)
        status
        ;;
    diff)
        show_diff
        ;;
    apply)
        apply_config
        ;;
    rollback)
        rollback_config "${2:-}"
        ;;
    capabilities)
        capabilities
        ;;
    owner)
        owner_command "${2:-}" "${3:-}" "${4:-}"
        ;;
    intent)
        intent_command "${2:-}" "${3:-}" "${4:-}"
        ;;
    state)
        state_command "${2:-}" "${3:-}"
        ;;
    history)
        history_command "${2:-20}"
        ;;
    why)
        why_command "${2:-}"
        ;;
    *)
        cat <<'HELP'
Maho OS control utility

Usage:
  mahoctl status
  mahoctl doctor
  mahoctl diff
  mahoctl apply
  mahoctl rollback [backup-directory]
  mahoctl capabilities

  mahoctl owner list
  mahoctl owner get RESOURCE
  mahoctl owner set RESOURCE maho|integration|user
  mahoctl owner unset RESOURCE

  mahoctl intent list
  mahoctl intent get KEY
  mahoctl intent set KEY JSON-VALUE
  mahoctl intent unset KEY

  mahoctl state list
  mahoctl state get DOMAIN

  mahoctl history [COUNT]
  mahoctl why [EVENT-ID|DOMAIN]

Authority precedence:
  user override > Maho default > safety default (user)

Intent precedence:
  user override > Maho default > unknown (null)

Only resources with effective owner "maho" may be mutated automatically.
Manual user commands remain authoritative.
HELP
        ;;
esac

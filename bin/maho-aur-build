#!/usr/bin/env bash

set -u

ROOT="${MAHO_ROOT:-$HOME/Projects/Maho-OS}"
SEC_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/maho/security"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/maho/security/aur-builds"
PREFLIGHT="$ROOT/lib/security_preflight.py"
EVENTS="$ROOT/lib/events.sh"
BWRAP="${MAHO_BWRAP:-$(command -v bwrap 2>/dev/null || true)}"
MAKEPKG="${MAHO_MAKEPKG:-$(command -v makepkg 2>/dev/null || true)}"
PACMAN="${MAHO_PACMAN:-$(command -v pacman 2>/dev/null || true)}"
YAY="${MAHO_YAY:-$(command -v yay 2>/dev/null || true)}"
GIT="${MAHO_GIT:-$(command -v git 2>/dev/null || true)}"
PACMAN_CONFIG="${MAHO_PACMAN_CONFIG:-/etc/maho/pacman.conf}"
AUR_DISCOVERY="$ROOT/lib/maho_aur_discovery.py"
AUR_SOURCE="$ROOT/lib/maho_aur_source.py"
AUR_ARTIFACT="$ROOT/lib/maho_aur_artifact.py"

if ! { [ -r "$EVENTS" ] && source "$EVENTS" 2>/dev/null; }; then
    maho_event_emit() { return 0; }
fi

emit_event() {
    maho_event_emit security "$@" >/dev/null 2>&1 || true
}

capability_check() {
    [ -n "$BWRAP" ] && [ -x "$BWRAP" ] || {
        echo "maho-aur-build: bubblewrap is unavailable; isolated build capability is unavailable" >&2
        return 2
    }
    [ -n "$MAKEPKG" ] && [ -x "$MAKEPKG" ] || {
        echo "maho-aur-build: makepkg is unavailable; isolated build capability is unavailable" >&2
        return 2
    }
    [ -n "$PACMAN" ] && [ -x "$PACMAN" ] || {
        echo "maho-aur-build: pacman package inspection is unavailable" >&2
        return 2
    }
    [ -f "$PACMAN_CONFIG" ] && [ ! -L "$PACMAN_CONFIG" ] || {
        echo "maho-aur-build: canonical Maho Pacman authority is unavailable: $PACMAN_CONFIG" >&2
        return 2
    }
    [ -r "$PREFLIGHT" ] || {
        echo "maho-aur-build: static preflight engine is unavailable" >&2
        return 2
    }
    [ -r "$AUR_ARTIFACT" ] || {
        echo "maho-aur-build: AUR artifact identity engine is unavailable" >&2
        return 2
    }
}

stage_source() {
    local source="$1"
    python - "$source" "$CACHE_ROOT" <<'PY'
import hashlib,os,shutil,sys
from pathlib import Path
src=Path(sys.argv[1]).expanduser().resolve(); cache=Path(sys.argv[2])
if not src.is_dir(): raise SystemExit(f"AUR source directory does not exist: {src}")
pkg=src/'PKGBUILD'
if not pkg.is_file(): raise SystemExit(f"PKGBUILD missing: {pkg}")
digest=hashlib.sha256(pkg.read_bytes()).hexdigest()
stage=cache/f"aur-{digest[:20]}"
cache.mkdir(parents=True,exist_ok=True); os.chmod(cache,0o700)
if stage.exists(): shutil.rmtree(stage)
ignore=shutil.ignore_patterns('.git','.SRCINFO','pkg','src','*.pkg.tar.*','*.log')
shutil.copytree(src,stage,symlinks=True,ignore=ignore)
root=stage.resolve()
for path in stage.rglob('*'):
    if not path.is_symlink(): continue
    target=os.readlink(path)
    if target.startswith('/'):
        raise SystemExit(f"AUR source absolute symlink is refused: {path.relative_to(stage)}")
    resolved=(path.parent/target).resolve(strict=False)
    if root != resolved and root not in resolved.parents:
        raise SystemExit(f"AUR source escaping symlink is refused: {path.relative_to(stage)}")
os.chmod(stage,0o700)
print(stage)
PY
}

sandbox_common() {
    local stage="$1"
    printf '%s\0' \
        --die-with-parent \
        --new-session \
        --unshare-user-try \
        --unshare-pid \
        --unshare-ipc \
        --unshare-uts \
        --cap-drop ALL \
        --ro-bind / / \
        --proc /proc \
        --dev /dev \
        --tmpfs /home \
        --tmpfs /root \
        --tmpfs /tmp \
        --tmpfs /var/tmp \
        --tmpfs /run/user \
        --bind "$stage" /build \
        --chdir /build \
        --setenv HOME /home/maho \
        --setenv XDG_CONFIG_HOME /home/maho/.config \
        --setenv XDG_CACHE_HOME /home/maho/.cache \
        --setenv XDG_STATE_HOME /home/maho/.local/state \
        --unsetenv SSH_AUTH_SOCK \
        --unsetenv GPG_AGENT_INFO \
        --unsetenv DBUS_SESSION_BUS_ADDRESS \
        --unsetenv XDG_RUNTIME_DIR
}

run_sandbox() {
    local stage="$1" phase="$2"
    local -a args=()
    while IFS= read -r -d '' item; do args+=("$item"); done < <(sandbox_common "$stage")
    if [ "$phase" = build ]; then
        args+=(--unshare-net)
    fi
    if [ "$phase" = fetch ]; then
        args+=(-- "$MAKEPKG" --verifysource --noconfirm)
    else
        args+=(-- "$MAKEPKG" --noconfirm --cleanbuild --clean --force)
    fi
    "$BWRAP" "${args[@]}"
}

record_result() {
    local stage="$1" preflight="$2" status="$3" phase="$4"
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" python "$AUR_ARTIFACT" \
        --state-root "$SEC_STATE" \
        --stage "$stage" \
        --preflight-json "$preflight" \
        --status "$status" \
        --phase "$phase" \
        --pacman-config "$PACMAN_CONFIG" \
        --pacman "$PACMAN"
}

pretty_result() {
    python - "$1" <<'PY_PRETTY'
import json,sys
r=json.loads(sys.argv[1])
print('Maho isolated AUR build')
print('Status:        ',r['status'])
print('Phase:         ',r['phase'])
print('Preflight:     ',r['preflight_risk'],f"({r['preflight_score']}/100)")
print('Source:        ',r.get('source_tree_sha256','unknown'))
print('Stage:         ',r['stage'])
print('Host home:      hidden')
print('Build network:  isolated')
print('Capabilities:   dropped')
print('Auto install:   no')
if r.get('rejection'):
    print('Rejected:      ',r['rejection'])
if r.get('packages'):
    print('Artifacts:')
    for p in r['packages']:
        print(f"  {p['name']} {p['version']}  {p['route']}  {p['artifact_id']}")
else:
    print('Artifacts:      none accepted')
PY_PRETTY
}

build_command() {
    local source="${1:-}" confirm="${2:-}" preflight risk stage result
    [ -n "$source" ] || { echo "usage: maho-aur-build /path/to/aur/source [--confirm-risk]" >&2; return 1; }
    capability_check || return $?

    preflight="$(python "$PREFLIGHT" pkgbuild "$source/PKGBUILD" --state-root "$SEC_STATE")" || return 1
    risk="$(python - "$preflight" <<'PY'
import json,sys
print(json.loads(sys.argv[1]).get('risk','info'))
PY
)"

    case "$risk" in
        high|critical)
            if [ "$confirm" != "--confirm-risk" ]; then
                echo "Maho refused to execute a high-risk PKGBUILD even inside the sandbox without one explicit review decision." >&2
                echo "Review:  maho-guard pkgbuild $source/PKGBUILD" >&2
                echo "Build:   maho-aur-build $source --confirm-risk" >&2
                return 3
            fi
            ;;
    esac

    stage="$(stage_source "$source")" || return 1

    if ! run_sandbox "$stage" fetch; then
        result="$(record_result "$stage" "$preflight" failed fetch)"
        emit_event prevention.aur-build-failed failed "$risk" \
            "Isolated AUR source-fetch/verification phase failed; nothing was installed" \
            security.package-build maho-aur-build "$result"
        pretty_result "$result"
        return 1
    fi

    if ! run_sandbox "$stage" build; then
        result="$(record_result "$stage" "$preflight" failed build)"
        emit_event prevention.aur-build-failed failed "$risk" \
            "Isolated AUR build phase failed; nothing was installed" \
            security.package-build maho-aur-build "$result"
        pretty_result "$result"
        return 1
    fi

    result="$(record_result "$stage" "$preflight" verified complete)"
    local artifact_rc=$?
    if [ "$artifact_rc" -ne 0 ]; then
        emit_event prevention.aur-build-rejected failed "$risk" \
            "AUR output was rejected by canonical repository ownership or exact artifact verification; nothing was installed" \
            security.package-build maho-aur-build "$result"
        pretty_result "$result"
        return "$artifact_rc"
    fi
    emit_event prevention.aur-build verified "$risk" \
        "AUR package became a Maho-owned exact artifact after provenance and effect analysis; output was not installed automatically" \
        security.package-build maho-aur-build "$result"
    pretty_result "$result"
}

doctor_command() {
    echo "Maho isolated AUR build"
    [ -r "$PREFLIGHT" ] && python -c 'import ast,pathlib,sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(), filename=sys.argv[1])' "$PREFLIGHT" >/dev/null 2>&1 && echo "PASS  static preflight" || echo "FAIL  static preflight"
    [ -n "$BWRAP" ] && [ -x "$BWRAP" ] && echo "AVAILABLE  bubblewrap: $BWRAP" || echo "UNAVAILABLE bubblewrap"
    [ -n "$MAKEPKG" ] && [ -x "$MAKEPKG" ] && echo "AVAILABLE  makepkg: $MAKEPKG" || echo "UNAVAILABLE makepkg"
    [ -n "$PACMAN" ] && [ -x "$PACMAN" ] && echo "AVAILABLE  pacman: $PACMAN" || echo "UNAVAILABLE pacman"
    [ -n "$YAY" ] && [ -x "$YAY" ] && echo "AVAILABLE  yay: $YAY" || echo "UNAVAILABLE yay"
    [ -n "$GIT" ] && [ -x "$GIT" ] && echo "AVAILABLE  git: $GIT" || echo "UNAVAILABLE git"
    [ -f "$PACMAN_CONFIG" ] && [ ! -L "$PACMAN_CONFIG" ] && echo "PASS  repository authority: $PACMAN_CONFIG" || echo "FAIL  repository authority: $PACMAN_CONFIG"
    echo "INFO  host root: read-only"
    echo "INFO  host home/root/run-user: hidden"
    echo "INFO  source fetch: network available in sandbox"
    echo "INFO  build/package phase: network namespace isolated"
    echo "INFO  automatic installation: never"
    echo "INFO  high/critical static preflight: explicit --confirm-risk required"
}

fetch_command() {
    local package="${1:-}" expected="${2:-}"
    [ -n "$package" ] || { echo "usage: maho-aur-build fetch <package> [expected-version]" >&2; return 1; }
    [ -n "$YAY" ] && [ -x "$YAY" ] || { echo "maho-aur-build: yay is unavailable for AUR source fetch" >&2; return 2; }
    [ -n "$PACMAN" ] && [ -x "$PACMAN" ] || { echo "maho-aur-build: pacman is unavailable for repository ownership checks" >&2; return 2; }
    [ -n "$GIT" ] && [ -x "$GIT" ] || { echo "maho-aur-build: git is unavailable for AUR source identity" >&2; return 2; }
    [ -f "$PACMAN_CONFIG" ] && [ ! -L "$PACMAN_CONFIG" ] || {
        echo "maho-aur-build: canonical Maho Pacman authority is unavailable: $PACMAN_CONFIG" >&2
        return 2
    }
    [ -r "$AUR_SOURCE" ] || { echo "maho-aur-build: AUR source authority is unavailable" >&2; return 2; }
    local -a args=(
        "$AUR_SOURCE" "$package"
        --cache-root "$CACHE_ROOT"
        --config "$PACMAN_CONFIG"
        --yay "$YAY"
        --pacman "$PACMAN"
        --git "$GIT"
    )
    [ -z "$expected" ] || args+=(--expected-version "$expected")
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" python "${args[@]}"
}

discover_command() {
    [ -n "$YAY" ] && [ -x "$YAY" ] || {
        echo "maho-aur-build: yay is unavailable for AUR metadata discovery" >&2
        return 2
    }
    [ -n "$PACMAN" ] && [ -x "$PACMAN" ] || {
        echo "maho-aur-build: pacman is unavailable for repository authority checks" >&2
        return 2
    }
    [ -f "$PACMAN_CONFIG" ] && [ ! -L "$PACMAN_CONFIG" ] || {
        echo "maho-aur-build: canonical Maho Pacman authority is unavailable: $PACMAN_CONFIG" >&2
        return 2
    }
    PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" python "$AUR_DISCOVERY" \
        --config "$PACMAN_CONFIG" --yay "$YAY" --pacman "$PACMAN" "$@"
}

case "${1:-}" in
    build) shift; build_command "$@" ;;
    fetch) shift; fetch_command "$@" ;;
    discover) shift; discover_command "$@" ;;
    doctor) doctor_command ;;
    *)
        if [ -n "${1:-}" ] && [ "${1#-}" = "$1" ]; then
            build_command "$@"
        else
            cat <<'HELP'
Maho isolated AUR build

Usage:
  maho-aur-build /path/to/aur/source
  maho-aur-build /path/to/aur/source --confirm-risk
  maho-aur-build fetch <package> [expected-version]
  maho-aur-build discover [--json]
  maho-aur-build doctor

The source directory is copied into Maho cache first. PKGBUILD preflight never
executes it. If execution proceeds, both makepkg phases run under Bubblewrap
with a read-only host root, hidden host homes/runtime secrets, isolated process
namespaces and dropped capabilities. The build/package phase additionally has
no network. Produced package files stay in the private staging directory and are converted
into exact Maho artifact identities only after canonical repository ownership,
source provenance and file effects are verified. They are never installed
automatically. This reduces blast radius; it is not a
kernel/VM security boundary and cannot guarantee safety against kernel exploits.
HELP
        fi
        ;;
esac

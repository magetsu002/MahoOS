#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
lib = root / "lib"
if (lib / "guardian_native_admission.py").is_file():
    sys.path.insert(0, str(lib))
else:
    sys.path.insert(0, "/usr/lib/maho/lib")

from guardian_native_admission import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())

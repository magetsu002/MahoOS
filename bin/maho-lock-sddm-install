#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
THEME_SOURCE="$ROOT/config/sddm/maho-lock"
SESSION_SOURCE="$ROOT/config/sddm/maho.desktop"
SESSION_LAUNCH_SOURCE="$ROOT/bin/maho-session-launch"
LOCK_ASSETS="$ROOT/config/quickshell/maho-lock/assets"
LOCK_ICONS="$ROOT/config/quickshell/maho-lock/icons"

THEME_ROOT="${MAHO_SDDM_THEME_ROOT:-/usr/share/sddm/themes}"
CONFIG_ROOT="${MAHO_SDDM_CONFIG_ROOT:-/etc/sddm.conf.d}"
STATE_ROOT="${MAHO_SDDM_STATE_ROOT:-/var/lib/maho-lock-sddm}"
THEME_TARGET="$THEME_ROOT/maho-lock"
CONFIG_TARGET="$CONFIG_ROOT/90-maho-lock.conf"
SESSION_ROOT="${MAHO_SDDM_SESSION_ROOT:-/usr/share/wayland-sessions}"
SESSION_LAUNCH_ROOT="${MAHO_SDDM_SESSION_LAUNCH_ROOT:-/usr/local/lib/maho}"
SESSION_TARGET="$SESSION_ROOT/maho.desktop"
SESSION_LAUNCH_TARGET="$SESSION_LAUNCH_ROOT/maho-session-launch"
MARKER="managed-by-maho-lock-sddm-v1"
CONFIG_MARKER="# managed-by: maho-lock-sddm v1"

say() { printf '%s\n' "$*"; }
die() { say "maho-lock-sddm-install: $*" >&2; return 1; }

invoking_user() {
    if [ -n "${MAHO_SDDM_USER:-}" ] && [ "$MAHO_SDDM_USER" != root ]; then
        printf '%s\n' "$MAHO_SDDM_USER"
    elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        printf '%s\n' "$SUDO_USER"
    else
        id -un
    fi
}

user_home() {
    local name="$1" entry
    entry="$(getent passwd "$name")" || return 1
    printf '%s\n' "$entry" | awk -F: '{print $6}'
}

managed_theme() {
    [ -f "$THEME_TARGET/.managed-by-maho-lock-sddm" ] \
        && grep -Fxq "$MARKER" "$THEME_TARGET/.managed-by-maho-lock-sddm"
}

managed_config() {
    [ -f "$CONFIG_TARGET" ] && grep -Fxq "$CONFIG_MARKER" "$CONFIG_TARGET"
}

managed_session() {
    [ -f "$SESSION_TARGET" ] && grep -Fxq 'Name=MahoOS' "$SESSION_TARGET" \
        && grep -Fxq 'Exec=/usr/local/lib/maho/maho-session-launch' "$SESSION_TARGET"
}

managed_session_launcher() {
    [ -f "$SESSION_LAUNCH_TARGET" ] \
        && grep -Fxq '# managed-by: maho-sddm-session v1' "$SESSION_LAUNCH_TARGET"
}

require_root() {
    [ "$(id -u)" -eq 0 ] && return 0

    if [ "${MAHO_SDDM_ALLOW_UNPRIVILEGED:-0}" = 1 ] \
        && [ "$THEME_ROOT" != /usr/share/sddm/themes ] \
        && [ "$CONFIG_ROOT" != /etc/sddm.conf.d ] \
        && [ "$STATE_ROOT" != /var/lib/maho-lock-sddm ] \
        && [ "$SESSION_ROOT" != /usr/share/wayland-sessions ] \
        && [ "$SESSION_LAUNCH_ROOT" != /usr/local/lib/maho ]; then
        return 0
    fi

    die "system installation requires root; run: sudo bash bin/maho-lock-sddm-install install"
}

profile_wallpaper() {
    local home="$1" profile="$home/.local/state/maho/lock/profile.json"

    python - "$profile" <<'PY_PROFILE'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
payload = {}
try:
    payload = json.loads(path.read_text())
except (OSError, ValueError, TypeError):
    pass

value = payload.get("wallpaperPath", "")
print(value if isinstance(value, str) else "")
PY_PROFILE
}

preflight() {
    local failed=0 dependency file

    for dependency in python getent awk install cp mv; do
        command -v "$dependency" >/dev/null 2>&1 \
            && printf 'PASS  dependency %-14s %s\n' "$dependency" "$(command -v "$dependency")" \
            || { printf 'FAIL  dependency %-14s missing\n' "$dependency"; failed=1; }
    done

    for file in Main.qml MahoSddmIcon.qml MahoSddmActionButton.qml metadata.desktop theme.conf; do
        [ -r "$THEME_SOURCE/$file" ] \
            && say "PASS  theme source $file" \
            || { say "FAIL  theme source $file"; failed=1; }
    done
    [ -r "$SESSION_SOURCE" ] \
        && say "PASS  MahoOS SDDM session source" \
        || { say "FAIL  MahoOS SDDM session source"; failed=1; }
    [ -x "$SESSION_LAUNCH_SOURCE" ] \
        && say "PASS  MahoOS session lifecycle wrapper" \
        || { say "FAIL  MahoOS session lifecycle wrapper"; failed=1; }

    grep -Fxq 'QtVersion=6' "$THEME_SOURCE/metadata.desktop" \
        && say "PASS  SDDM Qt 6 greeter selection" \
        || { say "FAIL  SDDM theme does not select the Qt 6 greeter"; failed=1; }

    [ -r "$LOCK_ASSETS/maho-lock-dusk.jpg" ] \
        && say "PASS  fallback wallpaper" \
        || { say "FAIL  fallback wallpaper"; failed=1; }
    [ -r "$LOCK_ASSETS/Nunito-Variable.ttf" ] \
        && say "PASS  rounded typography asset" \
        || { say "FAIL  rounded typography asset"; failed=1; }

    for file in lock.svg eye.svg eye-off.svg power.svg keyboard.svg; do
        [ -r "$LOCK_ICONS/$file" ] \
            && say "PASS  shared vector icon $file" \
            || { say "FAIL  shared vector icon $file"; failed=1; }
    done
    for file in restart.svg session.svg; do
        [ -r "$THEME_SOURCE/icons/$file" ] \
            && say "PASS  SDDM vector icon $file" \
            || { say "FAIL  SDDM vector icon $file"; failed=1; }
    done

    return "$failed"
}

build_theme() {
    local stage="$1" account home wallpaper icon

    account="$(invoking_user)"
    home="$(user_home "$account")"
    wallpaper="$(profile_wallpaper "$home")"

    mkdir -p "$stage/assets/icons"
    install -m 0644 "$THEME_SOURCE/Main.qml" "$stage/Main.qml"
    install -m 0644 "$THEME_SOURCE/MahoSddmIcon.qml" "$stage/MahoSddmIcon.qml"
    install -m 0644 "$THEME_SOURCE/MahoSddmActionButton.qml" "$stage/MahoSddmActionButton.qml"
    install -m 0644 "$THEME_SOURCE/metadata.desktop" "$stage/metadata.desktop"
    install -m 0644 "$THEME_SOURCE/theme.conf" "$stage/theme.conf"
    install -m 0644 "$LOCK_ASSETS/Nunito-Variable.ttf" "$stage/assets/Nunito-Variable.ttf"
    for icon in lock.svg eye.svg eye-off.svg power.svg keyboard.svg; do
        install -m 0644 "$LOCK_ICONS/$icon" "$stage/assets/icons/$icon"
    done
    for icon in restart.svg session.svg; do
        install -m 0644 "$THEME_SOURCE/icons/$icon" "$stage/assets/icons/$icon"
    done

    if [ -n "$wallpaper" ] && [ -f "$wallpaper" ] && [ -r "$wallpaper" ]; then
        install -m 0644 "$wallpaper" "$stage/assets/wallpaper"
        say "PASS  staged selected wallpaper $wallpaper" >&2
    else
        install -m 0644 "$LOCK_ASSETS/maho-lock-dusk.jpg" "$stage/assets/wallpaper"
        say "INFO  selected wallpaper unavailable; staged bundled fallback" >&2
    fi

    sed -i \
        -e "s/@DEFAULT_USER@/$account/g" \
        "$stage/theme.conf"
    printf '%s\n' "$MARKER" > "$stage/.managed-by-maho-lock-sddm"
    chmod -R a+rX "$stage"
}

stage() {
    local target="${1:-}"
    preflight || return 1
    if [ -z "$target" ]; then
        target="$(mktemp -d /tmp/maho-lock-sddm-theme.XXXXXX)"
    else
        [ ! -e "$target" ] || { die "stage target already exists: $target"; return 1; }
        mkdir -p "$target"
    fi
    build_theme "$target"
    say "PASS  staged SDDM theme $target"
}

install_theme() {
    local stamp backup stage_path config_tmp session_tmp launcher_tmp
    local had_theme=0 had_config=0 had_session=0 had_launcher=0 committed=0

    require_root || return 1
    preflight || return 1

    if [ -e "$THEME_TARGET" ] && ! managed_theme; then
        die "refusing to replace unmanaged theme: $THEME_TARGET"
        return 1
    fi
    if [ -e "$CONFIG_TARGET" ] && ! managed_config; then
        die "refusing to replace unmanaged config: $CONFIG_TARGET"
        return 1
    fi
    if [ -e "$SESSION_TARGET" ] && ! managed_session; then
        die "refusing to replace unmanaged session: $SESSION_TARGET"
        return 1
    fi
    if [ -e "$SESSION_LAUNCH_TARGET" ] && ! managed_session_launcher; then
        die "refusing to replace unmanaged session launcher: $SESSION_LAUNCH_TARGET"
        return 1
    fi

    mkdir -p "$THEME_ROOT" "$CONFIG_ROOT" "$STATE_ROOT/backups" "$SESSION_ROOT" "$SESSION_LAUNCH_ROOT"
    stamp="$(date +%Y%m%d-%H%M%S-%N)"
    backup="$STATE_ROOT/backups/$stamp"
    stage_path="$THEME_ROOT/.maho-lock.stage.$$"
    config_tmp="$CONFIG_ROOT/.90-maho-lock.conf.$$"
    session_tmp="$SESSION_ROOT/.maho.desktop.$$"
    launcher_tmp="$SESSION_LAUNCH_ROOT/.maho-session-launch.$$"
    mkdir -m 0700 "$backup" "$stage_path"

    build_theme "$stage_path"

    if managed_theme; then
        mv "$THEME_TARGET" "$backup/theme"
        had_theme=1
    fi
    if managed_config; then
        mv "$CONFIG_TARGET" "$backup/90-maho-lock.conf"
        had_config=1
    fi
    if managed_session; then
        mv "$SESSION_TARGET" "$backup/maho.desktop"
        had_session=1
    fi
    if managed_session_launcher; then
        mv "$SESSION_LAUNCH_TARGET" "$backup/maho-session-launch"
        had_launcher=1
    fi

    rollback_install() {
        local rc=$?
        [ "$committed" -eq 1 ] && return "$rc"
        rm -rf -- "$THEME_TARGET" "$stage_path"
        rm -f -- "$CONFIG_TARGET" "$config_tmp"
        rm -f -- "$SESSION_TARGET" "$session_tmp" "$SESSION_LAUNCH_TARGET" "$launcher_tmp"
        [ "$had_theme" -eq 1 ] && mv "$backup/theme" "$THEME_TARGET"
        [ "$had_config" -eq 1 ] && mv "$backup/90-maho-lock.conf" "$CONFIG_TARGET"
        [ "$had_session" -eq 1 ] && mv "$backup/maho.desktop" "$SESSION_TARGET"
        [ "$had_launcher" -eq 1 ] && mv "$backup/maho-session-launch" "$SESSION_LAUNCH_TARGET"
        return "$rc"
    }
    trap rollback_install EXIT

    mv "$stage_path" "$THEME_TARGET"
    {
        printf '%s\n' "$CONFIG_MARKER"
        printf '%s\n' '[Theme]'
        printf '%s\n' 'Current=maho-lock'
    } > "$config_tmp"
    chmod 0644 "$config_tmp"
    mv "$config_tmp" "$CONFIG_TARGET"
    install -m 0644 "$SESSION_SOURCE" "$session_tmp"
    mv "$session_tmp" "$SESSION_TARGET"
    install -m 0755 "$SESSION_LAUNCH_SOURCE" "$launcher_tmp"
    mv "$launcher_tmp" "$SESSION_LAUNCH_TARGET"

    committed=1
    trap - EXIT
    say "PASS  installed SDDM theme $THEME_TARGET"
    say "PASS  selected persistent SDDM theme in $CONFIG_TARGET"
    say "PASS  installed SDDM-owned MahoOS session $SESSION_TARGET"
    say "PASS  installed compositor lifecycle wrapper $SESSION_LAUNCH_TARGET"
    say "PASS  no SDDM restart performed; the current graphical session is untouched"
    say "Backup: $backup"
}

status() {
    local failed=0 icon

    if managed_theme; then
        say "PASS  managed SDDM theme $THEME_TARGET"
    else
        say "FAIL  managed SDDM theme missing"
        failed=1
    fi

    if managed_config && grep -Fxq 'Current=maho-lock' "$CONFIG_TARGET"; then
        say "PASS  persistent SDDM selection $CONFIG_TARGET"
    else
        say "FAIL  persistent SDDM selection missing"
        failed=1
    fi
    if managed_session; then
        say "PASS  SDDM MahoOS session authority $SESSION_TARGET"
    else
        say "FAIL  SDDM MahoOS session authority missing"
        failed=1
    fi
    if managed_session_launcher; then
        say "PASS  MahoOS compositor lifecycle wrapper $SESSION_LAUNCH_TARGET"
    else
        say "FAIL  MahoOS compositor lifecycle wrapper missing"
        failed=1
    fi

    [ -r "$THEME_TARGET/assets/wallpaper" ] \
        && say "PASS  SDDM-readable wallpaper asset" \
        || { say "FAIL  SDDM-readable wallpaper asset"; failed=1; }
    [ -r "$THEME_TARGET/Main.qml" ] \
        && say "PASS  SDDM greeter entrypoint" \
        || { say "FAIL  SDDM greeter entrypoint"; failed=1; }
    [ -r "$THEME_TARGET/MahoSddmActionButton.qml" ] \
        && say "PASS  SDDM interactive action component" \
        || { say "FAIL  SDDM interactive action component"; failed=1; }
    grep -Fq 'Math.min(2.4' "$THEME_TARGET/Main.qml" \
        && say "PASS  SDDM HiDPI composition policy" \
        || { say "FAIL  SDDM HiDPI composition policy"; failed=1; }
    if grep -Fq 'id: eyePointer' "$THEME_TARGET/Main.qml" \
        && grep -Fq 'visible: root.keyboardLayoutCount > 1' "$THEME_TARGET/Main.qml" \
        && grep -Fq 'visible: root.sessionNames.length > 1' "$THEME_TARGET/Main.qml"; then
        say "PASS  SDDM live interaction guards"
    else
        say "FAIL  SDDM live interaction guards"
        failed=1
    fi
    for icon in lock.svg eye.svg eye-off.svg power.svg keyboard.svg restart.svg session.svg; do
        [ -r "$THEME_TARGET/assets/icons/$icon" ] \
            && say "PASS  SDDM vector icon $icon" \
            || { say "FAIL  SDDM vector icon $icon"; failed=1; }
    done
    grep -Fxq 'QtVersion=6' "$THEME_TARGET/metadata.desktop" \
        && say "PASS  installed theme selects the Qt 6 greeter" \
        || { say "FAIL  installed theme does not select the Qt 6 greeter"; failed=1; }

    # On the real system, persistence includes the display-manager authority,
    # not only Maho-owned theme/session files. Sandbox contract tests use
    # redirected roots and deliberately skip this host-level check.
    if [ "$THEME_ROOT" = /usr/share/sddm/themes ] \
        && [ "$CONFIG_ROOT" = /etc/sddm.conf.d ] \
        && [ "$SESSION_ROOT" = /usr/share/wayland-sessions ]; then
        expected_service="$(systemctl show sddm.service -p FragmentPath --value 2>/dev/null || true)"
        display_manager="$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)"
        if systemctl is-enabled --quiet sddm.service 2>/dev/null \
            && [ -n "$expected_service" ] \
            && [ "$display_manager" = "$expected_service" ]; then
            say "PASS  boot display-manager authority -> sddm.service"
        else
            say "FAIL  boot display-manager authority is not persistent SDDM"
            failed=1
        fi
    fi

    return "$failed"
}

uninstall_theme() {
    local stamp backup

    require_root || return 1
    if [ -e "$THEME_TARGET" ] && ! managed_theme; then
        die "refusing to remove unmanaged theme: $THEME_TARGET"
        return 1
    fi
    if [ -e "$CONFIG_TARGET" ] && ! managed_config; then
        die "refusing to remove unmanaged config: $CONFIG_TARGET"
        return 1
    fi
    if [ -e "$SESSION_TARGET" ] && ! managed_session; then
        die "refusing to remove unmanaged session: $SESSION_TARGET"
        return 1
    fi
    if [ -e "$SESSION_LAUNCH_TARGET" ] && ! managed_session_launcher; then
        die "refusing to remove unmanaged session launcher: $SESSION_LAUNCH_TARGET"
        return 1
    fi

    mkdir -p "$STATE_ROOT/backups"
    stamp="$(date +%Y%m%d-%H%M%S-%N)"
    backup="$STATE_ROOT/backups/$stamp"
    mkdir -m 0700 "$backup"
    managed_theme && mv "$THEME_TARGET" "$backup/theme"
    managed_config && mv "$CONFIG_TARGET" "$backup/90-maho-lock.conf"
    managed_session && mv "$SESSION_TARGET" "$backup/maho.desktop"
    managed_session_launcher && mv "$SESSION_LAUNCH_TARGET" "$backup/maho-session-launch"
    say "PASS  removed managed SDDM selection and theme"
    say "Backup: $backup"
}

case "${1:-}" in
    preflight) preflight ;;
    stage) shift; stage "${1:-}" ;;
    install) install_theme ;;
    status) status ;;
    uninstall) uninstall_theme ;;
    *)
        cat <<'EOF_HELP'
Maho Lock SDDM integration

Usage:
  bash bin/maho-lock-sddm-install preflight
  bash bin/maho-lock-sddm-install stage [DIRECTORY]
  sudo bash bin/maho-lock-sddm-install install
  sudo bash bin/maho-lock-sddm-install status
  sudo bash bin/maho-lock-sddm-install uninstall

Install copies the current Maho Lock wallpaper into an SDDM-readable,
managed no-avatar theme and persistently selects it for the next boot. It never restarts
SDDM, so installing it does not terminate the current graphical session.
EOF_HELP
        exit 2
        ;;
esac

#!/usr/bin/env bash
set -euo pipefail

ROOT="${MAHO_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
SOURCE="$ROOT/apps/maho-files"
PACKAGED_BINARY="$SOURCE/prebuilt/maho-files"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
BUILD="${MAHO_FILES_BUILD_DIR:-$CACHE_HOME/maho/files-qml-build}"
BUILD_BINARY="$BUILD/maho-files"
FINGERPRINT_HELPER="$SOURCE/source-fingerprint.py"

usage() {
    cat <<'EOF'
Usage: maho-files <command> [args]

Commands:
  doctor          Check native Maho Files runtime/build readiness.
  configure       Configure the isolated source-build directory.
  build           Configure and compile Maho Files from source.
  run [LOCATION]  Run the packaged binary, or build from source when developing.
  clean           Remove only the isolated Maho Files source-build directory.
EOF
}

need_command() {
    command -v "$1" >/dev/null 2>&1
}

selected_binary() {
    if [ -n "${MAHO_FILES_BINARY:-}" ]; then
        printf '%s\n' "$MAHO_FILES_BINARY"
    elif [ -x "$PACKAGED_BINARY" ]; then
        printf '%s\n' "$PACKAGED_BINARY"
    else
        printf '%s\n' "$BUILD_BINARY"
    fi
}

source_fingerprint() {
    [ -r "$FINGERPRINT_HELPER" ] || {
        echo "maho-files: source fingerprint helper is missing" >&2
        return 1
    }
    python3 "$FINGERPRINT_HELPER" "$SOURCE"
}

binary_fingerprint() {
    local binary="$1" marker
    [ -x "$binary" ] || return 1
    marker="$(LC_ALL=C grep -aoEm1 'MAHO_FILES_SOURCE_FINGERPRINT=[0-9a-f]{64}' "$binary" 2>/dev/null || true)"
    [ -n "$marker" ] || return 1
    printf '%s\n' "${marker#MAHO_FILES_SOURCE_FINGERPRINT=}"
}

verified_binary() {
    local binary expected actual=""
    binary="$(selected_binary)"
    expected="$(source_fingerprint)" || return 1
    actual="$(binary_fingerprint "$binary" 2>/dev/null || true)"

    if [ "$actual" = "$expected" ]; then
        printf '%s\n' "$binary"
        return 0
    fi

    if [ "$binary" = "$BUILD_BINARY" ] && [ -z "${MAHO_FILES_BINARY:-}" ] \
        && [ ! -x "$PACKAGED_BINARY" ]; then
        if [ -x "$binary" ]; then
            echo "INFO  cached Maho Files artifact does not match current source; rebuilding" >&2
        fi
        build >&2
        actual="$(binary_fingerprint "$binary" 2>/dev/null || true)"
        if [ "$actual" = "$expected" ]; then
            printf '%s\n' "$binary"
            return 0
        fi
        echo "maho-files: source build did not produce the expected artifact identity" >&2
        return 1
    fi

    echo "maho-files: refusing native binary with stale or missing source identity: $binary" >&2
    echo "maho-files: expected source fingerprint $expected" >&2
    echo "maho-files: actual source fingerprint ${actual:-missing}" >&2
    return 1
}

doctor() {
    local failed=0 binary expected actual=""
    binary="$(selected_binary)"
    expected="$(source_fingerprint 2>/dev/null || true)"
    actual="$(binary_fingerprint "$binary" 2>/dev/null || true)"

    echo "Maho Files native frontend doctor"
    echo

    if [ -x "$binary" ] && [ -n "$expected" ] && [ "$actual" = "$expected" ]; then
        printf 'PASS  %-14s %s\n' "native binary" "$binary"
        printf 'PASS  %-14s %s\n' "source identity" "$expected"
    elif [ -x "$PACKAGED_BINARY" ] || [ -n "${MAHO_FILES_BINARY:-}" ]; then
        printf 'FAIL  %-14s %s has stale or missing provenance\n' "native binary" "$binary"
        failed=1
    else
        echo "INFO  native binary  no verified packaged/cache binary; source build required"
        for command in cmake ninja; do
            if need_command "$command"; then
                printf 'PASS  %-14s %s\n' "$command" "$(command -v "$command")"
            else
                printf 'FAIL  %-14s missing\n' "$command"
                failed=1
            fi
        done

        if need_command qmake6 || need_command qtpaths6; then
            echo "PASS  Qt 6          development/runtime tools available"
        else
            echo "FAIL  Qt 6          development/runtime tools missing"
            failed=1
        fi

        if find /usr/lib/cmake /usr/lib64/cmake -maxdepth 2 -type f \
            \( -name 'KF6KIOConfig.cmake' -o -name 'KF6KIOConfigVersion.cmake' \) \
            -print -quit 2>/dev/null | grep -q .; then
            echo "PASS  KDE KIO        KF6 CMake package available"
        else
            echo "FAIL  KDE KIO        KF6 development package missing"
            failed=1
        fi
    fi

    if [ -f "$HOME/.cache/maho/theme/active.json" ]; then
        echo "PASS  Palette V2     active Maho palette available"
    else
        echo "INFO  Palette V2     active palette absent; neutral fallbacks will be used"
    fi

    echo
    if [ "$failed" -ne 0 ] && [ ! -x "$PACKAGED_BINARY" ]; then
        echo "Arch source-build dependency hint:"
        echo "  sudo pacman -S --needed cmake ninja qt6-base qt6-declarative kio"
    fi

    return "$failed"
}

configure() {
    [ -r "$SOURCE/CMakeLists.txt" ] || {
        echo "maho-files: source tree unavailable: $SOURCE" >&2
        return 1
    }
    mkdir -p "$BUILD"
    cmake \
        -S "$SOURCE" \
        -B "$BUILD" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo
}

build() {
    configure
    cmake --build "$BUILD" --parallel
}

run() {
    local binary
    binary="$(verified_binary)" || return 1
    exec "$binary" "$@"
}

clean() {
    case "$BUILD" in
        "$CACHE_HOME"/maho/files-qml-build|"$CACHE_HOME"/maho/files-qml-build/*)
            rm -rf -- "$BUILD"
            ;;
        *)
            echo "maho-files: refusing to clean non-default build path: $BUILD" >&2
            return 1
            ;;
    esac
}

case "${1:-run}" in
    doctor)
        doctor
        ;;
    configure)
        configure
        ;;
    build)
        build
        ;;
    run)
        shift || true
        run "$@"
        ;;
    clean)
        clean
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "maho-files: unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac

#!/usr/bin/env bash

set -u

ROOT="${MAHO_ROOT:-$HOME/Projects/Maho-OS}"
SYSFS="${MAHO_SYSFS_ROOT:-/sys}"
STATE_LIB="$ROOT/lib/state.sh"
EVENTS="$ROOT/lib/events.sh"
OBSERVER_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/maho/observer"

if ! { [ -r "$STATE_LIB" ] && source "$STATE_LIB" 2>/dev/null; }; then
    maho_state_publish() { return 1; }
fi
if ! { [ -r "$EVENTS" ] && source "$EVENTS" 2>/dev/null; }; then
    maho_event_emit() { return 0; }
fi

mkdir -p "$OBSERVER_STATE"
chmod 0700 "$OBSERVER_STATE" 2>/dev/null || true

power_current() {
    python - "$SYSFS/class/power_supply" <<'PY'
import json
import sys
from pathlib import Path
root=Path(sys.argv[1])
if not root.is_dir(): raise SystemExit(1)
supplies=[]
for path in sorted(root.iterdir()):
    if not path.is_dir(): continue
    def read(name):
        try: return (path/name).read_text().strip()
        except OSError: return None
    kind=read("type")
    if not kind: continue
    item={"name":path.name,"type":kind}
    if kind == "Battery":
        raw=read("capacity")
        try: capacity=max(0,min(100,int(raw)))
        except Exception: capacity=None
        if capacity is not None:
            item["capacity_percent"]=capacity
            item["capacity_bucket_percent"]=(capacity//5)*5
        status=read("status")
        if status: item["status"]=status
        present=read("present")
        if present in {"0","1"}: item["present"]=present == "1"
    else:
        online=read("online")
        if online in {"0","1"}: item["online"]=online == "1"
    supplies.append(item)
if not supplies: raise SystemExit(1)
print(json.dumps({"version":1,"supplies":supplies},sort_keys=True))
PY
}

thermal_current() {
    python - "$SYSFS/class/thermal" "$SYSFS/class/hwmon" <<'PY'
import json,re,sys
from pathlib import Path
thermal_root=Path(sys.argv[1]); hwmon_root=Path(sys.argv[2]); readings=[]
def read_text(path):
    try: return path.read_text().strip()
    except OSError: return None
def bucket(value):
    return (value//5000)*5000
def add(source,name,label,raw):
    try: value=int(raw)
    except Exception: return
    if value < -100000 or value > 250000: return
    readings.append({"source":source,"name":name,"label":label,"temp_millidegree_c":value,"temp_bucket_millidegree_c":bucket(value)})
if thermal_root.is_dir():
    for zone in sorted(thermal_root.glob("thermal_zone*")):
        raw=read_text(zone/"temp")
        if raw is not None: add("thermal-zone",zone.name,read_text(zone/"type") or zone.name,raw)
if hwmon_root.is_dir():
    for hwmon in sorted(hwmon_root.glob("hwmon*")):
        hwname=read_text(hwmon/"name") or hwmon.name
        for temp in sorted(hwmon.glob("temp*_input")):
            m=re.fullmatch(r"temp([0-9]+)_input",temp.name)
            if not m: continue
            i=m.group(1); add("hwmon",f"{hwname}:{i}",read_text(hwmon/f"temp{i}_label") or f"temp{i}",read_text(temp))
if not readings: raise SystemExit(1)
readings.sort(key=lambda r:(r["source"],r["name"],r["label"]))
max_actual=max(r["temp_millidegree_c"] for r in readings)
print(json.dumps({"version":1,"max_millidegree_c":max_actual,"max_bucket_millidegree_c":bucket(max_actual),"readings":readings},sort_keys=True))
PY
}

power_signature() {
    local data="$1"
    python - "$data" <<'PY'
import hashlib,json,sys
data=json.loads(sys.argv[1])
normalized=[{"name":x.get("name"),"type":x.get("type"),"online":x.get("online"),"present":x.get("present"),"status":x.get("status"),"capacity_bucket_percent":x.get("capacity_bucket_percent")} for x in data.get("supplies",[])]
raw=json.dumps(normalized,sort_keys=True,separators=(",",":")).encode()
print(hashlib.sha256(raw).hexdigest())
PY
}

thermal_transition_candidate() {
    local data="$1" reference_file="$2"
    python - "$data" "$reference_file" <<'PY'
import hashlib,json,sys
from pathlib import Path

data=json.loads(sys.argv[1]); path=Path(sys.argv[2])
current=int(data["max_millidegree_c"])
topology=[{"source":r.get("source"),"name":r.get("name"),"label":r.get("label")} for r in data.get("readings",[])]
topology_sha=hashlib.sha256(json.dumps(topology,sort_keys=True,separators=(",",":")).encode()).hexdigest()
levels=["normal","warm","hot","critical"]

def classify(temp):
    if temp >= 95000: return "critical"
    if temp >= 85000: return "hot"
    if temp >= 75000: return "warm"
    return "normal"

previous=None
if path.is_file():
    try: previous=json.loads(path.read_text())
    except Exception: previous=None

new_level=classify(current)
reason="initial"
previous_level=None

if previous and previous.get("topology_sha256") == topology_sha and previous.get("level") in levels:
    previous_level=previous["level"]
    old_i=levels.index(previous_level)
    new_i=levels.index(new_level)

    if new_i < old_i:
        release={"warm":70000,"hot":80000,"critical":90000}.get(previous_level)
        if release is not None and current > release:
            raise SystemExit(3)
    elif new_i == old_i:
        raise SystemExit(3)

    reason="level-transition"
elif previous:
    previous_level=previous.get("level")
    reason="topology-change"

print(json.dumps({
    "version":1,
    "level":new_level,
    "previous_level":previous_level,
    "max_millidegree_c":current,
    "topology_sha256":topology_sha,
    "reason":reason,
},sort_keys=True))
PY
}

write_atomic_private() {
    local path="$1" content="$2" tmp
    tmp="$path.$$"
    printf '%s\n' "$content" > "$tmp" || return 1
    chmod 0600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$path"
}

observe_domain_locked() {
    local domain="$1" data sig sig_file previous="" transition reference_file rc summary details
    case "$domain" in
        power)
            data="$(power_current)" || return 2
            sig="$(power_signature "$data")" || return 1
            sig_file="$OBSERVER_STATE/power.signature"
            [ ! -f "$sig_file" ] || previous="$(cat "$sig_file" 2>/dev/null || true)"
            [ "$sig" != "$previous" ] || return 0
            maho_state_publish "$domain" sysfs "$data" >/dev/null || return 1
            write_atomic_private "$sig_file" "$sig" || return 1
            summary="Normalized power state changed"
            details="$data"
            ;;
        thermal)
            data="$(thermal_current)" || return 2
            maho_state_publish "$domain" sysfs "$data" >/dev/null || return 1
            reference_file="$OBSERVER_STATE/thermal.reference.json"
            if transition="$(thermal_transition_candidate "$data" "$reference_file")"; then
                :
            else
                rc=$?
                [ "$rc" -eq 3 ] && return 0
                return 1
            fi
            write_atomic_private "$reference_file" "$transition" || return 1
            rm -f "$OBSERVER_STATE/thermal.signature" 2>/dev/null || true
            summary="$(python - "$transition" <<'PY'
import json,sys
r=json.loads(sys.argv[1]); t=r["max_millidegree_c"]/1000
prev=r.get("previous_level")
if r["reason"] == "topology-change":
    print(f"Thermal sensor topology changed; context is {r['level']} at {t:.1f} C")
elif prev:
    print(f"Thermal context changed {prev} -> {r['level']} at {t:.1f} C")
else:
    print(f"Thermal context initialized as {r['level']} at {t:.1f} C")
PY
)"
            details="$(python - "$transition" "$data" <<'PY'
import json,sys
print(json.dumps({"transition":json.loads(sys.argv[1]),"thermal":json.loads(sys.argv[2])},sort_keys=True))
PY
)"
            ;;
        *) echo "maho-observe: unknown domain: $domain" >&2; return 1 ;;
    esac

    maho_event_emit "$domain" "$domain.changed" observed info "$summary" "" sysfs "$details" >/dev/null 2>&1 || true
}

observe_domain() {
    local domain="$1"
    if command -v flock >/dev/null 2>&1; then
        (
            flock -x 9
            observe_domain_locked "$domain"
        ) 9>"$OBSERVER_STATE/$domain.lock"
    else
        observe_domain_locked "$domain"
    fi
}

once() {
    local domain="${1:-all}"
    case "$domain" in
        all)
            observe_domain power || [ "$?" -eq 2 ] || return 1
            observe_domain thermal || [ "$?" -eq 2 ] || return 1
            ;;
        power|thermal)
            observe_domain "$domain" || [ "$?" -eq 2 ] || return 1
            ;;
        *) echo "maho-observe: usage: maho-observe once [all|power|thermal]" >&2; return 1 ;;
    esac
}

watch() {
    local poll="${MAHO_OBSERVE_POLL:-15}"
    [[ "$poll" =~ ^[0-9]+([.][0-9]+)?$ ]] || poll=15
    while :; do once all || true; sleep "$poll"; done
}

current_command() {
    case "${1:-}" in
        power) power_current ;;
        thermal) thermal_current ;;
        *) echo "maho-observe: usage: maho-observe current power|thermal" >&2; return 1 ;;
    esac
}

doctor() {
    echo "Maho environment observers"
    power_current >/dev/null 2>&1 && echo "PASS  power sysfs observer" || echo "INFO  power sysfs capability unavailable"
    thermal_current >/dev/null 2>&1 && echo "PASS  thermal sysfs observer" || echo "INFO  thermal sysfs capability unavailable"
    declare -F maho_state_publish >/dev/null 2>&1 && echo "PASS  normalized state publisher" || echo "FAIL  normalized state publisher unavailable"
    command -v flock >/dev/null 2>&1 && echo "PASS  observer concurrency lock" || echo "INFO  flock unavailable; duplicate concurrent observations are not serialized"
    echo "INFO  thermal context bands: normal <75 C, warm >=75 C, hot >=85 C, critical >=95 C"
    echo "INFO  thermal downward hysteresis: 5 C below each transition"
    true
}

case "${1:-}" in
    current) current_command "${2:-}" ;;
    once) once "${2:-all}" ;;
    watch) watch ;;
    doctor) doctor ;;
    *)
        cat <<'HELP'
Maho read-only environment observers

Usage:
  maho-observe current power
  maho-observe current thermal
  maho-observe once [all|power|thermal]
  maho-observe watch
  maho-observe doctor

The observer only reads kernel-exposed state and publishes normalized Maho
state. Missing power or thermal providers disable that capability only.
Thermal events represent context transitions rather than ordinary CPU jitter:
normal <75 C, warm >=75 C, hot >=85 C, critical >=95 C, with 5 C downward
hysteresis. Sensor-topology changes are also observable events.
HELP
        ;;
esac

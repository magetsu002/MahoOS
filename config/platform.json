{
  "schema_version": 1,
  "kernel": {
    "primary_package": "linux-cachyos",
    "fallback_package": "linux-cachyos-lts",
    "fallback_visibility": "recovery-or-advanced-only",
    "custom_kernel_fork": false
  },
  "boot": {
    "manager": "limine",
    "normal_menu_visibility": "hidden-or-short-timeout",
    "default_kernel": "linux-cachyos",
    "recovery_kernel": "linux-cachyos-lts",
    "trusted_config_writer": "maho-signed-boot-publication",
    "snapshot_integration": "recovery-input-only",
    "legacy_snapshot_writer_guard": "/etc/maho/signed-boot-production",
    "kernel_update_snapshot_restore_certified": true,
    "boot_state_transaction_required": true
  },
  "system_states": {
    "filesystem": "btrfs",
    "root_snapper_config": "root",
    "package_transaction_snapshots": "snap-pac",
    "snapshot_retention_authority": "snapper-cleanup-policy",
    "recovery_eligibility_authority": "guardian",
    "boot_publication_authority": "maho-signed-boot-publication",
    "maximum_boot_candidates": 10,
    "retained_snapshot_count_independent_of_boot_candidates": true,
    "timeline_snapshots": false,
    "home_rollback_policy": "exclude-personal-data-by-default",
    "snapshots_are_backups": false
  },
  "memory_pressure": {
    "compressed_swap": "zram-generator",
    "maximum_zram_mib": 8192,
    "zram_fraction_of_ram": 0.5,
    "oom_authority": "systemd-oomd",
    "user_slice_pressure_limit_percent": 85,
    "shell_preference": "avoid"
  },
  "storage_health": {
    "root_scrub_schedule": "monthly",
    "scrub_result_authority": "systemd-service-result",
    "device_tools": ["nvme-cli", "smartmontools"],
    "smart_attributes_are_diagnostic_not_categorical": true
  },
  "recovery": {
    "prefer_smallest_effective_scope": true,
    "destructive_actions_require_confirmation": true,
    "repeated_service_failure_threshold": 3,
    "graphical_fallback": "text-console",
    "system_restore_provider": {
      "package": "limine-snapper-sync",
      "version": "1.31.0-1",
      "command": "/usr/bin/limine-snapper-restore"
    }
  },
  "distribution": {
    "package_format": "pacman",
    "packaged_payload_root": "/usr/lib/maho",
    "runtime_root": "$XDG_DATA_HOME/maho/runtime",
    "release_source": "signed-release-artifact"
  },
  "update": {
    "native_execution_certified": false,
    "candidate_root_strategy": "btrfs-subvolume-swap",
    "boot_artifact_transaction_required": true,
    "automatic_reboot": false,
    "pacman_config": "/etc/maho/pacman-kernel.conf",
    "required_repositories": [
      "core",
      "extra",
      "multilib",
      "cachyos"
    ]
  },
  "adaptive": {
    "a15_execution_certified": true,
    "certified_effects": [
      "notifications"
    ],
    "service_enabled": true
  }
}

{
  "schema_version": 1,
  "kernel": {
    "primary_package": "linux-cachyos",
    "fallback_package": "linux-cachyos-lts",
    "fallback_visibility": "recovery-or-advanced-only",
    "custom_kernel_fork": false
  },
  "boot": {
    "manager": "limine",
    "normal_menu_visibility": "hidden-or-short-timeout",
    "default_kernel": "linux-cachyos",
    "recovery_kernel": "linux-cachyos-lts",
    "snapshot_integration": "limine-snapper-sync",
    "kernel_update_snapshot_restore_certified": true,
    "boot_state_transaction_required": true
  },
  "system_states": {
    "filesystem": "btrfs",
    "root_snapper_config": "root",
    "package_transaction_snapshots": "snap-pac",
    "maximum_recovery_entries": 10,
    "timeline_snapshots": false,
    "home_rollback_policy": "exclude-personal-data-by-default",
    "snapshots_are_backups": false
  },
  "recovery": {
    "prefer_smallest_effective_scope": true,
    "destructive_actions_require_confirmation": true,
    "repeated_service_failure_threshold": 3,
    "graphical_fallback": "text-console",
    "system_restore_provider": {
      "package": "limine-snapper-sync",
      "version": "1.31.0-1",
      "command": "/usr/bin/limine-snapper-restore"
    }
  },
  "distribution": {
    "package_format": "pacman",
    "packaged_payload_root": "/usr/lib/maho",
    "runtime_root": "$XDG_DATA_HOME/maho/runtime",
    "release_source": "signed-release-artifact"
  }
}

[Unit]
Description=Maho host firewall status receipt observer
After=network-pre.target
ConditionPathExists=/usr/lib/maho/config/platform/maho-host-firewall.nft

[Service]
Type=oneshot
ExecStart=/usr/bin/python /usr/lib/maho/lib/maho_firewall_receipt.py publish
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RuntimeDirectory=maho/firewall
RuntimeDirectoryMode=0755
ReadWritePaths=/run/maho/firewall

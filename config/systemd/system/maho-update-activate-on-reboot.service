[Unit]
Description=Maho arm pending update before explicit reboot
DefaultDependencies=no
After=local-fs.target
Conflicts=reboot.target
Before=reboot.target
RefuseManualStop=yes
ConditionPathExists=/usr/lib/maho/update-campaign/current/bin/maho-update-coordinator

[Service]
Type=oneshot
ExecStart=/usr/bin/true
ExecStop=/usr/lib/maho/update-campaign/current/bin/maho-update-coordinator activate-current
RemainAfterExit=yes
TimeoutStopSec=45s
UMask=0077

[Install]
WantedBy=multi-user.target reboot.target

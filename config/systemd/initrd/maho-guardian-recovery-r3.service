[Unit]
Description=Maho Guardian Recovery R3 bounded kernel recovery
DefaultDependencies=no
After=initrd-root-fs.target
Before=initrd-cleanup.service initrd-switch-root.target
ConditionKernelCommandLine=maho.guardian_recovery=r3
OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
ExecStart=/usr/lib/maho/guardian-recovery-r3
RemainAfterExit=yes

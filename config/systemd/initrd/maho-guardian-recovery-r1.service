[Unit]
Description=Maho Guardian Recovery R1 independent-kernel certification
DefaultDependencies=no
After=initrd-root-fs.target
Before=initrd-switch-root.target
ConditionKernelCommandLine=maho.guardian_recovery=r1
OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
ExecStart=/usr/lib/maho/guardian-recovery-r1
RemainAfterExit=yes

configuration {
    show-icons: true;
    matching: "fuzzy";
    sort: true;
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: @maho-foreground;
    font: "Inter 10";
}

window {
    width: 760px;
    location: center;
    anchor: center;
    padding: 18px 20px 16px;
    border: 1px;
    border-radius: 24px;
    border-color: @maho-rim;
    background-color: transparent;
    background-image: @maho-panel-material;
}

mainbox {
    spacing: 12px;
    background-color: transparent;
    children: [ header, inputbar, mode-switcher, result-shell, show-more ];
}

header {
    expand: false;
    orientation: horizontal;
    padding: 0px 2px;
    children: [ icon-app-grid, textbox-title, icon-settings ];
    background-color: transparent;
}

icon-app-grid, icon-settings {
    expand: false;
    size: 16px;
    padding: 7px;
    border: 1px;
    border-radius: 10px;
    border-color: @maho-control-rim;
    vertical-align: 0.5;
    tint: @maho-icon-muted;
    background-color: transparent;
    background-image: @maho-control-material;
}

icon-app-grid {
    filename: @maho-icon-app-grid;
    action: "kb-custom-1";
}

icon-settings {
    filename: @maho-icon-settings;
    action: "kb-custom-2";
}

textbox-title {
    content: "Maho Launcher";
    expand: true;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "Inter SemiBold 12";
    text-color: @maho-foreground;
    background-color: transparent;
}

inputbar {
    expand: false;
    children: [ icon-search, entry ];
    spacing: 11px;
    padding: 11px 14px;
    border: 1px;
    border-radius: 15px;
    border-color: @maho-border-soft;
    background-color: transparent;
    background-image: @maho-inset-material;
}

icon-search {
    filename: @maho-icon-search;
    expand: false;
    size: 17px;
    vertical-align: 0.5;
    tint: @maho-icon-muted;
    background-color: transparent;
}

entry {
    placeholder: "Search apps, files, and commands...";
    placeholder-color: @maho-muted-soft;
    text-color: @maho-foreground;
    background-color: transparent;
}

mode-switcher {
    expand: false;
    orientation: horizontal;
    spacing: 0px;
    padding: 2px;
    border: 1px;
    border-radius: 14px;
    border-color: @maho-border-soft;
    background-color: transparent;
    background-image: @maho-segment-material;
}

button {
    padding: 8px 16px;
    border: 1px;
    border-radius: 12px;
    border-color: transparent;
    text-color: @maho-muted-soft;
    background-color: transparent;
    font: "Inter Medium 10";
}

button selected {
    border-color: @maho-accent-rim;
    text-color: @maho-foreground;
    background-color: transparent;
    background-image: @maho-active-mode-material;
}

result-shell {
    children: [ listview ];
    padding: 0px;
    border: 1px;
    border-radius: 15px;
    border-color: @maho-result-rim;
    background-color: transparent;
    background-image: @maho-result-material;
}

listview {
    lines: 9;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: false;
    spacing: 0px;
    background-color: transparent;
}

element {
    children: [ element-icon, element-text, icon-chevron ];
    orientation: horizontal;
    spacing: 11px;
    padding: 7px 12px;
    border: 1px;
    border-radius: 13px;
    border-color: transparent;
    text-color: @maho-foreground;
    background-color: transparent;
}

element normal.normal, element alternate.normal {
    border: 0px 0px 1px 0px;
    border-radius: 0px;
    border-color: @maho-divider;
    background-color: transparent;
}

element selected.normal, element selected.active, element selected.urgent {
    border: 1px;
    border-radius: 13px;
    border-color: @maho-selection-rim;
    text-color: @maho-foreground;
    background-color: transparent;
    background-image: @maho-selection-material;
}

element-icon {
    size: 28px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    expand: true;
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
    highlight: none;
}

icon-chevron {
    filename: @maho-icon-chevron-right;
    action: "kb-accept-entry";
    expand: false;
    size: 8px;
    vertical-align: 0.5;
    tint: @maho-icon-muted;
    background-color: transparent;
}

show-more {
    expand: false;
    orientation: horizontal;
    children: [ button-show-more, icon-expand ];
    spacing: 5px;
    padding: 2px 0px 0px;
    background-color: transparent;
}

button-show-more {
    content: "Show more apps";
    action: "kb-page-next";
    expand: true;
    horizontal-align: 1.0;
    vertical-align: 0.5;
    text-color: @maho-muted-soft;
    background-color: transparent;
    font: "Inter 9";
}

icon-expand {
    filename: @maho-icon-chevron-down;
    expand: true;
    size: 8px;
    horizontal-align: 0.0;
    vertical-align: 0.5;
    tint: @maho-icon-muted;
    background-color: transparent;
}

message {
    padding: 9px;
    border-radius: 12px;
    text-color: @maho-muted;
    background-color: @maho-inset;
}

textbox {
    text-color: @maho-muted;
    background-color: transparent;
}

/* Fallback palette. Runtime colors are generated from active.json in cache. */
* {
    maho-glass: rgba(24, 26, 30, 64%);
    maho-panel-top: rgba(37, 40, 44, 60%);
    maho-panel-bottom: rgba(24, 26, 30, 68%);
    maho-inset: rgba(37, 39, 43, 22%);
    maho-inset-top: rgba(53, 55, 59, 28%);
    maho-segment: rgba(26, 28, 32, 16%);
    maho-segment-top: rgba(38, 40, 44, 22%);
    maho-result-surface: rgba(25, 27, 31, 10%);
    maho-selection: rgba(64, 72, 83, 28%);
    maho-selection-top: rgba(85, 92, 103, 36%);
    maho-rim: rgba(174, 178, 182, 16%);
    maho-border-soft: rgba(161, 165, 168, 6%);
    maho-divider: rgba(62, 65, 69, 3%);
    maho-accent-rim: rgba(172, 199, 239, 18%);
    maho-accent-soft: rgba(55, 64, 78, 24%);
    maho-accent-soft-top: rgba(70, 79, 92, 32%);
    maho-panel-material: linear-gradient(to bottom, rgba(37, 40, 44, 60%), rgba(24, 26, 30, 64%), rgba(24, 26, 30, 68%));
    maho-inset-material: linear-gradient(to bottom, rgba(53, 55, 59, 28%), rgba(37, 39, 43, 22%));
    maho-segment-material: linear-gradient(to bottom, rgba(38, 40, 44, 22%), rgba(26, 28, 32, 16%));
    maho-result-material: linear-gradient(to bottom, rgba(31, 33, 37, 13%), rgba(25, 27, 31, 10%));
    maho-active-mode-material: linear-gradient(to bottom, rgba(70, 79, 92, 32%), rgba(55, 64, 78, 24%));
    maho-selection-material: linear-gradient(to bottom, rgba(85, 92, 103, 36%), rgba(64, 72, 83, 28%));
    maho-foreground: #ecf1f7;
    maho-muted: #bbc0c7;
    maho-icon-app-grid: "view-app-grid-symbolic";
    maho-icon-settings: "preferences-system-symbolic";
    maho-icon-search: "system-search-symbolic";
    maho-icon-chevron-right: "go-next-symbolic";
    maho-icon-chevron-down: "go-down-symbolic";
    maho-icon-chevron-up: "go-up-symbolic";
}

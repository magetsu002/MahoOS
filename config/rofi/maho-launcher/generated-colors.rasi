/* Fallback palette. Runtime colors are generated from active.json in cache. */
* {
    maho-glass: rgba(26, 28, 35, 80%);
    maho-panel-top: rgba(34, 36, 43, 76%);
    maho-panel-bottom: rgba(26, 28, 34, 82%);
    maho-inset: rgba(34, 36, 42, 48%);
    maho-inset-top: rgba(45, 47, 53, 54%);
    maho-segment: rgba(29, 30, 37, 38%);
    maho-segment-top: rgba(38, 39, 46, 44%);
    maho-result-surface: rgba(28, 29, 36, 26%);
    maho-selection: rgba(51, 58, 69, 54%);
    maho-selection-top: rgba(65, 72, 82, 60%);
    maho-rim: rgba(168, 172, 178, 18%);
    maho-border-soft: rgba(155, 159, 164, 8%);
    maho-divider: rgba(72, 75, 82, 5%);
    maho-accent-rim: rgba(137, 178, 238, 42%);
    maho-accent-soft: rgba(46, 54, 67, 48%);
    maho-accent-soft-top: rgba(55, 62, 75, 54%);
    maho-panel-material: linear-gradient(to bottom, rgba(34, 36, 43, 76%), rgba(26, 28, 35, 80%), rgba(26, 28, 34, 82%));
    maho-inset-material: linear-gradient(to bottom, rgba(45, 47, 53, 54%), rgba(34, 36, 42, 48%));
    maho-segment-material: linear-gradient(to bottom, rgba(38, 39, 46, 44%), rgba(29, 30, 37, 38%));
    maho-active-mode-material: linear-gradient(to bottom, rgba(55, 62, 75, 54%), rgba(46, 54, 67, 48%));
    maho-selection-material: linear-gradient(to bottom, rgba(65, 72, 82, 60%), rgba(51, 58, 69, 54%));
    maho-foreground: #ecf1f7;
    maho-muted: #b9bfc7;
    maho-icon-app-grid: "view-app-grid-symbolic";
    maho-icon-settings: "applications-system-symbolic";
    maho-icon-search: "system-search-symbolic";
    maho-icon-chevron-right: "go-next-symbolic";
    maho-icon-chevron-down: "go-down-symbolic";
    maho-icon-chevron-up: "go-up-symbolic";
}

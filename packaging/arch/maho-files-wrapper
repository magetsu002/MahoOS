#!/usr/bin/env bash
set -euo pipefail

runtime="${XDG_DATA_HOME:-$HOME/.local/share}/maho/runtime/current"
launcher="$runtime/bin/maho-files"

if [ ! -x "$launcher" ]; then
  echo "maho-files: install the per-user MahoOS runtime with maho-install first" >&2
  exit 1
fi

export MAHO_ROOT="$runtime"
exec bash "$launcher" "$@"

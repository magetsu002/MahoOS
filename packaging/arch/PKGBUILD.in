pkgname=maho-os
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Adaptive MahoOS desktop runtime and native system surfaces'
arch=('x86_64')
url='https://github.com/magetsu002/MahoOS'
# Public V1 release is blocked on an explicit project license decision.
depends=(
  'bash'
  'python'
  'python-cryptography'
  'systemd'
  'libbpf'
  'polkit'
  'gnome-keyring'
  'rtkit'
  'zram-generator'
  'btrfs-progs'
  'nvme-cli'
  'smartmontools'
  'xdg-desktop-portal'
  'xdg-desktop-portal-gtk'
  'xdg-desktop-portal-hyprland'
  'hyprland'
  'quickshell'
  'awww'
  'brightnessctl'
  'wireplumber'
  'networkmanager'
  'wireless-regdb'
  'iw'
  'imagemagick'
  'bluez-utils'
  'wl-clipboard'
  'cliphist'
  'qt6-base'
  'qt6-5compat'
  'qt6-declarative'
  'kio'
  'libbpf'
)
makedepends=(
  'clang'
  'cmake'
  'ninja'
  'qt6-base'
  'qt6-declarative'
  'kio'
)
optdepends=(
  'matugen: wallpaper-derived Palette V2 generation backend'
  'linux-cachyos: MahoOS V1 preferred kernel'
  'linux-cachyos-lts: MahoOS V1 recovery kernel'
  'snapper: Btrfs system-state management'
  'snap-pac: automatic pre/post package transaction snapshots'
  'limine: MahoOS V1 boot manager policy'
  'sbctl: low-level per-device Secure Boot provider'
  'sbsigntools: PE/COFF signing and independent verification for signed boot certification'
  'limine-snapper-sync: recovery-only Btrfs snapshot boot entries'
)
source=(
  "maho-os-${pkgver}.tar.zst"
  'release.json'
)
sha256sums=(
  '@SOURCE_SHA256@'
  '@RELEASE_SHA256@'
)

build() {
  local source_root="$srcdir/maho-os-${pkgver}"
  cmake \
    -S "$source_root/apps/maho-files" \
    -B "$srcdir/build-maho-files" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build "$srcdir/build-maho-files" --parallel 2
  mkdir -p "$srcdir/build-prevention"
  clang -O2 -g -target bpf -D__TARGET_ARCH_x86 \
    -I"/usr/include/$(gcc -dumpmachine)" -I"$source_root/bpf" \
    -c "$source_root/bpf/maho_prevention.bpf.c" \
    -o "$srcdir/build-prevention/maho_prevention.bpf.o"
  gcc -O2 -Wall -Wextra -Werror "$source_root/src/maho_prevention_loader.c" \
    -o "$srcdir/build-prevention/maho-prevention-loader" $(pkg-config --cflags --libs libbpf)
  gcc -O2 -Wall -Wextra -Werror "$source_root/src/maho_prevention_evidence.c" \
    -o "$srcdir/build-prevention/maho-prevention-evidence" $(pkg-config --cflags --libs libbpf)
}

package() {
  local source_root="$srcdir/maho-os-${pkgver}"

  install -d "$pkgdir/usr/lib/maho"
  for dir in adapters apps bin config lib systemd theme; do
    cp -a "$source_root/$dir" "$pkgdir/usr/lib/maho/$dir"
  done

  install -Dm755 "$srcdir/build-maho-files/maho-files" \
    "$pkgdir/usr/lib/maho/apps/maho-files/prebuilt/maho-files"
  install -Dm644 "$srcdir/release.json" \
    "$pkgdir/usr/lib/maho/share/maho/release.json"
  install -Dm755 "$source_root/packaging/arch/maho-install" \
    "$pkgdir/usr/bin/maho-install"
  install -Dm755 "$source_root/packaging/arch/maho-files-wrapper" \
    "$pkgdir/usr/bin/maho-files"
  install -d "$pkgdir/usr/share/applications"
  sed 's#^Exec=.*#Exec=/usr/bin/maho-files run %U#' \
    "$source_root/apps/maho-files/io.maho.Files.desktop" \
    > "$pkgdir/usr/share/applications/io.maho.Files.desktop"
  chmod 0644 "$pkgdir/usr/share/applications/io.maho.Files.desktop"
  install -Dm755 "$source_root/packaging/arch/maho-platform-wrapper" \
    "$pkgdir/usr/bin/maho-platform"
  install -Dm755 "$source_root/packaging/arch/maho-recovery-wrapper" \
    "$pkgdir/usr/bin/maho-recovery"
  install -Dm755 "$source_root/bin/maho-admit" \
    "$pkgdir/usr/bin/maho-admit"
  install -Dm755 "$source_root/bin/maho-trust" \
    "$pkgdir/usr/bin/maho-trust"
  install -Dm755 "$source_root/bin/maho-intent-guard" \
    "$pkgdir/usr/bin/maho-intent-guard"
  install -d "$pkgdir/usr/lib/maho/prevention"
  install -Dm755 "$source_root/bin/maho-prevention-boundary" \
    "$pkgdir/usr/lib/maho/prevention/maho-prevention-boundary"
  install -Dm755 "$source_root/bin/maho-break-glass" \
    "$pkgdir/usr/lib/maho/prevention/maho-break-glass"
  install -Dm755 "$srcdir/build-prevention/maho-prevention-loader" \
    "$pkgdir/usr/lib/maho/prevention/maho-prevention-loader"
  install -Dm755 "$srcdir/build-prevention/maho-prevention-evidence" \
    "$pkgdir/usr/lib/maho/prevention/maho-prevention-evidence"
  install -Dm644 "$srcdir/build-prevention/maho_prevention.bpf.o" \
    "$pkgdir/usr/lib/maho/prevention/maho_prevention.bpf.o"
  install -Dm644 "$source_root/config/systemd/system/maho-prevention-boundary.service" \
    "$pkgdir/usr/lib/systemd/system/maho-prevention-boundary.service"
  install -Dm644 "$source_root/config/systemd/system/maho-prevention-evidence.service" \
    "$pkgdir/usr/lib/systemd/system/maho-prevention-evidence.service"
  install -Dm644 "$source_root/config/polkit-1/actions/io.maho.prevention.policy" \
    "$pkgdir/usr/share/polkit-1/actions/io.maho.prevention.policy"
  install -Dm644 "$source_root/config/tmpfiles.d/maho-prevention.conf" \
    "$pkgdir/usr/lib/tmpfiles.d/maho-prevention.conf"
  install -Dm644 "$source_root/docs/PREVENTION-BOUNDARY.md" \
    "$pkgdir/usr/share/doc/maho/PREVENTION-BOUNDARY.md"
  install -Dm644 "$source_root/README.md" \
    "$pkgdir/usr/share/doc/maho-os/README.md"
}

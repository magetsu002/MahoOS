     using namespace std;
 
 
+    // One real directory inode excludes daemon and direct-library owners,
+    // including differently named configurations for the same collection.
+    class SnapshotOwnerExclusion
+    {
+    public:
+        explicit SnapshotOwnerExclusion(const SDir& infos)
+        {
+            struct stat st;
+            if (infos.stat(&st) != 0 || !S_ISDIR(st.st_mode) || st.st_uid != 0 || (st.st_mode & 0022))
+                SN_THROW(Exception("untrusted snapshot owner directory"));
+            owner_fd = fcntl(infos.fd(), F_DUPFD_CLOEXEC, 3);
+            if (owner_fd < 0)
+                SN_THROW(Exception("snapshot owner descriptor unavailable"));
+            if (flock(owner_fd, LOCK_EX | LOCK_NB) != 0)
+            {
+                close(owner_fd);
+                owner_fd = -1;
+                SN_THROW(Exception("snapshot collection already owned"));
+            }
+        }
+        ~SnapshotOwnerExclusion() { if (owner_fd >= 0) close(owner_fd); }
+        SnapshotOwnerExclusion(const SnapshotOwnerExclusion&) = delete;
+        SnapshotOwnerExclusion& operator=(const SnapshotOwnerExclusion&) = delete;
+    private:
+        int owner_fd = -1;
+    };
+
+
+    // Preserve Snapper's public object layout: ownership is private library
+    // state, never an added member that breaks existing C++ client ABI.
+    struct SnapshotOwners
+    {
+        mutex guard;
+        map<const Snapper*, unique_ptr<SnapshotOwnerExclusion>> owners;
+    };
+
+    static SnapshotOwners& snapshot_owners()
+    {
+        // Process lifetime avoids cross-DSO static destructor ordering. Normal
+        // Snapper destruction erases every entry; process death closes fds.
+        static SnapshotOwners* value = new SnapshotOwners;
+        return *value;
+    }
+
+
     Snapper::Snapper(const string& config_name, const string& root_prefix, bool disable_filters)
 	: config_name(config_name), root_prefix(root_prefix), snapshots(this)

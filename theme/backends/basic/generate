#!/usr/bin/env bash

set -euo pipefail

wall="$1"
mode="$2"
out="$3"

command -v magick >/dev/null 2>&1 || {
    echo "basic Palette V2 backend requires ImageMagick" >&2
    exit 1
}

root="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." &&
    pwd
)"

# Palette V2 performs the one bounded image sample during canonicalization.
# This backend only satisfies the existing raw-backend transaction contract;
# its fallback values are validated but never promoted over analyzed colors.
cp "$root/backends/basic/palette.raw.json" "$out"
